type vendor_cacertservice_app, domain;

app_domain(vendor_cacertservice_app)

typeattribute vendor_cacertservice_app halclientdomain;

typeattribute vendor_cacertservice_app vendor_hal_cacert_qti;

typeattribute vendor_cacertservice_app vendor_hal_cacert_qti_server;

typeattribute vendor_cacertservice_app vendor_hal_perf_client;

typeattribute vendor_cacertservice_app vendor_halserverdomain;

binder_use(vendor_cacertservice_app)

hwbinder_use(vendor_cacertservice_app)

allow vendor_cacertservice_app appdomain_tmpfs:file { read write getattr map execute };

allow vendor_cacertservice_app hwservicemanager:binder { call transfer };

allow vendor_cacertservice_app system_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_cacertservice_app hwservicemanager_prop:file { read getattr map open };

allow vendor_cacertservice_app vendor_location_xtra_daemon:binder { call transfer };

allow vendor_cacertservice_app vendor_location_xtra_daemon:fd { use };

allow vendor_cacertservice_app servicemanager:binder { call transfer };

allow vendor_cacertservice_app app_api_service:service_manager { find };

allow vendor_cacertservice_app self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_cacertservice_app vendor_location_xtra_daemon:binder { transfer };

type_transition vendor_cacertservice_app tmpfs:file appdomain_tmpfs;
