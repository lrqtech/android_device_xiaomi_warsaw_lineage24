typeattribute vendor_qtelephony coredomain;

app_domain(vendor_qtelephony)

net_domain(vendor_qtelephony)

hal_client_domain(vendor_qtelephony, hal_telephony)

hal_client_domain(vendor_qtelephony, vendor_hal_imsrtphal)

typeattribute vendor_qtelephony hal_telephony_client;

typeattribute vendor_qtelephony vendor_hal_atfwd_client;

typeattribute vendor_qtelephony vendor_hal_imsvthal_client;

typeattribute vendor_qtelephony vendor_hal_perf_client;

typeattribute vendor_qtelephony vendor_hal_datafactory_qti_client;

typeattribute vendor_qtelephony vendor_hal_imsrtphal_client;

type_transition vendor_qtelephony tmpfs:file appdomain_tmpfs;

binder_use(vendor_qtelephony)

hwbinder_use(vendor_qtelephony)

allow vendor_qtelephony appdomain_tmpfs:file { read write getattr map execute };

allow vendor_qtelephony appdomain:memfd_file { read write getattr map execute };

allow vendor_qtelephony hwservicemanager:binder { call transfer };

allow vendor_qtelephony hwservicemanager_prop:file { read getattr map open };

allow vendor_qtelephony servicemanager:binder { call transfer };

allow vendor_qtelephony audioserver_service:service_manager { find };

allow vendor_qtelephony cameraserver_service:service_manager { find };

allow vendor_qtelephony drmserver_service:service_manager { find };

allow vendor_qtelephony mediaserver_service:service_manager { find };

allow vendor_qtelephony mediametrics_service:service_manager { find };

allow vendor_qtelephony mediaextractor_service:service_manager { find };

allow vendor_qtelephony radio_service:service_manager { find };

allow vendor_qtelephony system_api_service:service_manager { find };

allow vendor_qtelephony app_api_service:service_manager { find };

allow vendor_qtelephony vendor_dpmtcm_socket:sock_file { write };

allow vendor_qtelephony vendor_dpmd:unix_stream_socket { connectto };

allow vendor_qtelephony hal_telephony:memfd_file { read write getattr map };

allow vendor_qtelephony vendor_hal_imsvthal:memfd_file { read write getattr map };

allow vendor_qtelephony vendor_sys_ims_prop:file { read getattr map open };

allow vendor_qtelephony vendor_persist_camera_prop:file { read getattr map open };
