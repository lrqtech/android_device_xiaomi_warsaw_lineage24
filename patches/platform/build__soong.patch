--- /dev/null
+++ b/filesystem/vbmeta_test.go
@@ -0,0 +1,87 @@
+// Copyright (C) 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+
+package filesystem
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"android/soong/android"
+)
+
+var vbmetaFixture = android.GroupFixturePreparers(
+	fixture,
+	android.FixtureRegisterWithContext(func(ctx android.RegistrationContext) {
+		ctx.RegisterModuleType("vbmeta", VbmetaFactory)
+	}),
+)
+
+func TestVbmetaImageSizeAndDescriptorInputs(t *testing.T) {
+	for _, size := range []int{0, 4096, 12288, 65536} {
+		t.Run(fmt.Sprint(size), func(t *testing.T) {
+			sizeProperty := ""
+			expected := size
+			if size == 0 {
+				expected = 65536
+			} else {
+				sizeProperty = fmt.Sprintf("image_size: %d,", size)
+			}
+			result := android.GroupFixturePreparers(vbmetaFixture, android.FixtureMergeMockFs(android.MockFS{
+				"key.pem":   nil,
+				"pvmfw.img": nil,
+			})).RunTestWithBp(t, `
+                vbmeta {
+                    name: "test_vbmeta",
+                    private_key: "key.pem",
+                    rollback_index: 0,
+                    descriptor_images: ["pvmfw.img"],
+                    `+sizeProperty+`
+                }
+            `)
+			rule := result.ModuleForTests(t, "test_vbmeta", "android_common").Output("test_vbmeta.img")
+			command := rule.RuleParams.Command
+			meta := android.ContentFromFileRuleForTests(t, result.TestContext,
+				result.ModuleForTests(t, "test_vbmeta", "android_common").Output("prop_file_for_misc_info"))
+			android.AssertStringDoesContain(t, "extra image survives target-files metadata", meta,
+				"avb_test_vbmeta_extra_images=pvmfw.img")
+			if size != 0 {
+				android.AssertStringDoesContain(t, "size survives target-files metadata", meta,
+					fmt.Sprintf("avb_test_vbmeta_image_size=%d", size))
+			} else {
+				android.AssertStringDoesNotContain(t, "unset size preserves legacy release-tool behavior", meta,
+					"avb_test_vbmeta_image_size=")
+			}
+			verify := strings.Index(command, "verify_image --image pvmfw.img")
+			create := strings.Index(command, "make_vbmeta_image")
+			guard := strings.Index(command, fmt.Sprintf(") -le %d ||", expected))
+			pad := strings.Index(command, fmt.Sprintf("truncate -s %d ", expected))
+			if verify < 0 || create <= verify || guard <= create || pad <= guard {
+				t.Fatalf("verification and overflow guard must precede padding: %s", command)
+			}
+			android.AssertStringDoesContain(t, "include the verified descriptors", command,
+				"--include_descriptors_from_image pvmfw.img")
+			inputs := append(rule.Inputs.Strings(), rule.Implicits.Strings()...)
+			android.AssertStringListContains(t, "rebuild if descriptor image changes", inputs, "pvmfw.img")
+		})
+	}
+}
+
+func TestVbmetaRejectsInvalidImageSize(t *testing.T) {
+	for _, size := range []int{-4096, 0, 4095, 65537, 69632} {
+		t.Run(fmt.Sprint(size), func(t *testing.T) {
+			android.GroupFixturePreparers(vbmetaFixture, android.FixtureMergeMockFs(android.MockFS{"key.pem": nil})).
+				ExtendWithErrorHandler(android.FixtureExpectsAtLeastOneErrorMatchingPattern(
+					`image_size: must be a positive multiple of 4096 no greater than 65536`)).
+				RunTestWithBp(t, fmt.Sprintf(`
+                    vbmeta {
+                        name: "test_vbmeta",
+                        private_key: "key.pem",
+                        rollback_index: 0,
+                        image_size: %d,
+                    }
+                `, size))
+		})
+	}
+}
