type vendor_dpmd_vndr, domain;

domain_auto_trans(init, vendor_dpmd_vndr_exec, vendor_dpmd_vndr)

typeattribute vendor_dpmd_vndr halclientdomain;

typeattribute vendor_dpmd_vndr netdomain;

typeattribute vendor_dpmd_vndr vendor_hal_dpmapiservice_qti;

typeattribute vendor_dpmd_vndr vendor_hal_dpmapiservice_qti_server;

typeattribute vendor_dpmd_vndr vendor_hal_dpmqmiservice_qti_client;

typeattribute vendor_dpmd_vndr vendor_hal_mwqemadapter_qti_client;

typeattribute vendor_dpmd_vndr vendor_halserverdomain;

binder_use(vendor_dpmd_vndr)

hwbinder_use(vendor_dpmd_vndr)

vndbinder_use(vendor_dpmd_vndr)

allow vendor_dpmd_vndr vendor_dpmd_vndr_exec:file { read getattr map execute open entrypoint };

