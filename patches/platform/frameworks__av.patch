+// These values come from the shipped warsaw HAL, not from the frozen AIDL API.
+TEST(XiaomiAudioExtensions, ObservedOutputMasksRoundTrip) {
+    const int32_t masks[] = {0, 6, 8, 32817, 1, 8193, 16384, 260, 4097, 65536, 524288};
+    for (int32_t mask : masks) {
+        SCOPED_TRACE(mask);
+        const auto legacy = aidl2legacy_int32_t_audio_output_flags_t_mask(mask);
+        ASSERT_TRUE(legacy.ok());
+        const auto restored = legacy2aidl_audio_output_flags_t_int32_t_mask(legacy.value());
+        ASSERT_TRUE(restored.ok());
+        EXPECT_EQ(mask, restored.value());
+    }
+    const auto virtualDeep = aidl2legacy_int32_t_audio_output_flags_t_mask(1 << 19);
+    ASSERT_TRUE(virtualDeep.ok());
+    EXPECT_EQ(0x40000000u, static_cast<uint32_t>(virtualDeep.value()));
+    EXPECT_NE(AUDIO_OUTPUT_FLAG_ULTRASOUND, virtualDeep.value());
+    const auto mixed = aidl2legacy_int32_t_audio_output_flags_t_mask((1 << 19) | (1 << 3));
+    ASSERT_TRUE(mixed.ok());
+    EXPECT_EQ(0x40000008u, static_cast<uint32_t>(mixed.value()));
+}
