type vendor_location_edgnss_daemon, domain;

domain_auto_trans(vendor_location, vendor_location_edgnss_daemon_exec, vendor_location_edgnss_daemon)

typeattribute vendor_location_edgnss_daemon netdomain;

allow vendor_location_edgnss_daemon vendor_location_edgnss_daemon_exec:file { read getattr map execute open entrypoint };

allow vendor_location_edgnss_daemon vendor_location:process { sigchld };

allow vendor_location_edgnss_daemon vendor_location:fd { use };

allow vendor_location_edgnss_daemon vendor_location_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_location_edgnss_daemon vendor_location_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_location_edgnss_daemon vendor_location_socket:lnk_file { read getattr open };

allow vendor_location_edgnss_daemon vendor_location_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_location_edgnss_daemon vendor_location_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };

allow vendor_location_edgnss_daemon vendor_location:unix_dgram_socket { read write sendto };

allow vendor_location_edgnss_daemon vendor_hal_gnss_qti:unix_dgram_socket { sendto };

allow vendor_location_edgnss_daemon hwservicemanager_prop:file { read getattr map open };

allow vendor_location_edgnss_daemon system_server:binder { call transfer };

allow vendor_location_edgnss_daemon system_server:fd { use };

allow vendor_location_edgnss_daemon self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_location_edgnss_daemon anr_data_file:file { append };

allow vendor_location_edgnss_daemon dumpstate:fd { use };

allow vendor_location_edgnss_daemon incidentd:fd { use };

allow vendor_location_edgnss_daemon dumpstate:fifo_file { write append };

allow vendor_location_edgnss_daemon incidentd:fifo_file { write append };

allow vendor_location_edgnss_daemon system_server:fifo_file { write append };

allow vendor_location_edgnss_daemon tombstoned:unix_stream_socket { connectto };

allow vendor_location_edgnss_daemon tombstoned:fd { use };

allow vendor_location_edgnss_daemon tombstoned_crash_socket:sock_file { write };

allow vendor_location_edgnss_daemon tombstone_data_file:file { append };

allow vendor_location_edgnss_daemon system_server:binder { transfer };
