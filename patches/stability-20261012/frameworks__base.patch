@@ -0,0 +1,44 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.systemui.statusbar.connectivity;
+
+import android.content.Context;
+import android.telephony.ServiceState;
+
+import com.android.settingslib.SignalIcon.MobileIconGroup;
+import com.android.settingslib.mobile.TelephonyIcons;
+import com.android.systemui.res.R;
+
+/** Presentation-only China SKU policy. Never changes connectivity or radio registration. */
+public final class MainlandMobileIconPolicy {
+    private MainlandMobileIconPolicy() {}
+
+    public static boolean isMainland(ServiceState state) {
+        if (state == null || state.isUsingNonTerrestrialNetwork()) return false;
+        String numeric = state.getOperatorNumeric();
+        return numeric != null && (numeric.length() == 5 || numeric.length() == 6)
+                && numeric.startsWith("460");
+    }
+
+    public static boolean hideExclamation(Context context, boolean mainland, boolean inService) {
+        return mainland && inService && context.getResources().getBoolean(
+                R.bool.config_hideNetworkExclamationMarksInMainlandChina);
+    }
+
+    public static MobileIconGroup networkType(Context context, boolean mainland,
+            MobileIconGroup original) {
+        if (!mainland || !context.getResources().getBoolean(
+                R.bool.config_useStockMainlandNetworkTypeIcons)) return original;
+        if (original == TelephonyIcons.LTE || original == TelephonyIcons.FOUR_G_LTE) {
+            return TelephonyIcons.FOUR_G;
+        }
+        if (original == TelephonyIcons.LTE_PLUS || original == TelephonyIcons.FOUR_G_LTE_PLUS
+                || original == TelephonyIcons.LTE_CA_5G_E) return TelephonyIcons.FOUR_G_PLUS;
+        // OTA cust_sim_features.xml maps type 12 (NR_5G_PLUS) to "5G" for MCC 460.
+        // 5G-A is a separate modem capability in HyperOS; never fabricate that indication.
+        if (original == TelephonyIcons.NR_5G_PLUS) return TelephonyIcons.NR_5G;
+        return original;
+    }
+}
