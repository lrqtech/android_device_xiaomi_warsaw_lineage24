index 000000000000..a7ca022f31a7
--- /dev/null
+++ b/telephony/java/android/telephony/MainlandSignalStrength.java
@@ -0,0 +1,59 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.telephony;
+
+import android.content.res.Resources;
+
+/** Warsaw OS4 China SKU display thresholds; measurements remain unchanged. */
+final class MainlandSignalStrength {
+    // OS4.0.0.15.XHPCNXM /mi_ext/product/etc/cust_features/cust_features.xml.
+    private static final int[] RSRP = {-140, -120, -115, -105};
+    private static final int[] GSM = {-113, -103, -97, -91};
+    private static final int[] WCDMA = {-113, -105, -99, -91};
+    private static final int[] TDSCDMA = {-120, -110, -100, -90};
+    private static final int[] CDMA = {-109, -101, -97, -93};
+
+    private MainlandSignalStrength() {}
+
+    static boolean isEnabled(ServiceState state) {
+        if (state == null || state.isUsingNonTerrestrialNetwork()
+                || !Resources.getSystem().getBoolean(
+                        com.android.internal.R.bool.config_useStockMainlandSignalStrength)) {
+            return false;
+        }
+        String numeric = state.getOperatorNumeric();
+        return numeric != null && (numeric.length() == 5 || numeric.length() == 6)
+                && numeric.startsWith("460");
+    }
+
+    // The OTA excludes the lower bound even when it equals the first threshold.
+    private static int level(int value, int[] thresholds, int minimum, int maximum) {
+        if (value <= minimum || value > maximum) return 0;
+        int result = thresholds.length;
+        while (result > 0 && value < thresholds[result - 1]) result--;
+        return result;
+    }
+
+    static int lte(int rsrp, int rssi, int arfcnBoost) {
+        long boosted = (long) rsrp + arfcnBoost;
+        return boosted >= -140 && boosted <= -44
+                ? level((int) boosted, RSRP, -140, -44) : gsm(rssi);
+    }
+
+    static int nr(int ssRsrp) {
+        // The OTA NR branch does not apply the LTE ARFCN boost.
+        return level(ssRsrp, RSRP, -140, -44);
+    }
+
+    static int gsm(int rssi) { return level(rssi, GSM, -113, -51); }
+    static int wcdma(int rscp) { return level(rscp, WCDMA, -120, -25); }
+    static int tdscdma(int rscp) { return level(rscp, TDSCDMA, -120, -25); }
+
+    static int cdma(int cdmaDbm, int evdoDbm) {
+        int cdma = cdmaDbm == -1 ? 0 : level(cdmaDbm, CDMA, -120, 0);
+        int evdo = evdoDbm == -1 ? 0 : level(evdoDbm, CDMA, -120, 0);
+        return cdma == 0 ? evdo : evdo == 0 ? cdma : Math.min(cdma, evdo);
+    }
+}
