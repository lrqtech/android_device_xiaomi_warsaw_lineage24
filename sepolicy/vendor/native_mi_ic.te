allow mi_ic sysfs_udc:dir { ioctl read getattr lock open watch watch_reads search };

allow mi_ic sysfs_usb_pd:dir { ioctl read getattr lock open watch watch_reads search };

allow mi_ic sysfs_usbcore:dir { ioctl read getattr lock open watch watch_reads search };

allow mi_ic sysfs:file { ioctl read getattr lock map open watch watch_reads };

allow mi_ic sysfs_block:file { ioctl read getattr lock map open watch watch_reads };

