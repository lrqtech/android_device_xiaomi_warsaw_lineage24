type hal_uniperf_default, domain;

domain_auto_trans(init, hal_uniperf_default_exec, hal_uniperf_default)

typeattribute hal_uniperf_default hal_uniperf;

typeattribute hal_uniperf_default hal_uniperf_server;

typeattribute hal_uniperf_default halclientdomain;

typeattribute hal_uniperf_default halserverdomain;

typeattribute hal_uniperf_default mlstrustedsubject;

typeattribute hal_uniperf_default vendor_hal_perf_client;

binder_use(hal_uniperf_default)

allow hal_uniperf_default hal_uniperf_default_exec:file { read getattr map execute open entrypoint };

allow hal_uniperf_default servicemanager:binder { call transfer };

allow hal_uniperf_default vendor_hal_perf_default:binder { call };

allow hal_uniperf_default vendor_uniperf_debug:file { read getattr map open };

allow hal_uniperf_default exported_system_prop:file { read getattr map open };

allow hal_uniperf_default property_socket:sock_file { write };

allow hal_uniperf_default perf_actuator_device:chr_file { ioctl read write open };

allow hal_uniperf_default xr_fbt_device:chr_file { ioctl read write open };

allow hal_uniperf_default self:capability sys_nice;

allow hal_uniperf_default self:cap_userns sys_nice;
