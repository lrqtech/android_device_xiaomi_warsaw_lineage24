allow vendor_hal_qseecom_default vendor_hal_qseecom_default_exec:file { read getattr map execute open entrypoint };

allow vendor_hal_qseecom_default ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_hal_qseecom_default firmware_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_hal_qseecom_default firmware_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hal_qseecom_default firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

