<?xml version="1.0" encoding="utf-8"?>
<policy version="1.0" path="qcom/sm8750/warsaw/app/com.android.camera.xml">
    <app prio="100" name="com.android.camera" >
        <profile name="normal">
            <action name="driverSwitches" switches="MM" value="1"/>
            <action name="gcSetting" enable="0" />
            <action name ="skinTempMonitorSetting" enable="1" interval="3000" trace="1" />

            <action name ="batteryTempMonitorSetting" enable="1" interval="1000" trace="1" />

            <action name="psiCpuSetting" enable="1" interval="1000" trace="1" recorddb="1"/>

            <action name="cameraFpsSetting" delta="2"  interval="1000" />

            <action name="zoneInfoMonitorSetting" enable="1" interval="2000" trace="1"/>
            <action name ="memoryInfoMonitorSetting" enable="1" interval="2000"  trace="1"  recorddb="1" />


            <action name="gpuMinFreq" value="222" />
            <case eventDetector="activityLaunch">
                <action name="fileCacheReclaim" reclaimType="1" reclaimTotal="100" reclaimWindow="5" reclaimInterval="200"/>
            </case>
            <case memFree="-1:300MB">
                <action name="fileCacheReclaim" reclaimType="1" reclaimTotal="100" reclaimWindow="5" reclaimInterval="250"/>
            </case>

            <case batteryLevel="0:3">
                <action name ="algoBypass_BURST" value="2" />
            </case>
            <case batteryLevelAsc="2:3">
                <action name ="algoBypass_BURST" value="2" />
            </case>
            <case batteryLevel="0:6">
                <case batteryTemp="-1000000:-4900">
                    <action name ="algoBypass_BURST" value="2" />
                </case>
                <case batteryTempAsc="-5000:0">
                    <action name ="algoBypass_BURST" value="2" />
                </case>
            </case>
            <case batteryLevelAsc="5:6">
                <case batteryTemp="-1000000:-4900">
                    <action name ="algoBypass_BURST" value="2" />
                </case>
                <case batteryTempAsc="-5000:0">
                    <action name ="algoBypass_BURST" value="2" />
                </case>
            </case>

            <case cameraUsing="true">
                <case batteryLevel="0:6">
                    <action name ="algoBypass_DSAC" value="2" />
                    <action name ="algoBypass_HQQS" value="2" />
                </case>
                <case skinTemp="47000:1000000">
                    <action name ="algoBypass_DSAC" value="2" />
                </case>
                <case skinTempDesc="47000:46000">
                    <action name ="algoBypass_DSAC" value="2" />
                </case>
                <case skinTemp="45000:1000000">
                    <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                </case>
                <case skinTempDesc="45000:44000">
                    <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                </case>
                <case psiCpuSomeAvg10="5000:1000000">
                    <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                </case>
                <case psiCpuSomeAvg10Desc="5000:4500">
                    <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                </case>

                <case skinTemp="45000:1000000">
                    <action name ="algoBypass_MMFPLUS" value="2" />
                </case>
                <case skinTempDesc="45000:43000">
                    <action name ="algoBypass_MMFPLUS" value="2" />
                </case>
                <case batteryLevel="0:6">
                    <action name ="algoBypass_MMFPLUS" value="2" />
                </case>
                <case batteryLevelAsc="5:6">
                    <action name ="algoBypass_MMFPLUS" value="2" />
                </case>
                <case batteryLevel="0:11">
                    <case batteryTemp="-1000000:-4900">
                        <action name ="algoBypass_MMFPLUS" value="2" />
                    </case>
                    <case batteryTempAsc="-5000:0">
                        <action name ="algoBypass_MMFPLUS" value="2" />
                    </case>
                </case>
                <case batteryLevelAsc="10:11">
                    <case batteryTemp="-1000000:-4900">
                        <action name ="algoBypass_MMFPLUS" value="2" />
                    </case>
                    <case batteryTempAsc="-5000:0">
                        <action name ="algoBypass_MMFPLUS" value="2" />
                    </case>
                </case>


                <case skinTemp="46000:1000000">
                    <action name ="algoBypass_VIDEO_BOKEH" value="2" />
                </case>
                <case skinTempDesc="46000:45000">
                    <action name ="algoBypass_VIDEO_BOKEH" value="2" />
                </case>



                <case skinTemp="47000:1000000">
                    <action name ="algoBypass_PREVIEW_ISZ_DISABLE" value="2" />
                </case>

                <case skinTempDesc="47000:46000">
                    <action name ="algoBypass_PREVIEW_ISZ_DISABLE" value="2" />
                </case>


                <case appFpsRangeInner="30:30" videoStream="0">

                    <case skinTemp="44000:1000000">
                        <action name ="cameraPreviewFps" value="25:25" />
                    </case>

                    <case skinTempDesc="44000:42000">
                        <action name ="cameraPreviewFps" value="25:25" />
                    </case>
                    <case batteryLevel="0:6">
                        <action name ="cameraPreviewFps" value="25:25" />
                    </case>

                    <case batteryLevel="0:11">
                        <case batteryTemp="-1000000:-4900">
                            <action name ="cameraPreviewFps" value="25:25" />
                        </case>
                        <case batteryTempAsc="-5000:0">
                            <action name ="cameraPreviewFps" value="25:25" />
                        </case>
                    </case>
                </case>


                <case videoStream="0">
                    <case psiCpuSomeAvg10="6500:1000000">
                        <action name ="algoBypass_HDR" value="2" />
                    </case>
                    <case psiCpuSomeAvg10Desc="6500:6000">
                        <action name ="algoBypass_HDR" value="2" />
                    </case>
                </case>

            </case>
            <macro name="miuiCameraFlash" />

            <case batteryLevel="0:6">
                <action name ="algoBypass_PREVIEW_HDR_DISABLE" value="2" />
            </case>

            <case batteryLevel="0:11">
                <case batteryTemp="-1000000:-4900">
                    <action name ="algoBypass_PREVIEW_HDR_DISABLE" value="2" />
                </case>
                <case batteryTempAsc="-5000:0">
                    <action name ="algoBypass_PREVIEW_HDR_DISABLE" value="2" />
                </case>
            </case>


            <activity name="com.android.camera.CameraPreferenceActivity">



                <break />
            </activity>
            <activity name="com.android.camera.OneShotCamera">

                <case camMode="capture">
                    <macro name="miuiCameraCapture" />
                </case>
                <case camMode="record_video">

                    <case videoFps="60" supportVideoDynamicFps="true" >

                        <case skinTemp="47500:1000000">
                            <action name ="cameraPreviewFps" value="55:55" />
                        </case>

                        <case skinTempDesc="47500:42000">
                            <action name ="cameraPreviewFps" value="55:55" />
                        </case>

                        <case skinTemp="48000:1000000">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>

                        <case skinTempDesc="48000:46000">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>

                        <case batteryLevel="0:3">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>

                        <case batteryLevelAsc="2:5">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>
                    </case>


                    <case rearVideoResolution="3840x1080:-1" videoFps="30" supportVideoDynamicFps="true" >

                        <case skinTemp="47500:1000000">
                            <action name ="cameraPreviewFps" value="25:25" />
                        </case>

                        <case skinTempDesc="47500:42000">
                            <action name ="cameraPreviewFps" value="25:25" />
                        </case>
                    </case>
                    <macro name="miuiCameraRecordVideo" />
                </case>
            </activity>
            <activity name="com.android.camera.Camera">

                <case cameraStage="taking_photo">
                </case>
                <case camMode="portrait" memTotal="-1:9G" memSwapFree="-1:4G">

                </case>

                <case camMode="capture">
                    <macro name="miuiCameraCapture" />
                </case>

                <case camMode="panorama">

                    <break />
                </case>
                <case camMode="pro_photo">

                    <case skinTemp="47000:1000000" camModeSnapshotCnt="3:-1">
                        <action name ="algoBypass_HDR" value="2" />
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                        <action name ="algoBypass_CAPTURE_DEPURPLE" value="2" />
                    </case>

                    <case skinTempDesc="47000:46000" camModeSnapshotCnt="3:-1">
                        <action name ="algoBypass_HDR" value="2" />
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                        <action name ="algoBypass_CAPTURE_DEPURPLE" value="2" />
                    </case>

                    <case batteryLevel="0:6">
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                    </case>
                    <case psiCpuSomeAvg10="6500:1000000">
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                    </case>
                    <case psiCpuSomeAvg10Desc="6500:6000">
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                    </case>

                </case>
                <case camMode="cinematic">
                </case>
                <case thumbnailClick="15000">

                </case>
                <case camMode="portrait">

                    <case cameraId="0">

                        <case skinTemp="45000:1000000">
                            <action name ="algoBypass_PREVIEW_BOKEH" value="2" />
                            <action name ="algoBypass_DSAC" value="2" />

                            <case camModeSnapshotCnt="3:-1">
                                <action name ="algoBypass_HDR" value="2" />
                                <action name ="algoBypass_SE" value="2" />
                                <action name ="algoBypass_SN" value="2" />
                                <action name ="algoBypass_ELL" value="2" />
                                <action name ="algoBypass_SR" value="2" />
                            </case>
                        </case>

                        <case skinTempDesc="45000:43000">
                            <action name ="algoBypass_PREVIEW_BOKEH" value="2" />
                            <action name ="algoBypass_DSAC" value="2" />

                            <case camModeSnapshotCnt="3:-1">
                                <action name ="algoBypass_HDR" value="2" />
                                <action name ="algoBypass_SE" value="2" />
                                <action name ="algoBypass_SN" value="2" />
                                <action name ="algoBypass_ELL" value="2" />
                                <action name ="algoBypass_SR" value="2" />
                            </case>
                        </case>
                    </case>


                    <case batteryLevel="0:6">
                        <case batteryTemp="-1000000:-4900">
                            <action name ="algoBypass_HDR" value="2" />
                        </case>
                        <case batteryTempAsc="-5000:0">
                            <action name ="algoBypass_HDR" value="2" />
                        </case>
                    </case>
                    <case batteryLevel="0:3">
                        <action name ="algoBypass_HDR" value="2" />
                    </case>


                    <case batteryLevel="0:6">
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                    </case>
                    <case psiCpuSomeAvg10="6500:1000000">
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                    </case>
                    <case psiCpuSomeAvg10Desc="6500:6000">
                        <action name ="algoBypass_SE" value="2" />
                        <action name ="algoBypass_SN" value="2" />
                        <action name ="algoBypass_ELL" value="2" />
                    </case>


                    <case cameraId="0">

                        <case batteryLevel="0:6">
                            <case batteryTemp="-1000000:-4900">
                                <action name ="algoBypass_PREVIEW_BOKEH" value="2" />
                            </case>
                            <case batteryTempAsc="-5000:0">
                                <action name ="algoBypass_PREVIEW_BOKEH" value="2" />
                            </case>
                        </case>
                        <case batteryLevel="0:3">
                            <action name ="algoBypass_PREVIEW_BOKEH" value="2" />
                        </case>
                    </case>

                </case>

                <case camMode="doc">

                </case>

                <case camMode="pro_video">
                    <macro name="miuiCameraRecordVideo" />
                </case>

                <case camMode="record_video">

                    <case videoFps="60" supportVideoDynamicFps="true" >

                        <case skinTemp="47500:1000000">
                            <action name ="cameraPreviewFps" value="55:55" />
                        </case>

                        <case skinTempDesc="47500:42000">
                            <action name ="cameraPreviewFps" value="55:55" />
                        </case>

                        <case skinTemp="48000:1000000">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>

                        <case skinTempDesc="48000:46000">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>

                        <case batteryLevel="0:3">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>

                        <case batteryLevelAsc="2:5">
                            <action name ="cameraPreviewFps" value="30:30" />
                        </case>
                    </case>


                    <case videoResolution="3840x1080:-1" videoFps="30" supportVideoDynamicFps="true" >

                        <case skinTemp="47500:1000000">
                            <action name ="cameraPreviewFps" value="25:25" />
                        </case>

                        <case skinTempDesc="47500:42000">
                            <action name ="cameraPreviewFps" value="25:25" />
                        </case>
                    </case>
                    <macro name="miuiCameraRecordVideo" />
                </case>

                <case camMode="more">



                    <break />
                </case>

                <case camMode="pro_ambilight">
                     <action name ="motionStateMonitorSetting" enable="1" />
                    <case motion="false" >
                        <action name ="tripod" value="1" ignoreByProperty="persist.vendor.camera.thermal.debug.tripodMode:0" />
                    </case>
                    <case motion="true" >
                        <action name ="tripod" value="0" />
                    </case>
                </case>

                <case camMode="new_slow_motion">
                     <action name ="motionStateMonitorSetting" enable="1" />
                    <case motion="false" >
                        <action name ="tripod" value="1" ignoreByProperty="persist.vendor.camera.thermal.debug.tripodMode:0" />
                    </case>
                    <case motion="true" >
                        <action name ="tripod" value="0" />
                    </case>
                </case>

                <case camMode="fast_motion">
                     <action name ="motionStateMonitorSetting" enable="1" />
                    <case motion="false" >
                        <action name ="tripod" value="1" ignoreByProperty="persist.vendor.camera.thermal.debug.tripodMode:0" />
                    </case>
                    <case motion="true" >
                        <action name ="tripod" value="0" />
                    </case>
                </case>

            </activity>

        </profile>
    </app>

    <app prio="100" name="__DEFAULT__" >
        <profile name="normal">
            <activity name="__DEFAULT__">
                <case camMode="capture">
                </case>
                <case camMode="portrait">
                </case>
            </activity>
        </profile>
    </app>
</policy>
