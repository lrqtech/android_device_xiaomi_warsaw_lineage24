type vendor_audioftm, domain;

domain_auto_trans(init, vendor_audioftm_exec, vendor_audioftm)

typeattribute vendor_audioftm hal_audio_client;

typeattribute vendor_audioftm halclientdomain;

binder_use(vendor_audioftm)

allow vendor_audioftm vendor_audioftm_exec:file { read getattr map execute open entrypoint };

allow vendor_audioftm servicemanager:binder { call transfer };

allow vendor_audioftm servicemanager:fd { use };

allow vendor_audioftm vendor_audioftm_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans entrypoint };

allow vendor_audioftm vendor_proc_audiod:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_audioftm vendor_proc_audiod:dir { search };

allow vendor_audioftm proc_asound:dir { search };

allow vendor_audioftm proc_asound:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_audioftm devpts:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_audioftm vendor_audio_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_audioftm vendor_audio_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_audioftm audio_device:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_audioftm audio_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_audioftm vendor_sysfs_sndcard:file { ioctl read write getattr lock append map open watch watch_reads };
