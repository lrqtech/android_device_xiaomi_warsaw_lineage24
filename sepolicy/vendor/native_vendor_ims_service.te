type vendor_ims_service, domain;

domain_auto_trans(init, vendor_ims_service_exec, vendor_ims_service)

typeattribute vendor_ims_service halclientdomain;

typeattribute vendor_ims_service netdomain;

typeattribute vendor_ims_service vendor_hal_datafactory_qti_client;

typeattribute vendor_ims_service vendor_hal_imsfactory;

typeattribute vendor_ims_service vendor_hal_imsfactory_server;

typeattribute vendor_ims_service vendor_halserverdomain;

binder_use(vendor_ims_service)

hwbinder_use(vendor_ims_service)

allow vendor_ims_service vendor_ims_service_exec:file { read getattr map execute open entrypoint };

allow vendor_ims_service property_socket:sock_file { write };

allow vendor_ims_service init:unix_stream_socket { connectto };

allow vendor_ims_service vendor_ims_prop:property_service { set };

allow vendor_ims_service vendor_ims_prop:file { read getattr map open };

allow vendor_ims_service vendor_cnd_prop:file { read getattr map open };

allow vendor_ims_service vendor_persist_rcs_prop:file { read getattr map open };

allow vendor_ims_service vendor_sysfs_data:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_ims_service sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_ims_service self:capability2 { block_suspend };

allow vendor_ims_service self:cap2_userns { block_suspend };

allow vendor_ims_service system_suspend_server:binder { call transfer };

allow vendor_ims_service system_suspend_server:fd { use };

allow vendor_ims_service system_suspend_hwservice:hwservice_manager { find };

allow vendor_ims_service hwservicemanager:binder { call transfer };

allow vendor_ims_service hwservicemanager_prop:file { read getattr map open };

allow vendor_ims_service hidl_manager_hwservice:hwservice_manager { find };

allow vendor_ims_service hal_system_suspend_service:service_manager { find };

allow vendor_ims_service servicemanager:binder { call transfer };

allow vendor_ims_service self:capability { net_bind_service };

allow vendor_ims_service self:capability2 { wake_alarm };

allow vendor_ims_service ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_ims_service vendor_cnd_socket:sock_file { write };

allow vendor_ims_service vendor_cnd:unix_stream_socket { connectto };

allow vendor_ims_service self:socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_ims_service self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_ims_service vendor_ims_service_socket:sock_file { write };

allow vendor_ims_service self:tipc_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_ims_service vendor_ctl_vendor_imsrcsservice_prop:property_service { set };

allow vendor_ims_service vendor_ctl_vendor_imsrcsservice_prop:file { read getattr map open };

allow vendor_ims_service vendor_hal_cne_hwservice:hwservice_manager { find };

allow vendor_ims_service system_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_ims_service devpts:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_ims_service vendor_imsd_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };

allow vendor_ims_service vendor_imsd_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allowxperm vendor_ims_service self:udp_socket ioctl { 0x89fd };
