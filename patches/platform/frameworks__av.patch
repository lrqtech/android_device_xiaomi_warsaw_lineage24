+    EXPECT_FALSE(audio_is_linear_pcm(legacy.value()));
+    const auto restored = legacy2aidl_audio_format_t_AudioFormatDescription(legacy.value());
+    ASSERT_TRUE(restored.ok());
+    EXPECT_EQ(initial, restored.value());
+    initial.encoding = "audio/vnd.mi.unknown";
+    EXPECT_FALSE(aidl2legacy_AudioFormatDescription_audio_format_t(initial).ok());
+}
