type vendor_nicmd, domain;

domain_auto_trans(init, vendor_nicmd_exec, vendor_nicmd)

typeattribute vendor_nicmd halclientdomain;

typeattribute vendor_nicmd netdomain;

typeattribute vendor_nicmd vendor_hal_perf_client;

binder_use(vendor_nicmd)

hwbinder_use(vendor_nicmd)

allow vendor_nicmd vendor_nicmd_exec:file { read getattr map execute open entrypoint };

allow vendor_nicmd vendor_nicmd_socket:dir { write lock open add_name remove_name search };

allow vendor_nicmd vendor_nicmd_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_nicmd self:netlink_xfrm_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown nlmsg_read nlmsg_write };

allow vendor_nicmd self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_nicmd self:netlink_route_socket { nlmsg_write };

allow vendor_nicmd self:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_nicmd self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_nicmd self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_nicmd self:tipc_socket { read write create getattr setattr lock append map bind connect listen accept getopt setopt shutdown };

allow vendor_nicmd vendor_nicmd_socket:sock_file { write };

allow vendor_nicmd vendor_qmipriod:unix_stream_socket { connectto };

allow vendor_nicmd sysfs_net:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_nicmd sysfs_net:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_nicmd vendor_sysfs_data:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_nicmd sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_nicmd self:capability2 { block_suspend };

allow vendor_nicmd self:cap2_userns { block_suspend };

allow vendor_nicmd system_suspend_server:binder { call transfer };

allow vendor_nicmd system_suspend_server:fd { use };

allow vendor_nicmd system_suspend_hwservice:hwservice_manager { find };

allow vendor_nicmd hwservicemanager:binder { call transfer };

allow vendor_nicmd hwservicemanager_prop:file { read getattr map open };

allow vendor_nicmd hidl_manager_hwservice:hwservice_manager { find };

allow vendor_nicmd hal_system_suspend_service:service_manager { find };

allow vendor_nicmd servicemanager:binder { call transfer };

allow vendor_nicmd netutils_wrapper_exec:file { read getattr map execute open };

allow vendor_nicmd netutils_wrapper:process { transition };

allow vendor_nicmd netutils_wrapper:process { siginh rlimitinh };

allow vendor_nicmd proc_net:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_nicmd vendor_nicm_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };

allow vendor_nicmd vendor_nicm_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_nicmd netutils_wrapper:process { sigkill };

allow vendor_nicmd system_net_netd_hwservice:hwservice_manager { find };

allow vendor_nicmd self:capability { kill setgid setuid setpcap net_admin net_raw };

allow vendor_nicmd vendor_shsusrd_socket:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_nicmd vendor_shsusrd_socket:sock_file { write };

allow vendor_nicmd vendor_shsusrd:unix_stream_socket { connectto };

allow vendor_nicmd vendor_shsusrd_socket:sock_file { read write };

allow vendor_nicmd property_socket:sock_file { write };

allow vendor_nicmd init:unix_stream_socket { connectto };

allow vendor_nicmd vendor_data_shsusr_prop:property_service { set };

allow vendor_nicmd vendor_data_shsusr_prop:file { read getattr map open };

allow vendor_nicmd vendor_data_qmipriod_prop:property_service { set };

allow vendor_nicmd vendor_data_qmipriod_prop:file { read getattr map open };

allow vendor_nicmd netd:binder { call transfer };

allow vendor_nicmd netd:fd { use };

allow vendor_nicmd servicemanager:fd { use };

allow vendor_nicmd system_net_netd_service:service_manager { find };

allow vendor_nicmd boot_status_prop:file { read getattr map open };

allow vendor_nicmd connectivity_native_service:service_manager { find };

allow vendor_nicmd system_server:fd { use };

allow vendor_nicmd system_server:binder { call transfer };

allow vendor_nicmd system_server:fd { use };

allowxperm vendor_nicmd self:socket ioctl { 0xc300-0xc305 };

allowxperm vendor_nicmd self:udp_socket ioctl { 0x6900 0x6902 };

allowxperm vendor_nicmd self:udp_socket ioctl { 0x890b-0x890d 0x8911 0x8914 0x8916 0x8918 0x891a 0x891c-0x8920 0x8922-0x8927 0x8929 0x8930-0x8932 0x8934-0x8937 0x8939 0x8940-0x8941 0x8943 0x8946-0x894b 0x8953-0x8955 0x8960-0x8962 0x8970-0x8971 0x8980-0x8983 0x8990-0x8995 0x89a0-0x89a3 0x89b0 0x89e0-0x89ff };

allowxperm vendor_nicmd self:udp_socket ioctl { 0x8b00 0x8b02 0x8b04 0x8b06 0x8b08 0x8b0a 0x8b0c 0x8b0e 0x8b10 0x8b14-0x8b1d 0x8b20 0x8b22 0x8b24 0x8b26 0x8b28 0x8b2a-0x8b2c 0x8b30-0x8b36 0x8be0-0x8bff };

allowxperm vendor_nicmd self:udp_socket ioctl { 0x89f1-0x89fd };

# The stock netutils transition inherits a descriptor from nicmd.
allow netutils_wrapper vendor_nicmd:fd use;
# OEM nicmd child-process stdio pipes (OS4 also grants these three).
allow netutils_wrapper vendor_nicmd:fifo_file { getattr read write };
