new file mode 100644
index 0000000000000000000000000000000000000000..66df3bb7826b0e8e3667dcb0c57d34196dc48241
--- /dev/null
+++ b/fsgen/recovery_ramdisk_test.go
@@ -0,0 +1,69 @@
+// Copyright 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+
+package fsgen
+
+import (
+	"android/soong/android"
+	"github.com/google/blueprint/proptools"
+	"testing"
+)
+
+func TestRecoveryRamdiskPlacement(t *testing.T) {
+	for _, tc := range []struct {
+		name                                          string
+		move, fragment, available, supported, diffRef bool
+		want                                          string
+	}{
+		{name: "dedicated_partition", available: true, supported: true},
+		{name: "embedded_platform_ramdisk", move: true, available: true, supported: true, want: "stock_recovery"},
+		{name: "separate_recovery_fragment", move: true, fragment: true, available: true, supported: true},
+		{name: "fragment_without_move", fragment: true, available: true, supported: true},
+		{name: "no_recovery_image", move: true},
+		{name: "unsupported_recovery", move: true, available: true},
+		{name: "comparison_only_image", move: true, available: true, supported: true, diffRef: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			config := android.TestConfig(t.TempDir(), nil, "", nil)
+			config.TestProductVariables.BoardMoveRecoveryResourcesToVendorBoot = proptools.BoolPtr(tc.move)
+			config.TestProductVariables.BoardIncludeRecoveryRamdiskInVendorBoot = proptools.BoolPtr(tc.fragment)
+			var partitions allGeneratedPartitionData
+			if tc.available {
+				partitions = append(partitions, generatedPartitionData{
+					partitionType: "recovery", moduleName: "stock_recovery",
+					supported: tc.supported, diffRef: tc.diffRef,
+				})
+			}
+			if got := recoveryForVendorRamdisk(config, partitions); got != tc.want {
+				t.Fatalf("recovery included in platform vendor ramdisk: got %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestGenericRamdiskDirectoriesForRecoveryLayout(t *testing.T) {
+	for _, tc := range []struct {
+		name                              string
+		gki, recoveryAsBoot, moveRecovery bool
+		wantCount                         int
+	}{
+		{"non_gki", false, false, false, 7},
+		{"dedicated_recovery", true, false, false, 7},
+		{"recovery_as_boot", true, true, false, 14},
+		{"vendor_boot_recovery", true, false, true, 14},
+		{"non_gki_vendor_recovery", false, false, true, 7},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			config := android.TestConfig(t.TempDir(), nil, "", nil)
+			config.TestProductVariables.PartitionVarsForSoongMigrationOnlyDoNotUse.BoardUsesGenericKernelImage = tc.gki
+			config.TestProductVariables.BoardUsesRecoveryAsBoot = proptools.BoolPtr(tc.recoveryAsBoot)
+			config.TestProductVariables.BoardMoveRecoveryResourcesToVendorBoot = proptools.BoolPtr(tc.moveRecovery)
+			dirs := genericRamdiskDirectories(config)
+			android.AssertIntEquals(t, "directory count for boot layout", tc.wantCount, len(dirs))
+			android.AssertDeepEquals(t, "early init root mounts", []string{"debug_ramdisk", "dev", "metadata", "mnt", "proc", "second_stage_resources", "sys"}, dirs[:7])
+			if tc.wantCount == 14 {
+				android.AssertDeepEquals(t, "force-normal-boot mounts", []string{"first_stage_ramdisk/debug_ramdisk", "first_stage_ramdisk/dev", "first_stage_ramdisk/metadata", "first_stage_ramdisk/mnt", "first_stage_ramdisk/proc", "first_stage_ramdisk/second_stage_resources", "first_stage_ramdisk/sys"}, dirs[7:])
+			}
+		})
+	}
+}
