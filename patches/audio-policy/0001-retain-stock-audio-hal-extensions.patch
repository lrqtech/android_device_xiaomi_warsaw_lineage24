+// These values come from the shipped warsaw HAL, not from the frozen AIDL API.
+TEST(XiaomiAudioExtensions, ObservedOutputMasksRoundTrip) {
+    const int32_t masks[] = {0, 6, 8, 32817, 1, 8193, 16384, 260, 4097, 65536, 524288};
+    for (int32_t mask : masks) {
+        SCOPED_TRACE(mask);
+        const auto legacy = aidl2legacy_int32_t_audio_output_flags_t_mask(mask);
+        ASSERT_TRUE(legacy.ok());
+        const auto restored = legacy2aidl_audio_output_flags_t_int32_t_mask(legacy.value());
+        ASSERT_TRUE(restored.ok());
+        EXPECT_EQ(mask, restored.value());
+    }
+    const auto virtualDeep = aidl2legacy_int32_t_audio_output_flags_t_mask(1 << 19);
+    ASSERT_TRUE(virtualDeep.ok());
+    EXPECT_EQ(0x40000000u, static_cast<uint32_t>(virtualDeep.value()));
+    EXPECT_NE(AUDIO_OUTPUT_FLAG_ULTRASOUND, virtualDeep.value());
+    const auto mixed = aidl2legacy_int32_t_audio_output_flags_t_mask((1 << 19) | (1 << 3));
+    ASSERT_TRUE(mixed.ok());
+    EXPECT_EQ(0x40000008u, static_cast<uint32_t>(mixed.value()));
+}
+
+TEST(XiaomiAudioExtensions, UnknownOutputFlagsRemainErrors) {
+    EXPECT_FALSE(aidl2legacy_int32_t_audio_output_flags_t_mask(1 << 20).ok());
+    EXPECT_FALSE(aidl2legacy_int32_t_audio_output_flags_t_mask((1 << 19) | (1 << 20)).ok());
+    EXPECT_FALSE(legacy2aidl_audio_output_flags_t_int32_t_mask(
+            static_cast<audio_output_flags_t>(0x10000000)).ok());
+}
+
+TEST(XiaomiAudioExtensions, BluetoothScoAttributesRoundTrip) {
+    using aidl::android::media::audio::common::AudioAttributes;
+    AudioAttributes initial;
+    initial.usage = static_cast<AudioUsage>(19);
+    initial.flags = AUDIO_FLAG_SCO;
+    const auto legacy = aidl2legacy_AudioAttributes_audio_attributes_t(initial);
+    ASSERT_TRUE(legacy.ok());
+    EXPECT_EQ(AUDIO_USAGE_BLUETOOTH_SCO, legacy.value().usage);
+    const auto restored = legacy2aidl_audio_attributes_t_AudioAttributes(legacy.value());
+    ASSERT_TRUE(restored.ok());
+    EXPECT_EQ(initial, restored.value());
+    EXPECT_FALSE(aidl2legacy_AudioUsage_audio_usage_t(static_cast<AudioUsage>(18)).ok());
+    EXPECT_FALSE(aidl2legacy_AudioUsage_audio_usage_t(static_cast<AudioUsage>(20)).ok());
+}
+
+TEST(XiaomiAudioExtensions, MultirouteDeviceRoundTrip) {
+    using aidl::android::media::audio::common::AudioDeviceDescription;
+    using aidl::android::media::audio::common::AudioDeviceType;
+    AudioDeviceDescription initial;
+    initial.type = AudioDeviceType::OUT_DEVICE;
+    initial.connection = "multiroute";
+    const auto legacy = aidl2legacy_AudioDeviceDescription_audio_devices_t(initial);
+    ASSERT_TRUE(legacy.ok());
+    EXPECT_EQ(0x20000010u, static_cast<uint32_t>(legacy.value()));
+    EXPECT_TRUE(audio_is_output_device(legacy.value()));
+    EXPECT_FALSE(audio_is_input_device(legacy.value()));
+    const auto restored = legacy2aidl_audio_devices_t_AudioDeviceDescription(legacy.value());
+    ASSERT_TRUE(restored.ok());
+    EXPECT_EQ(initial, restored.value());
+    initial.connection = "unknown-xiaomi-route";
+    EXPECT_FALSE(aidl2legacy_AudioDeviceDescription_audio_devices_t(initial).ok());
+}
+
+TEST(XiaomiAudioExtensions, MihcFormatRoundTrip) {
+    using aidl::android::media::audio::common::AudioFormatDescription;
+    AudioFormatDescription initial;
+    initial.encoding = "audio/vnd.mi.mihc";
+    const auto legacy = aidl2legacy_AudioFormatDescription_audio_format_t(initial);
+    ASSERT_TRUE(legacy.ok());
+    EXPECT_EQ(0x40000000u, static_cast<uint32_t>(legacy.value()));
+    EXPECT_TRUE(audio_is_valid_format(legacy.value()));
+    EXPECT_FALSE(audio_is_linear_pcm(legacy.value()));
+    const auto restored = legacy2aidl_audio_format_t_AudioFormatDescription(legacy.value());
+    ASSERT_TRUE(restored.ok());
+    EXPECT_EQ(initial, restored.value());
+    initial.encoding = "audio/vnd.mi.unknown";
+    EXPECT_FALSE(aidl2legacy_AudioFormatDescription_audio_format_t(initial).ok());
+}
