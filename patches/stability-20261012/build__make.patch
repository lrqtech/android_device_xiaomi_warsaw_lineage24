+
+  def _input(self, name="system_dlkm", described=None, fingerprint=True,
+             duplicate=False, os_version="15", valid_image=True):
+    root = common.MakeTempDir()
+    os.makedirs(os.path.join(root, "PREBUILT_IMAGES"))
+    image = os.path.join(root, "PREBUILT_IMAGES", name + ".img")
+    with open(image, "wb") as output:
+      output.write(b"actual AVB footer regression fixture\n")
+    if valid_image:
+      cmd = [common.FindHostToolPath("avbtool"), "add_hash_footer",
+             "--image", image, "--partition_size", "131072",
+             "--partition_name", described or name, "--algorithm", "NONE",
+             "--salt", "00",
+             "--prop", "com.android.build.{}.os_version:{}".format(name, os_version)]
+      if fingerprint:
+        prop = "com.android.build.{}.fingerprint:{}".format(name, self.FINGERPRINT)
+        cmd.extend(["--prop", prop])
+        if duplicate:
+          cmd.extend(["--prop", prop])
+      common.RunAndCheckOutput(cmd)
+    return root
+
