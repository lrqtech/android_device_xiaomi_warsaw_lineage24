# Preserve the Android 17 platform_app_36 baseline for this SDK 36 APK.
typeattribute warsaw_camera_app coredomain;
app_domain(warsaw_camera_app)
net_domain(warsaw_camera_app)
bluetooth_domain(warsaw_camera_app)
platform_app_domain(warsaw_camera_app)

allow warsaw_camera_app domain:memfd_file ioctl;
allowxperm warsaw_camera_app domain:memfd_file ioctl ashmem_ioctls;
allow warsaw_camera_app ashmem_libcutils_device:chr_file open;

# The framework also verifies package name, platform signature and active user.
allow warsaw_camera_app warsaw_camera_display_service:service_manager find;

# OS4.0.0.15 OTA hardware labels, audited 2026-10-14.
allow warsaw_camera_app miev_device:chr_file { open write };
