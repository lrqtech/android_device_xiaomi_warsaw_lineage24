type hal_micharge_default, domain;

type hal_micharge_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_micharge_default)

hal_server_domain(hal_micharge_default, hal_micharge)

hal_attribute_service(hal_micharge, hal_micharge_service)

binder_call(hal_micharge_client, hal_micharge_server)

binder_call(hal_micharge_server, hal_micharge_client)

typeattribute hal_micharge_default hal_micharge;

typeattribute hal_micharge_default hal_micharge_server;

typeattribute hal_micharge_default hal_micharge_client;

binder_use(hal_micharge_default)

allow hal_micharge_default hal_micharge_default_exec:file { read getattr map execute open entrypoint };

