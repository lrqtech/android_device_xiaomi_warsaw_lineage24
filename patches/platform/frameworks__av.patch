diff --git a/services/camera/libcameraservice/device3/CameraMindTransportOwner.cpp b/services/camera/libcameraservice/device3/CameraMindTransportOwner.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..efd69af100e2733756fdb2be7db5d3dec4d690a9
--- /dev/null
+++ b/services/camera/libcameraservice/device3/CameraMindTransportOwner.cpp
@@ -0,0 +1,357 @@
+#include "CameraMindTransportOwner.h"
+
+#include "WarsawExposureRuntime.h"
+
+#include <AuthenticatedUnixChannel.h>
+#include <ExposureWire.h>
+#include <binder/PermissionController.h>
+#include <utils/String16.h>
+
+#include <algorithm>
+#include <chrono>
+#include <limits>
+#include <memory>
+#include <utility>
+
+namespace warsaw::cameramind {
+namespace {
+
+using Channel = AuthenticatedUnixChannel;
+using namespace std::chrono_literals;
+
+constexpr char kCameraMindPackage[] = "com.xiaomi.cameramind";
+constexpr char kCameraMindContext[] = "u:r:cameramind_app:s0";
+constexpr char kCameraServerProcess[] = "cameraserver";
+constexpr uint32_t kCounterLimit = static_cast<uint32_t>(INT32_MAX - 10);
+constexpr int64_t kSerialLimit = INT64_MAX - 10;
+
+int64_t wallMillis() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+bool completeServerEnvelope(const CameraMindReceivedFrame& frame) {
+    return frame.wireSessionId >= 1000 &&
+            frame.envelope.id && *frame.envelope.id >= 0 &&
+            frame.envelope.serial && *frame.envelope.serial >= 0 &&
+            frame.envelope.timeMillis && *frame.envelope.timeMillis >= 0 &&
+            frame.envelope.reply.has_value();
+}
+
+}
+
+CameraMindTransportOwner& CameraMindTransportOwner::instance() {
+    static CameraMindTransportOwner* const owner = new CameraMindTransportOwner();
+    return *owner;
+}
+
+CameraMindTransportOwner::~CameraMindTransportOwner() {
+    android::sp<Worker> worker;
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        mStop = true;
+        if (mActiveChannel != nullptr) mActiveChannel->cancel();
+        worker = mWorker;
+    }
+    mWake.notify_all();
+    if (worker != nullptr) worker->join();
+}
+
+bool CameraMindTransportOwner::registerRuntime(WarsawExposureRuntime* runtime) {
+    if (runtime == nullptr) return false;
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        if (mStop) return false;
+        const bool known = std::find(mRuntimes.begin(), mRuntimes.end(), runtime) != mRuntimes.end();
+        if (!known) {
+            mRuntimes.push_back(runtime);
+            if (mConnectedEpoch != 0 && !runtime->beginControlSource(mConnectedEpoch)) {
+                mRuntimes.pop_back();
+                ++mStats.sourceStartFailures;
+                mStats.registeredRuntimes = mRuntimes.size();
+                return false;
+            }
+        }
+        if (mWorker == nullptr) {
+            auto worker = android::sp<Worker>::make(this);
+            if (worker->run("WarsawMindIO") == android::OK) {
+                mWorker = std::move(worker);
+                mStats.workerStarted = true;
+            } else {
+                ++mStats.connectFailures;
+                if (!known) mRuntimes.pop_back();
+                mStats.registeredRuntimes = mRuntimes.size();
+                return false;
+            }
+        }
+        mStats.registeredRuntimes = mRuntimes.size();
+    }
+    mWake.notify_all();
+    return true;
+}
+
+void CameraMindTransportOwner::unregisterRuntime(WarsawExposureRuntime* runtime) {
+    if (runtime == nullptr) return;
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        auto item = std::find(mRuntimes.begin(), mRuntimes.end(), runtime);
+        if (item == mRuntimes.end()) return;
+        if (mConnectedEpoch != 0) runtime->endControlSource(mConnectedEpoch);
+        mRuntimes.erase(item);
+        mStats.registeredRuntimes = mRuntimes.size();
+        if (mRuntimes.empty() && mActiveChannel != nullptr) mActiveChannel->cancel();
+    }
+    mWake.notify_all();
+}
+
+CameraMindTransportOwner::PublishResult CameraMindTransportOwner::publishExposure(
+        const std::string& cameraId, const ExposureDamper::Report& report) {
+    if (cameraId.empty() || cameraId.size() > 128 || report.count == 0 ||
+            report.count > ExposureDamper::kMaxPending) return PublishResult::Invalid;
+    for (size_t i = 0; i < report.count; ++i) {
+        if (report.points[i].exposureNs <= 0) return PublishResult::Invalid;
+    }
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        if (mConnectedEpoch == 0 || mActiveChannel == nullptr) return PublishResult::Disconnected;
+        if (mReports.size() == kReportQueueCapacity) return PublishResult::Full;
+        mReports.push_back(PendingReport{mConnectedEpoch, cameraId, report});
+        mStats.queuedReports = mReports.size();
+    }
+    mWake.notify_all();
+    return PublishResult::Queued;
+}
+
+CameraMindTransportOwner::Snapshot CameraMindTransportOwner::snapshot() const {
+    std::lock_guard<std::mutex> lock(mLock);
+    Snapshot result = mStats;
+    result.connected = mConnectedEpoch != 0 && mActiveChannel != nullptr;
+    result.sourceEpoch = mConnectedEpoch;
+    result.registeredRuntimes = mRuntimes.size();
+    result.queuedReports = mReports.size();
+    return result;
+}
+
+bool CameraMindTransportOwner::Worker::threadLoop() { return mOwner->step(); }
+
+bool CameraMindTransportOwner::stopped() const {
+    std::lock_guard<std::mutex> lock(mLock);
+    return mStop;
+}
+
+bool CameraMindTransportOwner::waitForWork() {
+    std::unique_lock<std::mutex> lock(mLock);
+    mWake.wait(lock, [this] { return mStop || !mRuntimes.empty(); });
+    return !mStop;
+}
+
+bool CameraMindTransportOwner::waitBackoff(std::chrono::milliseconds delay) {
+    std::unique_lock<std::mutex> lock(mLock);
+    mWake.wait_for(lock, delay, [this] { return mStop || mRuntimes.empty(); });
+    return !mStop;
+}
+
+bool CameraMindTransportOwner::beginSourceLocked(uint64_t epoch) {
+    mConnectedEpoch = epoch;
+    size_t started = 0;
+    for (; started < mRuntimes.size(); ++started) {
+        if (!mRuntimes[started]->beginControlSource(epoch)) {
+            while (started != 0) mRuntimes[--started]->endControlSource(epoch);
+            mConnectedEpoch = 0;
+            return false;
+        }
+    }
+    return true;
+}
+
+void CameraMindTransportOwner::endSourceLocked(uint64_t epoch) {
+    if (epoch == 0 || epoch != mConnectedEpoch) return;
+    for (WarsawExposureRuntime* runtime : mRuntimes) runtime->endControlSource(epoch);
+    mStats.reportsDroppedAtBoundary += mReports.size();
+    mReports.clear();
+    mStats.queuedReports = 0;
+    mConnectedEpoch = 0;
+}
+
+bool CameraMindTransportOwner::takeReport(uint64_t epoch, PendingReport* out) {
+    std::lock_guard<std::mutex> lock(mLock);
+    while (!mReports.empty() && mReports.front().sourceEpoch != epoch) {
+        mReports.pop_front();
+        ++mStats.reportsDroppedAtBoundary;
+    }
+    mStats.queuedReports = mReports.size();
+    if (mReports.empty()) return false;
+    *out = std::move(mReports.front());
+    mReports.pop_front();
+    mStats.queuedReports = mReports.size();
+    return true;
+}
+
+void CameraMindTransportOwner::recordChannelResult(int status, int error) {
+    std::lock_guard<std::mutex> lock(mLock);
+    mStats.lastStatus = status;
+    mStats.lastError = error;
+}
+
+bool CameraMindTransportOwner::step() {
+    if (!waitForWork()) return false;
+
+    Channel::Result channelResult{Channel::Status::InvalidArgument};
+    // Resolve the installed system package on every reconnect; app IDs are
+    // allocated by PackageManager and are not the OEM private AID 6120.
+    // The exact SELinux domain additionally requires the platform signer.
+    android::PermissionController permissions;
+    const int uid = permissions.getPackageUid(android::String16(kCameraMindPackage),
+            android::PermissionController::MATCH_SYSTEM_ONLY);
+    if (uid <= 0) {
+        recordChannelResult(static_cast<int>(Channel::Status::Identity), 0);
+        {
+            std::lock_guard<std::mutex> lock(mLock);
+            ++mStats.identityFailures;
+        }
+        return waitBackoff(500ms);
+    }
+    const CameraMindPeerRequirement required{static_cast<uid_t>(uid), kCameraMindContext};
+    std::unique_ptr<Channel> channel = Channel::connect(required, &channelResult);
+    recordChannelResult(static_cast<int>(channelResult.status), channelResult.error);
+    if (channel == nullptr) {
+        {
+            std::lock_guard<std::mutex> lock(mLock);
+            ++mStats.connectFailures;
+            if (channelResult.status == Channel::Status::Identity) ++mStats.identityFailures;
+        }
+        return waitBackoff(500ms);
+    }
+
+    uint32_t handshakeSession;
+    int32_t handshakeId;
+    int64_t handshakeSerial;
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        mWireSession = mWireSession >= kCounterLimit ? 1000 : mWireSession + 1;
+        handshakeSession = mWireSession;
+        handshakeId = mMessageId;
+        mMessageId = static_cast<uint32_t>(mMessageId) >= kCounterLimit ? 0 : mMessageId + 1;
+        handshakeSerial = mIdentifySerial;
+        mIdentifySerial = mIdentifySerial > kSerialLimit ? 0 : mIdentifySerial + 1;
+    }
+    auto identity = encodeIdentityFrame(static_cast<int32_t>(handshakeSession), handshakeId,
+                                        handshakeSerial, wallMillis(), kCameraServerProcess);
+    if (!identity) {
+        std::lock_guard<std::mutex> lock(mLock);
+        ++mStats.identityFailures;
+        return !mStop;
+    }
+    channelResult = channel->sendFrame(std::string_view(
+            reinterpret_cast<const char*>(identity->data()), identity->size()));
+    recordChannelResult(static_cast<int>(channelResult.status), channelResult.error);
+    if (channelResult.status != Channel::Status::Ok) {
+        std::lock_guard<std::mutex> lock(mLock);
+        ++mStats.sendFailures;
+        return !mStop;
+    }
+
+    uint64_t epoch;
+    bool sourceReady;
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        if (mStop || mRuntimes.empty() || mNextSourceEpoch == UINT64_MAX) {
+            channel->cancel();
+            return !mStop;
+        }
+        epoch = ++mNextSourceEpoch;
+        mActiveChannel = channel.get();
+        sourceReady = beginSourceLocked(epoch);
+        if (!sourceReady) {
+            mActiveChannel = nullptr;
+            ++mStats.sourceStartFailures;
+        } else {
+            ++mStats.connects;
+        }
+    }
+
+    if (!sourceReady) {
+        channel->cancel();
+        return waitBackoff(500ms);
+    }
+
+    while (!stopped()) {
+        PendingReport pending;
+        if (takeReport(epoch, &pending)) {
+            uint32_t wireSession;
+            int32_t messageId;
+            int64_t serial;
+            {
+                std::lock_guard<std::mutex> lock(mLock);
+                if (mConnectedEpoch != epoch || mActiveChannel != channel.get()) break;
+                mWireSession = mWireSession >= kCounterLimit ? 1000 : mWireSession + 1;
+                wireSession = mWireSession;
+                messageId = mMessageId;
+                mMessageId = static_cast<uint32_t>(mMessageId) >= kCounterLimit ? 0 : mMessageId + 1;
+                serial = mExposureSerial;
+                mExposureSerial = mExposureSerial > kSerialLimit ? 0 : mExposureSerial + 1;
+            }
+            auto encoded = encodeExposureFrame(static_cast<int32_t>(wireSession), messageId,
+                    serial, wallMillis(), pending.cameraId, pending.report);
+            if (!encoded) {
+                std::lock_guard<std::mutex> lock(mLock);
+                ++mStats.malformedMessages;
+                continue;
+            }
+            channelResult = channel->sendFrame(std::string_view(
+                    reinterpret_cast<const char*>(encoded->data()), encoded->size()));
+            recordChannelResult(static_cast<int>(channelResult.status), channelResult.error);
+            if (channelResult.status != Channel::Status::Ok) {
+                std::lock_guard<std::mutex> lock(mLock);
+                ++mStats.sendFailures;
+                break;
+            }
+            {
+                std::lock_guard<std::mutex> lock(mLock);
+                ++mStats.reportsSent;
+            }
+            continue;
+        }
+
+        CameraMindReceivedFrame received;
+        channelResult = channel->readFrame(&received, 100ms);
+        if (channelResult.status == Channel::Status::Idle) continue;
+        recordChannelResult(static_cast<int>(channelResult.status), channelResult.error);
+        if (channelResult.status != Channel::Status::Ok) break;
+        if (!completeServerEnvelope(received)) {
+            std::lock_guard<std::mutex> lock(mLock);
+            ++mStats.malformedMessages;
+            break;
+        }
+        if (received.controlDisposition == CameraMindControlDisposition::UnknownWhat) {
+            std::lock_guard<std::mutex> lock(mLock);
+            ++mStats.unknownMessages;
+            continue;
+        }
+        if (received.controlDisposition != CameraMindControlDisposition::Decoded) {
+            std::lock_guard<std::mutex> lock(mLock);
+            ++mStats.controlsRejected;
+            continue;
+        }
+        std::lock_guard<std::mutex> lock(mLock);
+        if (mConnectedEpoch != epoch || mActiveChannel != channel.get()) break;
+        for (WarsawExposureRuntime* runtime : mRuntimes) {
+            const auto result = runtime->submitControl(epoch, received.rawJson);
+            if (result == WarsawExposureRuntime::ControlResult::Queued) ++mStats.controlsApplied;
+            else ++mStats.controlsRejected;
+        }
+    }
+
+    channel->cancel();
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        if (mActiveChannel == channel.get()) {
+            endSourceLocked(epoch);
+            mActiveChannel = nullptr;
+            ++mStats.disconnects;
+        }
+    }
+    return !stopped();
+}
+
+}
diff --git a/services/camera/libcameraservice/device3/CameraMindTransportOwner.h b/services/camera/libcameraservice/device3/CameraMindTransportOwner.h
new file mode 100644
index 0000000000000000000000000000000000000000..d0f35f6ac19911a2a6aba094acd94c24616d32e1
--- /dev/null
+++ b/services/camera/libcameraservice/device3/CameraMindTransportOwner.h
@@ -0,0 +1,100 @@
+#pragma once
+
+#include <ExposureDamper.h>
+
+#include <android-base/thread_annotations.h>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <utils/Thread.h>
+#include <vector>
+
+namespace warsaw::cameramind {
+
+class AuthenticatedUnixChannel;
+class WarsawExposureRuntime;
+
+class CameraMindTransportOwner final {
+public:
+    enum class PublishResult { Queued, Disconnected, Full, Invalid };
+
+    struct Snapshot {
+        bool workerStarted = false;
+        bool connected = false;
+        uint64_t sourceEpoch = 0;
+        size_t registeredRuntimes = 0;
+        size_t queuedReports = 0;
+        uint64_t connects = 0;
+        uint64_t connectFailures = 0;
+        uint64_t identityFailures = 0;
+        uint64_t sourceStartFailures = 0;
+        uint64_t disconnects = 0;
+        uint64_t controlsApplied = 0;
+        uint64_t controlsRejected = 0;
+        uint64_t unknownMessages = 0;
+        uint64_t malformedMessages = 0;
+        uint64_t reportsSent = 0;
+        uint64_t reportsDroppedAtBoundary = 0;
+        uint64_t sendFailures = 0;
+        int lastStatus = 0;
+        int lastError = 0;
+    };
+
+    static CameraMindTransportOwner& instance();
+
+    bool registerRuntime(WarsawExposureRuntime* runtime);
+    void unregisterRuntime(WarsawExposureRuntime* runtime);
+    PublishResult publishExposure(
+            const std::string& cameraId, const ExposureDamper::Report& report);
+    Snapshot snapshot() const;
+
+private:
+    static constexpr size_t kReportQueueCapacity = 128;
+    struct PendingReport {
+        uint64_t sourceEpoch = 0;
+        std::string cameraId;
+        ExposureDamper::Report report;
+    };
+    class Worker final : public android::Thread {
+    public:
+        explicit Worker(CameraMindTransportOwner* owner)
+              : android::Thread(false), mOwner(owner) {}
+    private:
+        bool threadLoop() override;
+        CameraMindTransportOwner* const mOwner;
+    };
+
+    CameraMindTransportOwner() = default;
+    ~CameraMindTransportOwner();
+    CameraMindTransportOwner(const CameraMindTransportOwner&) = delete;
+    CameraMindTransportOwner& operator=(const CameraMindTransportOwner&) = delete;
+
+    bool step();
+    bool stopped() const;
+    bool waitForWork();
+    bool waitBackoff(std::chrono::milliseconds delay);
+    bool beginSourceLocked(uint64_t epoch) REQUIRES(mLock);
+    void endSourceLocked(uint64_t epoch) REQUIRES(mLock);
+    bool takeReport(uint64_t epoch, PendingReport* out);
+    void recordChannelResult(int status, int error);
+
+    mutable std::mutex mLock;
+    std::condition_variable mWake;
+    std::vector<WarsawExposureRuntime*> mRuntimes GUARDED_BY(mLock);
+    std::deque<PendingReport> mReports GUARDED_BY(mLock);
+    android::sp<Worker> mWorker GUARDED_BY(mLock);
+    AuthenticatedUnixChannel* mActiveChannel GUARDED_BY(mLock) = nullptr;
+    bool mStop GUARDED_BY(mLock) = false;
+    uint64_t mNextSourceEpoch GUARDED_BY(mLock) = 0;
+    uint64_t mConnectedEpoch GUARDED_BY(mLock) = 0;
+    uint32_t mWireSession GUARDED_BY(mLock) = 1000;
+    int32_t mMessageId GUARDED_BY(mLock) = 0;
+    int64_t mIdentifySerial GUARDED_BY(mLock) = 0;
+    int64_t mExposureSerial GUARDED_BY(mLock) = 0;
+    Snapshot mStats GUARDED_BY(mLock);
+};
+
+}
diff --git a/services/camera/libcameraservice/device3/WarsawExposureRuntime.cpp b/services/camera/libcameraservice/device3/WarsawExposureRuntime.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..476424a24c1801886e796f8fc0be6c881e2c695c
--- /dev/null
+++ b/services/camera/libcameraservice/device3/WarsawExposureRuntime.cpp
@@ -0,0 +1,339 @@
+#include "WarsawExposureRuntime.h"
+#include "CameraMindTransportOwner.h"
+
+#include <inttypes.h>
+#include <limits>
+#include <stdio.h>
+#include <utility>
+#include <utils/Errors.h>
+
+namespace warsaw::cameramind {
+
+WarsawExposureRuntime::WarsawExposureRuntime(const std::string& cameraId) : mCameraId(cameraId) {}
+
+WarsawExposureRuntime::~WarsawExposureRuntime() {
+    if (mTransportRegistered) CameraMindTransportOwner::instance().unregisterRuntime(this);
+    {
+        std::lock_guard<std::mutex> lock(mQueueLock);
+        mAccept = false;
+        mQuit = true;
+        mPublishedGeneration.store(0, std::memory_order_release);
+        mControlSourceEpoch = 0;
+    }
+    mReady.notify_one();
+    if (mWorker != nullptr) mWorker->join();
+}
+
+void WarsawExposureRuntime::pushControlLocked(Kind kind, uint64_t sourceEpoch) {
+    bool lost = false;
+    if (mCount == kQueueCapacity) {
+        mControlDrops.fetch_add(mCount, std::memory_order_relaxed);
+        mHead = 0;
+        mCount = 0;
+        mControlSourceEpoch = 0;
+        lost = true;
+    }
+    const uint64_t cameraGeneration = kind == Kind::Configure ? mGeneration :
+            (mAccept ? mGeneration : 0);
+    mQueue[(mHead + mCount++) % kQueueCapacity] = Event{kind, cameraGeneration, {}, lost, sourceEpoch, {}};
+}
+
+bool WarsawExposureRuntime::ensureWorkerLocked() {
+    if (mWorker != nullptr) return true;
+    auto worker = android::sp<Worker>::make(this);
+    if (worker->run("WarsawExposure") != android::OK) {
+        mStartFailures.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    mWorker = std::move(worker);
+    return true;
+}
+
+void WarsawExposureRuntime::configured() {
+    if (!mTransportRegistered) {
+        mTransportRegistered = CameraMindTransportOwner::instance().registerRuntime(this);
+    }
+    {
+        std::lock_guard<std::mutex> lock(mQueueLock);
+        if (mQuit || mGeneration == std::numeric_limits<uint64_t>::max()) {
+            mAccept = false;
+            mPublishedGeneration.store(0, std::memory_order_release);
+            return;
+        }
+        if (!ensureWorkerLocked()) {
+            mAccept = false;
+            mPublishedGeneration.store(0, std::memory_order_release);
+            return;
+        }
+        ++mGeneration;
+        pushControlLocked(Kind::Configure);
+        mAccept = true;
+        mPublishedGeneration.store(mGeneration, std::memory_order_release);
+    }
+    mReady.notify_one();
+}
+
+bool WarsawExposureRuntime::beginControlSource(uint64_t sourceEpoch) {
+    {
+        std::lock_guard<std::mutex> lock(mQueueLock);
+        if (mQuit || sourceEpoch == 0 || sourceEpoch <= mLastControlSourceEpoch ||
+                !ensureWorkerLocked()) return false;
+        pushControlLocked(Kind::SourceBegin, sourceEpoch);
+        mLastControlSourceEpoch = sourceEpoch;
+        mControlSourceEpoch = sourceEpoch;
+    }
+    mReady.notify_one();
+    return true;
+}
+
+void WarsawExposureRuntime::endControlSource(uint64_t sourceEpoch) {
+    {
+        std::lock_guard<std::mutex> lock(mQueueLock);
+        if (mQuit || sourceEpoch == 0 || sourceEpoch != mControlSourceEpoch) return;
+        mControlSourceEpoch = 0;
+        pushControlLocked(Kind::SourceEnd, sourceEpoch);
+    }
+    mReady.notify_one();
+}
+
+WarsawExposureRuntime::ControlResult WarsawExposureRuntime::submitControl(
+        uint64_t sourceEpoch, std::string_view json) {
+    CameraMindCommand command;
+    CameraMindControlState::Snapshot snapshot;
+    if (!parseCameraMindCommand(json, &command) ||
+            !CameraMindControlState::copyCommand(command, &snapshot)) {
+        mInvalidControls.fetch_add(1, std::memory_order_relaxed);
+        return ControlResult::Invalid;
+    }
+    {
+        std::lock_guard<std::mutex> lock(mQueueLock);
+        if (mQuit) return ControlResult::Closed;
+        if (mControlSourceEpoch == 0) return ControlResult::NoSource;
+        if (sourceEpoch == 0 || sourceEpoch != mControlSourceEpoch) return ControlResult::StaleSource;
+        if (mCount >= kQueueCapacity - kControlReserve) {
+            mFullControls.fetch_add(1, std::memory_order_relaxed);
+            return ControlResult::Full;
+        }
+        Event event{Kind::Command, 0, {}, false, sourceEpoch, snapshot};
+        mQueue[(mHead + mCount++) % kQueueCapacity] = event;
+    }
+    mReady.notify_one();
+    return ControlResult::Queued;
+}
+
+void WarsawExposureRuntime::close() {
+    {
+        std::lock_guard<std::mutex> lock(mQueueLock);
+        mPublishedGeneration.store(0, std::memory_order_release);
+        if (!mAccept) return;
+        mAccept = false;
+        pushControlLocked(Kind::Close);
+    }
+    mReady.notify_one();
+}
+
+uint64_t WarsawExposureRuntime::snapshotGeneration() const noexcept {
+    return mPublishedGeneration.load(std::memory_order_acquire);
+}
+
+void WarsawExposureRuntime::observe(
+        uint64_t ticket, uint32_t frame, const camera_metadata_t* metadata) {
+    std::unique_lock<std::mutex> lock(mQueueLock, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        mBusyDrops.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    if (!mAccept || mQuit || ticket == 0 || ticket != mGeneration) {
+        mStaleTicketDrops.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    Event event{Kind::Sample, mGeneration, {}, false, 0, {}};
+    const auto result = ExposureResultSampler::copyMetadata(mGeneration, frame, metadata, &event.sample);
+    if (result == ExposureResultSampler::Result::MissingExposure) return;
+    if (result != ExposureResultSampler::Result::Queued) {
+        mInvalidResults.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    if (mCount >= kQueueCapacity - kControlReserve) {
+        mFullDrops.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    mQueue[(mHead + mCount++) % kQueueCapacity] = event;
+    lock.unlock();
+    mReady.notify_one();
+}
+
+bool WarsawExposureRuntime::Worker::threadLoop() { return mOwner->step(); }
+
+void WarsawExposureRuntime::discardSourceHistory() {
+    const auto pending = mDamper.flush();
+    mDamper.reset();
+    if (pending) {
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        mSummary.sourceBoundaryDiscardedPoints += pending->count;
+    }
+}
+
+void WarsawExposureRuntime::recordReport(
+        const std::optional<ExposureDamper::Report>& report, bool flushed) {
+    if (!report) return;
+    const auto delivery = CameraMindTransportOwner::instance().publishExposure(mCameraId, *report);
+    std::lock_guard<std::mutex> lock(mSummaryLock);
+    ++mSummary.reports;
+    if (flushed) ++mSummary.flushedReports;
+    mSummary.reportSize = report->count;
+    switch (delivery) {
+        case CameraMindTransportOwner::PublishResult::Queued:
+            ++mSummary.reportsTransportQueued;
+            break;
+        case CameraMindTransportOwner::PublishResult::Disconnected:
+            ++mSummary.reportsTransportDisconnected;
+            break;
+        case CameraMindTransportOwner::PublishResult::Full:
+            ++mSummary.reportsTransportFull;
+            break;
+        case CameraMindTransportOwner::PublishResult::Invalid:
+            ++mSummary.reportsTransportInvalid;
+            break;
+    }
+}
+
+bool WarsawExposureRuntime::step() {
+    Event event;
+    {
+        std::unique_lock<std::mutex> lock(mQueueLock);
+        mReady.wait(lock, [this] { return mQuit || mCount != 0; });
+        if (mCount == 0) {
+            lock.unlock();
+            recordReport(mDamper.flush(), true);
+            return false;
+        }
+        event = mQueue[mHead];
+        mQueue[mHead] = Event{};
+        mHead = (mHead + 1) % kQueueCapacity;
+        --mCount;
+    }
+    if (event.resetAfterQueueLoss) {
+        discardSourceHistory();
+        mControl.resetFlags();
+        mWorkerSourceEpoch = 0;
+        mWorkerGeneration = event.generation;
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        mSummary.controlSourceEpoch = 0;
+        mSummary.reportFlags = {};
+        mSummary.generation = mWorkerGeneration;
+        mSummary.open = mWorkerGeneration != 0;
+        mSummary.known = false;
+        mSummary.exposureNs = 0;
+        mSummary.wallMillis = 0;
+    }
+    if (event.kind == Kind::SourceBegin || event.kind == Kind::SourceEnd) {
+        if (event.kind == Kind::SourceEnd && event.sourceEpoch != mWorkerSourceEpoch) return true;
+        discardSourceHistory();
+        mControl.resetFlags();
+        mWorkerSourceEpoch = event.kind == Kind::SourceBegin ? event.sourceEpoch : 0;
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        mSummary.controlSourceEpoch = mWorkerSourceEpoch;
+        mSummary.reportFlags = mControl.flags();
+        return true;
+    }
+    if (event.kind == Kind::Command) {
+        if (event.sourceEpoch == 0 || event.sourceEpoch != mWorkerSourceEpoch) {
+            std::lock_guard<std::mutex> lock(mSummaryLock);
+            ++mSummary.staleCommands;
+            return true;
+        }
+        if (!mControl.apply(event.command, mDamper)) {
+            mInvalidControls.fetch_add(1, std::memory_order_relaxed);
+            return true;
+        }
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        ++mSummary.commandsApplied;
+        mSummary.reportFlags = mControl.flags();
+        return true;
+    }
+    if (event.kind == Kind::Configure || event.kind == Kind::Close) {
+        recordReport(mDamper.flush(), true);
+        mDamper.reset();
+        mWorkerGeneration = event.kind == Kind::Configure ? event.generation : 0;
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        mSummary.generation = mWorkerGeneration;
+        mSummary.open = mWorkerGeneration != 0;
+        mSummary.known = false;
+        mSummary.exposureNs = 0;
+        mSummary.wallMillis = 0;
+        return true;
+    }
+    if (event.generation == 0 || event.generation != mWorkerGeneration) {
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        ++mSummary.staleSamples;
+        return true;
+    }
+    {
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        ++mSummary.samples;
+        mSummary.known = true;
+        mSummary.exposureNs = event.sample.exposureNs;
+        mSummary.wallMillis = event.sample.observedWallMillis;
+        if (!mControl.exposureEnabled()) {
+            ++mSummary.disabledSamples;
+            return true;
+        }
+    }
+    recordReport(mDamper.add(event.sample.exposureNs, event.sample.observedWallMillis), false);
+    return true;
+}
+
+void WarsawExposureRuntime::dump(int fd) const {
+    Summary summary;
+    {
+        std::lock_guard<std::mutex> lock(mSummaryLock);
+        summary = mSummary;
+    }
+    const auto transport = CameraMindTransportOwner::instance().snapshot();
+    dprintf(fd, "    Warsaw exposure producer: camera=%s generation=%" PRIu64
+            " open=%d known=%d transport=%s epoch=%" PRIu64 "\n", mCameraId.c_str(),
+            summary.generation, summary.open, summary.known,
+            transport.connected ? "CONNECTED" : "DISCONNECTED", transport.sourceEpoch);
+    dprintf(fd, "      samples=%" PRIu64 " reports=%" PRIu64 " flushed=%" PRIu64
+            " stale=%" PRIu64 " last_report_size=%zu\n", summary.samples, summary.reports,
+            summary.flushedReports, summary.staleSamples, summary.reportSize);
+    dprintf(fd, "      transport_queued=%" PRIu64 " disconnected=%" PRIu64
+            " full=%" PRIu64 " invalid=%" PRIu64 " process_sent=%" PRIu64
+            " process_boundary_drops=%" PRIu64 " queue=%zu\n",
+            summary.reportsTransportQueued, summary.reportsTransportDisconnected,
+            summary.reportsTransportFull, summary.reportsTransportInvalid,
+            transport.reportsSent, transport.reportsDroppedAtBoundary,
+            transport.queuedReports);
+    dprintf(fd, "      transport_connects=%" PRIu64 " failures=%" PRIu64
+            " identity_failures=%" PRIu64 " source_start_failures=%" PRIu64
+            " disconnects=%" PRIu64
+            " controls_applied=%" PRIu64 " controls_rejected=%" PRIu64
+            " malformed=%" PRIu64 " unknown=%" PRIu64 " last_status=%d last_errno=%d\n",
+            transport.connects, transport.connectFailures, transport.identityFailures,
+            transport.sourceStartFailures, transport.disconnects,
+            transport.controlsApplied, transport.controlsRejected,
+            transport.malformedMessages, transport.unknownMessages,
+            transport.lastStatus, transport.lastError);
+    dprintf(fd, "      busy_drops=%" PRIu64 " full_drops=%" PRIu64 " control_queue_losses=%" PRIu64
+            " invalid=%" PRIu64 " worker_start_failures=%" PRIu64
+            " stale_ticket_drops=%" PRIu64 "\n",
+            mBusyDrops.load(), mFullDrops.load(), mControlDrops.load(),
+            mInvalidResults.load(), mStartFailures.load(), mStaleTicketDrops.load());
+    dprintf(fd, "      control_source_epoch=%" PRIu64 " commands_applied=%" PRIu64
+            " stale_commands=%" PRIu64 " invalid_controls=%" PRIu64 " full_controls=%" PRIu64
+            " disabled_samples=%" PRIu64 " source_boundary_discarded_points=%" PRIu64 "\n",
+            summary.controlSourceEpoch, summary.commandsApplied, summary.staleCommands,
+            mInvalidControls.load(), mFullControls.load(), summary.disabledSamples,
+            summary.sourceBoundaryDiscardedPoints);
+    const auto& flags = summary.reportFlags;
+    dprintf(fd, "      flags preview_fps=%d exposure=%d frame_duration=%d flicker=%d motion=%d trace=%d\n",
+            flags.reportPreviewAvgFps, flags.reportExposureTime, flags.reportFrameDuration,
+            flags.reportFlickerScene, flags.reportMotionVelocity, flags.traceOn);
+    if (summary.known) {
+        dprintf(fd, "      observed_exposure_ns=%" PRId64 " observed_wall_ms=%" PRId64 "\n",
+                summary.exposureNs, summary.wallMillis);
+    }
+}
+
+}
diff --git a/services/camera/libcameraservice/device3/WarsawExposureRuntime.h b/services/camera/libcameraservice/device3/WarsawExposureRuntime.h
new file mode 100644
index 0000000000000000000000000000000000000000..5cae2cf8c8940cee10eadb19ecf3cd33c5f561ec
--- /dev/null
+++ b/services/camera/libcameraservice/device3/WarsawExposureRuntime.h
@@ -0,0 +1,114 @@
+#pragma once
+
+#include <ExposureDamper.h>
+#include <ExposureResultSampler.h>
+#include <control/CameraMindControlState.h>
+#include <array>
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <string_view>
