type vendor_location, domain;

domain_auto_trans(init, vendor_location_exec, vendor_location)

allow vendor_location vendor_location_exec:file { read getattr map execute open entrypoint };

allow vendor_location self:capability { setgid setuid };

allow vendor_location vendor_location_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };

allow vendor_location vendor_location_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_location vendor_location_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_location vendor_location_socket:lnk_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_location vendor_location_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_location vendor_location_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };

allow vendor_location vendor_hal_gnss_qti:unix_dgram_socket { sendto };

allow vendor_location vendor_location_lowi_server:unix_dgram_socket { sendto };

allow vendor_location vendor_location_lowi_server_exec:file { read getattr map execute open };

allow vendor_location vendor_location_lowi_server:process { transition };

allow vendor_location vendor_location_lowi_server:process { siginh rlimitinh };

allow vendor_location vendor_location_xtra_daemon_exec:file { read getattr map execute open };

allow vendor_location vendor_location_xtra_daemon:process { transition };

allow vendor_location vendor_location_xtra_daemon:process { siginh rlimitinh };

allow vendor_location system_server:binder { transfer };

allow vendor_location vendor_location_edgnss_daemon_exec:file { read getattr map execute open };

allow vendor_location vendor_location_edgnss_daemon:process { transition };

allow vendor_location vendor_location_edgnss_daemon:process { siginh rlimitinh };

allow vendor_location vendor_location_engine_service_exec:file { read getattr map execute open };

allow vendor_location vendor_location_slim_daemon_exec:file { read getattr map execute open };

allow vendor_location vendor_location_xtwifi_client_exec:file { read getattr map execute open };

allow vendor_location vendor_location_xtwifi_client:process { transition };

allow vendor_location vendor_location_xtwifi_client:process { siginh rlimitinh };
