diff --git a/fan/fan.cpp b/fan/fan.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d40f94206027e2eadd95ca23c08a33f7ee28aeeb
--- /dev/null
+++ b/fan/fan.cpp
@@ -0,0 +1,237 @@
+#include "recovery_fan/fan.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <cstring>
+#include <string>
+
+namespace recovery_fan {
+namespace {
+constexpr const char* kRoot = "/sys/devices/platform/soc/soc:xiaomi_fan/";
+constexpr int kDuty = 99;
+constexpr int kAvailabilitySeconds = 10;
+
+bool Fail(std::string* error, const std::string& operation, int code) {
+  *error = operation + ": " + std::strerror(code);
+  errno = code;
+  return false;
+}
+
+bool FinishFd(int fd, bool ok, int saved, std::string* error, const std::string& name) {
+  // Linux consumes the fd even when close reports an error. Never retry it.
+  if (close(fd) != 0) {
+    const int close_error = errno;
+    if (ok) return Fail(error, "close " + name, close_error);
+    *error += "; close: " + std::string(std::strerror(close_error));
+  }
+  errno = saved;
+  return ok;
+}
+
+int OpenNode(const char* leaf, int flags, std::string* error) {
+  const std::string path = std::string(kRoot) + leaf;
+  int fd;
+  do {
+    fd = open(path.c_str(), flags | O_CLOEXEC | O_NOFOLLOW);
+  } while (fd < 0 && errno == EINTR);
+  if (fd < 0) {
+    Fail(error, "open " + path, errno);
+    return -1;
+  }
+  struct stat st {};
+  if (fstat(fd, &st) != 0) {
+    const int saved = errno;
+    Fail(error, "fstat " + path, saved);
+    FinishFd(fd, false, saved, error, path);
+    return -1;
+  }
+  if (!S_ISREG(st.st_mode)) {
+    Fail(error, "unexpected node type " + path, EINVAL);
+    FinishFd(fd, false, EINVAL, error, path);
+    return -1;
+  }
+  return fd;
+}
+
+bool Read(const char* leaf, int* out, std::string* error) {
+  int fd = OpenNode(leaf, O_RDONLY, error);
+  if (fd < 0) return false;
+  char buf[32];
+  size_t size = 0;
+  bool ok = true;
+  while (size < sizeof(buf)) {
+    ssize_t got;
+    do {
+      got = read(fd, buf + size, sizeof(buf) - size);
+    } while (got < 0 && errno == EINTR);
+    if (got < 0) {
+      ok = Fail(error, std::string("read ") + leaf, errno);
+      break;
+    }
+    if (got == 0) break;
+    size += got;
+  }
+  if (ok && (size == 0 || size == sizeof(buf))) {
+    ok = Fail(error, std::string("empty or oversized value ") + leaf, EINVAL);
+  }
+  int value = 0;
+  if (ok) {
+    size_t digits = size;
+    if (buf[digits - 1] == '\n') --digits;
+    if (digits == 0 || digits > 3) {
+      ok = Fail(error, std::string("invalid integer ") + leaf, EINVAL);
+    } else {
+      for (size_t i = 0; i < digits; ++i) {
+        if (buf[i] < '0' || buf[i] > '9') {
+          ok = Fail(error, std::string("invalid integer ") + leaf, EINVAL);
+          break;
+        }
+        value = value * 10 + buf[i] - '0';
+      }
+    }
+  }
+  const int saved = ok ? 0 : errno;
+  if (!FinishFd(fd, ok, saved, error, leaf)) return false;
+  *out = value;
+  return true;
+}
+
+bool Write(const char* leaf, const char* value, std::string* error) {
+  int fd = OpenNode(leaf, O_WRONLY, error);
+  if (fd < 0) return false;
+  const size_t size = std::strlen(value);
+  ssize_t wrote;
+  do {
+    wrote = write(fd, value, size);
+  } while (wrote < 0 && errno == EINTR);
+  bool ok = true;
+  if (wrote < 0) ok = Fail(error, std::string("write ") + leaf, errno);
+  else if (static_cast<size_t>(wrote) != size) {
+    // A sysfs store is one complete command; replaying a suffix is unsafe.
+    ok = Fail(error, std::string("short write ") + leaf, EIO);
+  }
+  return FinishFd(fd, ok, ok ? 0 : errno, error, leaf);
+}
+
+bool ReadState(int* target, int* duty, int* speed, std::string* error) {
+  int support;
+  if (!Read("fan_support", &support, error) || !Read("target_level", target, error) ||
+      !Read("pwm_duty", duty, error) || !Read("real_speed", speed, error)) return false;
+  if (support != 1) return Fail(error, "fan is unsupported", ENODEV);
+  if (*target < 0 || *target > 4 || *duty < 0 || *duty > 100) {
+    return Fail(error, "driver value outside documented range", ERANGE);
+  }
+  return true;
+}
+
+bool WaitForState(int* target, int* duty, int* speed, std::string* error) {
+  struct timespec begin {}, now {};
+  if (clock_gettime(CLOCK_MONOTONIC, &begin) != 0) return Fail(error, "clock_gettime", errno);
+  for (;;) {
+    if (ReadState(target, duty, speed, error)) return true;
+    if (errno != ENOENT) return false;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) return Fail(error, "clock_gettime", errno);
+    if (now.tv_sec - begin.tv_sec > kAvailabilitySeconds ||
+        (now.tv_sec - begin.tv_sec == kAvailabilitySeconds && now.tv_nsec >= begin.tv_nsec)) {
+      return Fail(error, "fan nodes did not appear within 10 seconds", ETIMEDOUT);
+    }
+    struct timespec pause {0, 100000000};
+    while (nanosleep(&pause, &pause) != 0) {
+      if (errno != EINTR) return Fail(error, "nanosleep", errno);
+    }
+  }
+}
+// A sysfs store may apply a command and still fail on close, or swallow a
+// driver error. Once initialization has attempted a write, failure must request
+// an explicit stop; target_level=0 alone can skip stopping an already-zero
+// target with a positive raw duty in this driver.
+bool StopAfterFailure(std::string* error) {
+  const int primary_error = errno;
+  std::string cleanup_error;
+  // Clear debug overrides and the normal target before the final raw stop.
+  // The target transition synchronously drains the dynamic adjustment worker;
+  // a raw PWM write alone does not drain a worker already past its entry checks.
+  for (const char* target : {"100\n", "0\n"}) {
+    cleanup_error.clear();
+    if (!Write("target_level", target, &cleanup_error)) {
+      *error += "; stop target: " + cleanup_error;
+    }
+  }
+  cleanup_error.clear();
+  if (!Write("pwm_duty", "0\n", &cleanup_error)) {
+    *error += "; stop PWM: " + cleanup_error;
+  }
+  int target, duty;
+  cleanup_error.clear();
+  if (!Read("target_level", &target, &cleanup_error)) {
+    *error += "; stop target readback: " + cleanup_error;
+  } else if (target != 0) {
+    *error += "; stop target readback is not zero";
+  }
+  cleanup_error.clear();
+  if (!Read("pwm_duty", &duty, &cleanup_error)) {
+    *error += "; stop PWM readback: " + cleanup_error;
+  } else if (duty != 0) {
+    *error += "; stop PWM readback is not zero";
+  }
+  errno = primary_error;
+  return false;
+}
+}  // namespace
+
+bool Required() {
+#ifdef WARSAW_RECOVERY_FAN99
+  return true;
+#else
+  return false;
+#endif
+}
+
+bool Check(std::string* error) {
+  if (!Required()) return true;
+  int target, duty, speed;
+  if (!ReadState(&target, &duty, &speed, error)) return false;
+  // 2 is the driver's "measurement unavailable" sentinel. It is not an RPM.
+  // REC has no measured-speed writer; this makes the dynamic worker wait
+  // without changing duty. A different value must not silently enable it.
+  if (target != 4 || duty != kDuty || speed != 2) {
+    return Fail(error, "fan driver state is not target 4 / 99% PWM / unmeasured speed", EIO);
+  }
+  return true;
+}
+
+bool Initialize(std::string* error) {
+  if (!Required()) return true;
+  int target, duty, speed;
+  if (!WaitForState(&target, &duty, &speed, error)) return false;
+  if (speed != 2) return Fail(error, "fan speed state is not the unmeasured sentinel", EIO);
+
+  // The show() value hides the underlying normal target when a debug target
+  // is active. Always clear that override, even when effective target/duty
+  // already read 4/99. With an already-normal 4/99 state these writes are
+  // driver no-ops and do not power-cycle the fan.
+  if (!Write("target_level", "100\n", error)) return StopAfterFailure(error);
+  if (!ReadState(&target, &duty, &speed, error)) return StopAfterFailure(error);
+  if (speed != 2) {
+    Fail(error, "fan speed state changed during initialization", EIO);
+    return StopAfterFailure(error);
+  }
+  if (!Write("target_level", "4\n", error)) return StopAfterFailure(error);
+  if (!ReadState(&target, &duty, &speed, error)) return StopAfterFailure(error);
+  if (target != 4 || speed != 2) {
+    Fail(error, "normal fan target did not settle before PWM request", EIO);
+    return StopAfterFailure(error);
+  }
+  // Keeping the normal target nonzero is essential: OCP changes it to zero,
+  // so the selected driver's same-target shortcut cannot skip its stop.
+  // Separate sysfs commands are not atomic with OCP. A fault after this
+  // precheck can race the final write; failed final readback requests PWM0.
+  if (!Write("pwm_duty", "99\n", error)) return StopAfterFailure(error);
+  if (!Check(error)) return StopAfterFailure(error);
+  return true;
+}
+}  // namespace recovery_fan
