+// mountinfo escapes whitespace and backslashes in pathname fields. Compare the
+// encoded name; do not confuse an escaped space with a field separator.
+static std::string EncodeMountInfoPath(const std::string& path) {
+    std::string encoded;
+    for (char c : path) {
+        switch (c) {
+            case ' ': encoded += "\\040"; break;
+            case '\t': encoded += "\\011"; break;
+            case '\n': encoded += "\\012"; break;
+            case '\\': encoded += "\\134"; break;
+            default: encoded += c;
+        }
+    }
+    return encoded;
+}
+
+static bool HasMountOption(const std::string& options, const std::string& option) {
+    auto values = android::base::Split(options, ",");
+    return std::find(values.begin(), values.end(), option) != values.end();
+}
+
+// This recognizes a whole, block-backed filesystem in the caller's current
+// namespace. A source pathname (including a mapper alias) is not an identity:
+// compare the device numbers supplied by stat and by the kernel's mountinfo.
+static bool MountedEntryMatches(const FstabEntry& expected, const std::string& mount_point) {
+    constexpr unsigned long kPerMountFlags =
+            MS_NOSUID | MS_NODEV | MS_NOEXEC | MS_NOATIME | MS_NODIRATIME | MS_NOSYMFOLLOW;
+    constexpr unsigned long kSuperFlags = MS_SYNCHRONOUS | MS_LAZYTIME;
+    constexpr unsigned long kKnownFlags = MS_RDONLY | kPerMountFlags | kSuperFlags;
+    if ((expected.flags & ~kKnownFlags) != 0) {
+        LERROR << "Cannot verify special mount flags for " << mount_point;
+        return false;
+    }
+
+    std::string mountinfo;
+    if (!android::base::ReadFileToString("/proc/self/mountinfo", &mountinfo)) {
+        PERROR << "Failed to read mount identity for " << mount_point;
+        return false;
+    }
+
+    const auto encoded_point = EncodeMountInfoPath(mount_point);
+    std::vector<std::string> match;
+    size_t separator = 0;
+    for (const auto& line : android::base::Split(mountinfo, "\n")) {
+        if (line.empty()) continue;
+        auto fields = android::base::Tokenize(line, " \t");
+        if (fields.size() < 10) {
+            LERROR << "Malformed mountinfo";
+            return false;
+        }
+        auto sep = std::find(fields.begin() + 6, fields.end(), "-");
+        if (sep == fields.end() || std::distance(sep, fields.end()) != 4) {
+            LERROR << "Malformed mountinfo separator";
+            return false;
+        }
+        if (fields[4] != encoded_point) continue;
+        if (!match.empty()) {
+            // Stacked mounts require an explicit visible-mount identity; the
+            // first matching text row is not enough to establish that.
+            LERROR << "Ambiguous stacked mounts at " << mount_point;
+            return false;
+        }
+        separator = std::distance(fields.begin(), sep);
+        match = std::move(fields);
+    }
+    if (match.empty() || match[3] != "/" || match[separator + 1] != expected.fs_type) {
+        LERROR << "Mounted filesystem/root does not match " << mount_point;
+        return false;
+    }
+
+    const auto device = android::base::Split(match[2], ":");
+    uint32_t device_major, device_minor;
+    if (device.size() != 2 || !android::base::ParseUint(device[0], &device_major) ||
+        !android::base::ParseUint(device[1], &device_minor)) {
+        LERROR << "Invalid mounted device identity";
+        return false;
+    }
+    struct stat source_stat {}, target_stat {};
+    if (stat(expected.blk_device.c_str(), &source_stat) != 0 ||
+        stat(mount_point.c_str(), &target_stat) != 0) {
+        PERROR << "Unable to verify mounted device for " << mount_point;
+        return false;
+    }
+    const dev_t mounted_device = makedev(device_major, device_minor);
+    if (!S_ISBLK(source_stat.st_mode) || !S_ISDIR(target_stat.st_mode) ||
+        source_stat.st_rdev != mounted_device || target_stat.st_dev != mounted_device) {
+        LERROR << "Mounted block device does not match " << mount_point;
+        return false;
+    }
+
+    const auto& mount_options = match[5];
+    const auto& super_options = match[separator + 3];
+    if (HasMountOption(mount_options, "ro") == HasMountOption(mount_options, "rw") ||
+        HasMountOption(super_options, "ro") == HasMountOption(super_options, "rw")) {
+        LERROR << "Unknown mounted read/write mode at " << mount_point;
+        return false;
+    }
+    const bool read_only = HasMountOption(mount_options, "ro") ||
+                           HasMountOption(super_options, "ro");
+    if (read_only != ((expected.flags & MS_RDONLY) != 0)) {
+        LERROR << "Mounted read/write mode does not match " << mount_point;
+        return false;
+    }
+    for (const auto& [flag, name] : {
+                 std::pair<unsigned long, const char*>{MS_NOSUID, "nosuid"},
+                 {MS_NODEV, "nodev"}, {MS_NOEXEC, "noexec"}, {MS_NOATIME, "noatime"},
+                 {MS_NODIRATIME, "nodiratime"}, {MS_NOSYMFOLLOW, "nosymfollow"}}) {
+        if ((expected.flags & flag) && !HasMountOption(mount_options, name)) {
+            LERROR << "Mounted filesystem lacks " << name << " at " << mount_point;
+            return false;
+        }
+    }
+    for (const auto& [flag, name] : {
+                 std::pair<unsigned long, const char*>{MS_SYNCHRONOUS, "sync"},
+                 {MS_LAZYTIME, "lazytime"}}) {
+        if ((expected.flags & flag) && !HasMountOption(super_options, name)) {
+            LERROR << "Mounted filesystem lacks " << name << " at " << mount_point;
+            return false;
+        }
+    }
+    return true;
+}
