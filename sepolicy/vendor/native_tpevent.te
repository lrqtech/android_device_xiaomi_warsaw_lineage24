type tpevent, domain;

domain_auto_trans(init, tpevent_exec, tpevent)

allow tpevent tpevent_exec:file { read getattr map execute open entrypoint };

allow tpevent tpevent_exec:file { entrypoint };

allow tpevent input_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow tpevent input_device:dir { ioctl read getattr lock open watch watch_reads search };

allow tpevent sysfs_touch_suspend:file { ioctl read write getattr lock append map open watch watch_reads };

allow tpevent sysfs_touch_hostprocess:file { ioctl read write getattr lock append map open watch watch_reads };

allow tpevent proc_interrupts:file { ioctl read getattr lock map open watch watch_reads };

allow tpevent proc_tp_lockdown:file { ioctl read getattr lock map open watch watch_reads };

allow tpevent touchfeature_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow tpevent touchfeature_device:file { read getattr map };

allow tpevent sysfs_keyboard_status:file { ioctl read write getattr lock append map open watch watch_reads };
