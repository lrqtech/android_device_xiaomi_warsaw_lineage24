diff --git a/services/camera/libcameraservice/utils/WarsawCameraSessionParams.h b/services/camera/libcameraservice/utils/WarsawCameraSessionParams.h
new file mode 100644
index 0000000000000000000000000000000000000000..06e7794c13ea9e3b79e0167228dadbdc8d97733a
--- /dev/null
+++ b/services/camera/libcameraservice/utils/WarsawCameraSessionParams.h
@@ -0,0 +1,60 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <android-base/properties.h>
+#include <camera/CameraMetadata.h>
+#include <camera/VendorTagDescriptor.h>
+#include <camera_metadata_hidden.h>
+#include <utils/String8.h>
+
+namespace android::warsawCameraSession {
+
+// OS4 CameraImpl::updateSessionParams supplies this tag from the authenticated
+// CameraService client identity. Applications must not choose another package.
+inline status_t getClientNameTag(const CameraMetadata& deviceInfo, uint32_t* tag) {
+    sp<VendorTagDescriptor> descriptor = VendorTagDescriptor::getGlobalVendorTagDescriptor();
+    if (descriptor == nullptr || descriptor->getTagCount() == 0) {
+        sp<VendorTagDescriptorCache> cache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+        if (cache == nullptr) return NAME_NOT_FOUND;
+        status_t status = cache->getVendorTagDescriptor(deviceInfo.getVendorId(), &descriptor);
+        if (status != OK) return status;
+    }
+    status_t status = CameraMetadata::getTagFromName(
+            "com.xiaomi.sessionparams.clientName", descriptor.get(), tag);
+    if (status != OK) return status;
+    return descriptor->getTagType(*tag) == TYPE_BYTE ? OK : BAD_TYPE;
+}
+
+inline bool needsClientIdentity() {
+    return android::base::GetProperty("ro.product.device", "") == "warsaw";
+}
+
+inline status_t setClientIdentity(CameraMetadata* params, const CameraMetadata& deviceInfo,
+        const std::string& packageName) {
+    if (!needsClientIdentity()) return OK;
+    if (params == nullptr) return BAD_VALUE;
+    uint32_t tag;
+    status_t status = getClientNameTag(deviceInfo, &tag);
+    if (status != OK) return status;
+    const metadata_vendor_id_t vendorId = deviceInfo.getVendorId();
+    const metadata_vendor_id_t previousId = params->getVendorId();
+    if (previousId != CAMERA_METADATA_INVALID_VENDOR_ID && previousId != vendorId) {
+        return BAD_VALUE;
+    }
+    // endConfigure receives empty metadata when outputs are removed.
+    // Bind that buffer to the device provider before resolving vendor tags.
+    CameraMetadata authenticated(*params);
+    camera_metadata_t* buffer = authenticated.release();
+    if (buffer == nullptr) buffer = allocate_camera_metadata(1, packageName.size() + 1);
+    if (buffer == nullptr) return NO_MEMORY;
+    set_camera_metadata_vendor_id(buffer, vendorId);
+    authenticated.acquire(buffer);
+    status = authenticated.update(tag, String8(packageName.c_str()));
+    if (status == OK) params->swap(authenticated);
+    return status;
+}
+
+} // namespace android::warsawCameraSession
