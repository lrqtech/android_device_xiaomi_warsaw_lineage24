+struct BootControlDiskState {
+	std::unique_ptr<gpt_disk, decltype(&gpt_disk_free)> disk{nullptr, &gpt_disk_free};
+	std::string anchor;
+	std::vector<uint8_t> header, backup_header, entries, backup_entries;
+	bool attempted = false;
+
+	void RestoreBytes() {
+		memcpy(disk->hdr, header.data(), header.size());
+		memcpy(disk->hdr_bak, backup_header.data(), backup_header.size());
+		memcpy(disk->pentry_arr, entries.data(), entries.size());
+		memcpy(disk->pentry_arr_bak, backup_entries.data(), backup_entries.size());
