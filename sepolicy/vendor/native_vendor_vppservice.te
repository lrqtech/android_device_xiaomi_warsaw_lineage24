type vendor_vppservice, domain;

domain_auto_trans(init, vendor_vppservice_exec, vendor_vppservice)

typeattribute vendor_vppservice app_api_service;

typeattribute vendor_vppservice hal_graphics_allocator_client;

typeattribute vendor_vppservice halclientdomain;

typeattribute vendor_vppservice halserverdomain;

typeattribute vendor_vppservice service_manager_type;

typeattribute vendor_vppservice vendor_hal_capabilityconfigstore_qti_client;

typeattribute vendor_vppservice vendor_hal_vpp;

typeattribute vendor_vppservice vendor_hal_vpp_server;

binder_use(vendor_vppservice)

allow vendor_vppservice vendor_vppservice_exec:file { read getattr map execute open entrypoint };

allow vendor_vppservice servicemanager:binder { call transfer };

allow vendor_vppservice servicemanager:fd { use };

allow vendor_vppservice adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_vppservice adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice firmware_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_vppservice firmware_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice vendor_vpp_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_vppservice vendor_vpp_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_vppservice vendor_persist_vpp_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_vppservice vendor_persist_vpp_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice vendor_persist_vpp_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice mnt_vendor_file:dir { search };

allow vendor_vppservice video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_vppservice vendor_xdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice gpu_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_vppservice vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice vendor_membuf_dev:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice vendor_vm_cp_pixel_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_vppservice vendor_adsprpc_prop:file { read getattr map open };
