<?xml version="1.0" encoding="utf-8"?>
<policy version="1.0" path="qcom/policy.xml">
    <config name="thermalboost">
        <item name="cluster_num" value="4"/>
        <item name="cluster0_avaliable_freq_list" cluster="cpu0" value="/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies"/>
        <item name="cluster1_avaliable_freq_list" cluster="cpu2" value="/sys/devices/system/cpu/cpu2/cpufreq/scaling_available_frequencies"/>
        <item name="cluster2_avaliable_freq_list" cluster="cpu5" value="/sys/devices/system/cpu/cpu5/cpufreq/scaling_available_frequencies"/>
        <item name="cluster3_avaliable_freq_list" cluster="cpu7" value="/sys/devices/system/cpu/cpu7/cpufreq/scaling_available_frequencies"/>
        <item name="thermalboost_path" value="/sys/class/thermal/thermal_message/boost"/>
    </config>
</policy>
