type vendor_wfdvndservice, domain;

domain_auto_trans(init, vendor_wfdvndservice_exec, vendor_wfdvndservice)

typeattribute vendor_wfdvndservice hal_graphics_composer_client;

typeattribute vendor_wfdvndservice halclientdomain;

typeattribute vendor_wfdvndservice netdomain;

binder_use(vendor_wfdvndservice)

vndbinder_use(vendor_wfdvndservice)

allow vendor_wfdvndservice vendor_wfdhdcphalservice_qti:binder { transfer };

allow vendor_wfdvndservice vendor_wfdvndservice_exec:file { read getattr map execute open entrypoint };

allow vendor_wfdvndservice vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_wfdvndservice vndservicemanager:binder { call transfer };

allow vendor_wfdvndservice vendor_wfdhdcpvndservice_service:service_manager { add find };

allow vendor_wfdvndservice vendor_wfdhdcphalservice_qti:binder { call transfer };

allow vendor_wfdvndservice vendor_wfdhdcphalservice_qti:fd { use };

allow vendor_wfdvndservice mediacodec:fd { use };

allow vendor_wfdvndservice vendor_dmabuf_display_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_wfdvndservice vendor_qce_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_wfdvndservice vendor_qdisplay_service:service_manager { find };

allow vendor_wfdvndservice anr_data_file:file { append };

allow vendor_wfdvndservice dumpstate:fd { use };

allow vendor_wfdvndservice incidentd:fd { use };

allow vendor_wfdvndservice dumpstate:fifo_file { write append };

allow vendor_wfdvndservice incidentd:fifo_file { write append };

allow vendor_wfdvndservice system_server:fifo_file { write append };

allow vendor_wfdvndservice tombstoned:unix_stream_socket { connectto };

allow vendor_wfdvndservice tombstoned:fd { use };

allow vendor_wfdvndservice tombstoned_crash_socket:sock_file { write };

allow vendor_wfdvndservice tombstone_data_file:file { append };

allow vendor_wfdvndservice servicemanager:binder { call transfer };

allow vendor_wfdvndservice vendor_tsa_hdcpvndservice:service_manager { find };
