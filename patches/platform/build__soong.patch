+)
+
+func TestVbmetaConfiguredPayloadLayout(t *testing.T) {
+	result := android.GroupFixturePreparers(
+		android.PrepareForIntegrationTestWithAndroid,
+		android.PrepareForTestWithAndroidBuildComponents,
+		android.PrepareForTestWithAllowMissingDependencies,
+		prepareForTestWithFsgenBuildComponents,
+		prepareMockRamdiksNodeList,
+		filesystem.PrepareForTestWithFilesystemBuildComponents,
+		android.FixtureMergeMockFs(android.MockFS{
+			"external/avb/test/data/testkey_rsa4096.pem": nil,
+			"prebuilts/system_dlkm.img":                  nil,
+			"prebuilts/pvmfw.img":                        nil,
+			"build/soong/fsgen/Android.bp":               []byte(`soong_filesystem_creator { name: "foo" }`),
+		}),
+		android.FixtureModifyConfig(func(config android.Config) {
+			vars := &config.TestProductVariables.PartitionVarsForSoongMigrationOnlyDoNotUse
+			vars.BoardAvbEnable = true
+			vars.BuildingVbmetaImage = true
+			vars.BoardAvbVbmetaImageSize = "12288"
+			vars.BoardAvbVbmetaExtraImages = []string{"prebuilts/pvmfw.img"}
+			vars.ChainedVbmetaPartitions = map[string]android.ChainedAvbPartitionProps{
+				"system": {
+					Partitions:            []string{"system_dlkm"},
+					Key:                   "external/avb/test/data/testkey_rsa4096.pem",
+					Algorithm:             "SHA256_RSA4096",
+					RollbackIndex:         "0",
+					RollbackIndexLocation: "2",
+					ImageSize:             "4096",
+				},
+			}
+			vars.PartitionQualifiedVariables = map[string]android.PartitionQualifiedVariablesType{
+				"vbmeta_system": {BoardAvbKeyPath: "external/avb/test/data/testkey_rsa4096.pem"},
+				"system_dlkm": {
+					PrebuiltImage:       true,
+					PrebuiltImagePath:   "prebuilts/system_dlkm.img",
+					BoardFileSystemType: "erofs",
+				},
+			}
+		}),
+	).RunTest(t)
+	root := result.ModuleForTests(t, "test_product_generated_vbmeta_image", "android_common").Output("vbmeta.img")
+	chain := result.ModuleForTests(t, "test_product_generated_vbmeta_system_image", "android_common").Output("vbmeta_system.img")
+	android.AssertStringDoesContain(t, "root OTA payload size", root.RuleParams.Command, "truncate -s 12288 ")
+	android.AssertStringDoesContain(t, "chain OTA payload size", chain.RuleParams.Command, "truncate -s 4096 ")
+	android.AssertStringDoesContain(t, "verify external descriptor input", root.RuleParams.Command,
+		"verify_image --image prebuilts/pvmfw.img")
+	android.AssertStringDoesContain(t, "root includes raw firmware descriptor", root.RuleParams.Command,
+		"--include_descriptors_from_image prebuilts/pvmfw.img")
+	android.AssertStringDoesContain(t, "chain uses expected rollback index location", root.RuleParams.Command,
+		"--chain_partition vbmeta_system:2:")
+}
