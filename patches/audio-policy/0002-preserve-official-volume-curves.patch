+++ b/services/audiopolicy/engine/config/tests/engineconfig_vendor_volume_tests.cpp
@@ -0,0 +1,162 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <string>
+#include <android-base/file.h>
+#include <binder/Parcel.h>
+#include <gtest/gtest.h>
+#include "EngineConfig.h"
+#include "VolumeCurve.h"
+
+namespace android {
+namespace {
+using media::audio::common::AudioHalEngineConfig;
+using media::audio::common::AudioHalVolumeCurve;
+using Category = AudioHalVolumeCurve::DeviceCategory;
+
+// Captured from the unmodified official OS4 audio HAL getEngineConfig on Warsaw.
+// The Parcel contains configuration only, without user data or Binder objects.
+bool readOfficialConfig(AudioHalEngineConfig* config) {
+    std::string bytes;
+    if (!base::ReadFileToString(base::GetExecutableDirectory() +
+                               "/test_warsaw_volume_engine.parcel", &bytes)) return false;
+    Parcel parcel;
+    return parcel.setData(reinterpret_cast<const uint8_t*>(bytes.data()), bytes.size()) == OK
+            && config->readFromParcel(&parcel) == OK;
+}
+const std::array<const char*, 13> kCategoryNames = {
+    "DEVICE_CATEGORY_HEADSET", "DEVICE_CATEGORY_SPEAKER", "DEVICE_CATEGORY_EARPIECE",
+    "DEVICE_CATEGORY_EXT_MEDIA", "DEVICE_CATEGORY_HEARING_AID", "DEVICE_CATEGORY_HEADSET_CE",
+    "DEVICE_CATEGORY_HEADSET_SPATIALIZER_CE", "DEVICE_CATEGORY_A2DP", "DEVICE_CATEGORY_A2DP_CE",
+    "DEVICE_CATEGORY_A2DP_SPATIALIZER_CE", "DEVICE_CATEGORY_USB", "DEVICE_CATEGORY_USB_CE",
+    "DEVICE_CATEGORY_USB_SPATIALIZER_CE"};
+
+TEST(EngineConfigVendorVolumesTest, PreservesCompleteOfficialConfiguration) {
+    AudioHalEngineConfig aidl;
+    ASSERT_TRUE(readOfficialConfig(&aidl));
+    ASSERT_EQ(8u, aidl.productStrategies.size());
+    ASSERT_EQ(12u, aidl.volumeGroups.size());
+    auto result = engineConfig::convert(aidl);
+    ASSERT_NE(nullptr, result.parsedConfig);
+    EXPECT_EQ(0u, result.nbSkippedElement);
+    ASSERT_EQ(aidl.productStrategies.size(), result.parsedConfig->productStrategies.size());
+    ASSERT_EQ(aidl.volumeGroups.size(), result.parsedConfig->volumeGroups.size());
+    for (size_t i = 0; i < aidl.volumeGroups.size(); ++i) {
+        const auto& input = aidl.volumeGroups[i];
+        const auto& output = result.parsedConfig->volumeGroups[i];
+        EXPECT_EQ(input.name, output.name);
+        EXPECT_EQ(input.minIndex, output.indexMin);
+        EXPECT_EQ(input.maxIndex, output.indexMax);
+        ASSERT_EQ(input.volumeCurves.size(), output.volumeCurves.size());
+        for (size_t j = 0; j < input.volumeCurves.size(); ++j) {
+            const auto& inCurve = input.volumeCurves[j];
+            const auto& outCurve = output.volumeCurves[j];
+            const auto category = static_cast<uint8_t>(inCurve.deviceCategory);
+            ASSERT_LT(category, kCategoryNames.size());
+            EXPECT_EQ(kCategoryNames[category], outCurve.deviceCategory);
+            ASSERT_EQ(inCurve.curvePoints.size(), outCurve.curvePoints.size());
+            for (size_t k = 0; k < inCurve.curvePoints.size(); ++k) {
+                EXPECT_EQ(static_cast<uint8_t>(inCurve.curvePoints[k].index),
+                          outCurve.curvePoints[k].index);
+                EXPECT_EQ(inCurve.curvePoints[k].attenuationMb,
+                          outCurve.curvePoints[k].attenuationInMb);
+            }
+        }
+    }
+}
+
+TEST(EngineConfigVendorVolumesTest, MusicCurveMutesAndAttenuatesAcrossOfficialUiRange) {
+    AudioHalEngineConfig aidl;
+    ASSERT_TRUE(readOfficialConfig(&aidl));
+    auto result = engineConfig::convert(aidl);
+    ASSERT_NE(nullptr, result.parsedConfig);
+    const auto& groups = result.parsedConfig->volumeGroups;
+    const auto music = std::find_if(groups.begin(), groups.end(),
+                                   [](const auto& group) { return group.name == "music"; });
+    ASSERT_NE(groups.end(), music);
+    const auto speaker = std::find_if(music->volumeCurves.begin(), music->volumeCurves.end(),
+                                     [](const auto& curve) {
+        return curve.deviceCategory == "DEVICE_CATEGORY_SPEAKER";
+    });
+    ASSERT_NE(music->volumeCurves.end(), speaker);
+    sp<VolumeCurve> curve = sp<VolumeCurve>::make(DEVICE_CATEGORY_SPEAKER);
+    for (const auto& point : speaker->curvePoints) curve->add({point.index, point.attenuationInMb});
+    // Official ro.config.media_vol_steps=150 supersedes the HAL UI range of 15.
+    EXPECT_FLOAT_EQ(VOLUME_MIN_DB, curve->volIndexToDb(0, 0, 150));
+    EXPECT_NEAR(-73.0f, curve->volIndexToDb(1, 0, 150), 0.001f);
+    EXPECT_NEAR(-56.0f, curve->volIndexToDb(10, 0, 150), 0.001f);
+    EXPECT_NEAR(-0.3f, curve->volIndexToDb(150, 0, 150), 0.001f);
+    float previous = VOLUME_MIN_DB;
+    for (int index = 0; index <= 150; ++index) {
+        const float db = curve->volIndexToDb(index, 0, 150);
+        ASSERT_TRUE(std::isfinite(db));
+        EXPECT_GE(db, previous);
+        EXPECT_LE(db, 0.0f);
+        previous = db;
+    }
+}
+
+TEST(EngineConfigVendorVolumesTest, UnknownCategoryStillRejectsWholeConfiguration) {
+    AudioHalEngineConfig aidl;
+    ASSERT_TRUE(readOfficialConfig(&aidl));
+    aidl.volumeGroups[0].volumeCurves[0].deviceCategory = static_cast<Category>(127);
+    EXPECT_EQ(nullptr, engineConfig::convert(aidl).parsedConfig);
+}
+
+TEST(EngineConfigVendorVolumesTest, RejectsInvalidCurveIndicesWithoutChangingStandardSemantics) {
+    AudioHalEngineConfig official;
+    ASSERT_TRUE(readOfficialConfig(&official));
+    for (int index : {-1, 101}) {
+        auto aidl = official;
+        aidl.productStrategies.clear();
+        aidl.volumeGroups.resize(1);
+        aidl.volumeGroups[0].volumeCurves.resize(1);
+        aidl.volumeGroups[0].volumeCurves[0].curvePoints[0].index = static_cast<int8_t>(index);
+        EXPECT_EQ(nullptr, engineConfig::convert(aidl).parsedConfig) << index;
+    }
+    for (int index : {151, 255}) {
+        auto aidl = official;
+        aidl.volumeGroups[0].volumeCurves[0].curvePoints[0].index = static_cast<int8_t>(index);
+        EXPECT_EQ(nullptr, engineConfig::convert(aidl).parsedConfig) << index;
+    }
+    auto standard = official;
+    standard.productStrategies.clear();
+    standard.volumeGroups.resize(1);
+    standard.volumeGroups[0].volumeCurves.resize(1);
+    ASSERT_NE(nullptr, engineConfig::convert(standard).parsedConfig);
+}
+
+TEST(EngineConfigVendorVolumesTest, UsesDedicatedCurvesOnlyWhenTheVolumeGroupSuppliesThem) {
+    VolumeCurves standard(0, 15);
+    for (auto category : {DEVICE_CATEGORY_HEADSET, DEVICE_CATEGORY_SPEAKER,
+                          DEVICE_CATEGORY_EARPIECE, DEVICE_CATEGORY_EXT_MEDIA,
+                          DEVICE_CATEGORY_HEARING_AID}) {
+        standard.add(sp<VolumeCurve>::make(category));
+    }
+    for (auto device : {AUDIO_DEVICE_OUT_USB_HEADSET, AUDIO_DEVICE_OUT_BLUETOOTH_A2DP,
+                        AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_HEADPHONES, AUDIO_DEVICE_OUT_BLE_HEADSET,
+                        AUDIO_DEVICE_OUT_BLE_BROADCAST}) {
+        EXPECT_EQ(DEVICE_CATEGORY_HEADSET, standard.getDeviceCategory({device}));
+    }
+    VolumeCurves extended(0, 150);
+    extended.add(sp<VolumeCurve>::make(DEVICE_CATEGORY_USB));
+    extended.add(sp<VolumeCurve>::make(DEVICE_CATEGORY_A2DP));
+    EXPECT_EQ(DEVICE_CATEGORY_USB, extended.getDeviceCategory({AUDIO_DEVICE_OUT_USB_HEADSET}));
+    for (auto device : {AUDIO_DEVICE_OUT_BLUETOOTH_A2DP, AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_HEADPHONES,
+                        AUDIO_DEVICE_OUT_BLE_HEADSET, AUDIO_DEVICE_OUT_BLE_BROADCAST}) {
+        EXPECT_EQ(DEVICE_CATEGORY_A2DP, extended.getDeviceCategory({device}));
+    }
+    EXPECT_EQ(DEVICE_CATEGORY_EXT_MEDIA, extended.getDeviceCategory({AUDIO_DEVICE_OUT_USB_DEVICE}));
+    EXPECT_EQ(DEVICE_CATEGORY_SPEAKER,
+              extended.getDeviceCategory({AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_SPEAKER}));
+    EXPECT_EQ(DEVICE_CATEGORY_HEARING_AID,
+              extended.getDeviceCategory({AUDIO_DEVICE_OUT_HEARING_AID}));
+    EXPECT_EQ(DEVICE_CATEGORY_EARPIECE, extended.getDeviceCategory({AUDIO_DEVICE_OUT_EARPIECE}));
+}
+} // namespace
+} // namespace android
