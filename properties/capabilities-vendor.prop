ro.hardware.egl=adreno
ro.hardware.vulkan=adreno

# Official Goodix FOD loads the Qualcomm perf client through this property.
ro.vendor.extension_library=libqti-perfd-client.so

# The stock Codec2 stores use AIDL and the AIDL GraphicBufferSource bridge.
media.c2.hal.selection=aidl
debug.stagefright.c2inputsurface=-1
# Match the stock libmedia selection for the sun platform on this SKU.
ro.media.xml_variant.profiles=_sun

ro.vendor.display.adaptive_hdr.enable=true
ro.vendor.display.adaptive_hdr2.enable=1
ro.vendor.display.bl_lut_calib.enable=true
ro.vendor.display.dobly_dpu.enable=true
ro.vendor.display.dolbyvision.support=true
ro.vendor.display.dualDPU.support=nt72336
ro.vendor.display.dualDPU_EMVSize=1280,2772
ro.vendor.display.fod_monitor_default_fps=120
ro.vendor.display.frame_capture_manager.enable=true
ro.vendor.display.framemaster.enable=true
ro.vendor.display.hwc_set_backlight=1
ro.vendor.display.idle_default_fps=60
ro.vendor.display.mi_calib.enable=true
ro.vendor.display.type=oled
ro.vendor.display.vivid_calibration.enable=1
ro.vendor.mi_sf.aod_mode_ddic_refresh_rate=30
ro.vendor.mi_sf.support_aidl_display_config=true

ro.vendor.audio.aiasst.support=true
ro.vendor.audio.btsamplerate.adaptive=true
ro.vendor.audio.dolby.dax.game.enable=true
ro.vendor.audio.dolby.dax.support=true
ro.vendor.audio.dolby.dax.version=DAX3_3.12.0.8_r1
ro.vendor.audio.dolby.surround.enable=true
ro.vendor.audio.dolby.vision.support=true
ro.vendor.audio.dualadc.support=true
ro.vendor.audio.extendtonecallendedlength=true
ro.vendor.audio.feature.fade=true
ro.vendor.audio.feature.spatial=5
ro.vendor.audio.gain.support=true
ro.vendor.audio.game.mode=true
ro.vendor.audio.misound.bluetooth.enable=true
ro.vendor.audio.multi.channel=true
ro.vendor.audio.multichannel.5point1=false
ro.vendor.audio.multichannel.5point1.headset=true
ro.vendor.audio.multiroute=true
ro.vendor.audio.remotesubmix.support_multichannel=true
ro.vendor.audio.sfx.earadj=true
ro.vendor.audio.sfx.scenario=true
ro.vendor.audio.sos=true
ro.vendor.audio.soundfx.type=mi
ro.vendor.audio.soundfx.usb=true
ro.vendor.audio.spk.stereo=true
ro.vendor.audio.support.sound.id=true
ro.vendor.audio.surround.headphone.only=true
ro.vendor.audio.videobox.switch=true
ro.vendor.audio.voice.change.support=true
ro.vendor.audio.voice.change.version=2
ro.vendor.audio.voice.change.youme.support=true
vendor.audio.feature.a2dp_offload.enable=true
vendor.audio.feature.audiozoom.enable=false
vendor.audio.feature.battery_listener.enable=true
vendor.audio.feature.dmabuf.cma.memory.enable=false
vendor.audio.feature.hfp.enable=true
vendor.audio.feature.kpi_optimize.enable=true
vendor.audio.hal.aidl.enabled=true
