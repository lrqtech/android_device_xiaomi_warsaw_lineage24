type vendor_mbnota, domain;

domain_auto_trans(init, vendor_mbnota_exec, vendor_mbnota)

allow vendor_mbnota vendor_mbnota_exec:file { read getattr map execute open entrypoint };

allow vendor_mbnota vendor_firmware_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_mbnota vendor_firmware_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_mbnota vendor_radio_prop:file { read getattr map open };

allow vendor_mbnota property_socket:sock_file { write };

allow vendor_mbnota init:unix_stream_socket { connectto };

allow vendor_mbnota vendor_radio_prop:property_service { set };
