type hal_seaaudio_default, domain;

domain_auto_trans(init, hal_seaaudio_default_exec, hal_seaaudio_default)

typeattribute hal_seaaudio_default hal_seaaudio;

typeattribute hal_seaaudio_default hal_seaaudio_server;

typeattribute hal_seaaudio_default halserverdomain;

binder_use(hal_seaaudio_default)

allow hal_seaaudio_default hal_seaaudio_default_exec:file { read getattr map execute open entrypoint };

allow hal_seaaudio_default servicemanager:binder { call transfer };

allow hal_seaaudio_default hal_seaaudio_service:service_manager { add find };

allow hal_seaaudio_default hal_seaaudio:binder { call };

allow hal_seaaudio_default hal_system_suspend_service:service_manager { find };

allow hal_seaaudio_default dmabuf_system_heap_device:chr_file { ioctl read write getattr map open };

allow hal_seaaudio_default vendor_xdsp_device:chr_file { ioctl read open };

allow hal_seaaudio_default vendor_qdsp_device:chr_file { ioctl read open };
