typeattribute hal_vibrator_default hal_audio_client;

typeattribute hal_vibrator_default hal_vibrator;

typeattribute hal_vibrator_default hal_vibrator_server;

typeattribute hal_vibrator_default halclientdomain;

typeattribute hal_vibrator_default halserverdomain;

allow hal_vibrator_default hal_vibrator_default_exec:file { read getattr map execute open entrypoint };

allow hal_vibrator_default sysfs_leds:dir { ioctl read getattr lock open watch watch_reads search };

allow hal_vibrator_default sysfs_leds:file { ioctl read getattr lock map open watch watch_reads };

allow hal_vibrator_default sysfs_leds:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow hal_vibrator_default sysfs_leds:file { ioctl read write getattr lock append map open watch watch_reads };

allow hal_vibrator_default vendor_sysfs_haptics:dir { ioctl read getattr lock open watch watch_reads search };

allow hal_vibrator_default vendor_sysfs_haptics:file { ioctl read getattr lock map open watch watch_reads };

allow hal_vibrator_default vendor_sysfs_haptics:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow hal_vibrator_default vendor_sysfs_haptics:file { write lock append map open };

allow hal_vibrator_default vendor_persist_haptics_file:dir { ioctl read getattr lock open watch watch_reads search };

allow hal_vibrator_default vendor_persist_haptics_file:file { ioctl read getattr lock map open watch watch_reads };

allow hal_vibrator_default vendor_persist_haptics_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

# get_effect_stream() initializes only the persistent nv_flag using fopen("w+").
# Calibration files remain read-only. A named transition gives a newly created
# flag the same label as file_contexts without a restorecon race.
type vendor_persist_haptics_nv_flag_file, file_type;
type_transition hal_vibrator_default vendor_persist_haptics_file:file vendor_persist_haptics_nv_flag_file "nv_flag";
allow hal_vibrator_default vendor_persist_haptics_file:dir { write add_name };
allow hal_vibrator_default vendor_persist_haptics_nv_flag_file:file { create open read write getattr };


allow hal_vibrator_default mnt_vendor_file:dir { search };

allow hal_vibrator_default property_socket:sock_file { write };

allow hal_vibrator_default init:unix_stream_socket { connectto };

allow hal_vibrator_default vendor_audio_prop:property_service { set };

allow hal_vibrator_default vendor_audio_prop:file { read getattr map open };

# The retained HAL selects /sys/class/qcom-haptics from haptics-odm.prop.
# Its class attributes use vendor_sysfs_haptics; legacy LED and sound-card
# paths retain their dedicated labels. Do not write unrelated sysfs files.
allow hal_vibrator_default sysfs:dir { read open };

allow hal_vibrator_default aac_richtap_dev_device:chr_file { ioctl read write getattr map open };

allow hal_vibrator_default fwk_sensor_hwservice:hwservice_manager { find };

allow hal_vibrator_default proc_asound:dir { search };

allow hal_vibrator_default vendor_sysfs_sndcard:file { ioctl read write getattr lock append map open watch watch_reads };

allow hal_vibrator_default audio_device:dir { search };

allow hal_vibrator_default hal_audio_hwservice:hwservice_manager { find };
