+class PrebuiltDlkmSigningTest(test_utils.ReleaseToolsTestCase):
+  PARTITIONS = (("system_dlkm", AddSystemDlkm),
+                ("vendor_dlkm", AddVendorDlkm),
+                ("odm_dlkm", AddOdmDlkm))
+
+  def setUp(self):
+    OPTIONS.info_dict = {}
+
+  def _prepare(self, partition):
+    OPTIONS.input_tmp = common.MakeTempDir()
+    os.mkdir(os.path.join(OPTIONS.input_tmp, "PREBUILT_IMAGES"))
+    os.mkdir(os.path.join(OPTIONS.input_tmp, "IMAGES"))
+    payload = b"OEM filesystem, module indexes and signatures\x00" + partition.encode()
+    with open(os.path.join(OPTIONS.input_tmp, "PREBUILT_IMAGES",
+                           partition + ".img"), "wb") as stream:
+      stream.write(payload)
+    return payload
+
+  def test_survives_signing_image_removal_dir_and_zip(self):
+    # Only PREBUILT_IMAGES remains after the signer discards generated IMAGES.
+    for partition, add in self.PARTITIONS:
+      for zip_mode in (False, True):
+        with self.subTest(partition=partition, zip_mode=zip_mode):
+          payload = self._prepare(partition)
+          self.assertTrue(HasPartition(partition))
+          if zip_mode:
+            path = common.MakeTempFile(suffix=".zip")
+            with zipfile.ZipFile(path, "w") as output:
+              result = add(output)
+            with zipfile.ZipFile(path) as output:
+              self.assertEqual(payload, output.read("IMAGES/" + partition + ".img"))
+          else:
+            result = add(None)
+          with open(result, "rb") as image:
+            self.assertEqual(payload, image.read())
+          CheckAbOtaImages(None, [partition])
+
+  def test_missing_dlkm_is_still_fatal(self):
+    for partition, _ in self.PARTITIONS:
+      with self.subTest(partition=partition):
+        OPTIONS.input_tmp = common.MakeTempDir()
+        os.mkdir(os.path.join(OPTIONS.input_tmp, "IMAGES"))
+        self.assertFalse(HasPartition(partition))
+        with self.assertRaises(AssertionError):
+          CheckAbOtaImages(None, [partition])
+
+  def test_existing_image_has_priority(self):
+    for partition, add in self.PARTITIONS:
+      with self.subTest(partition=partition):
+        self._prepare(partition)
+        path = os.path.join(OPTIONS.input_tmp, "IMAGES", partition + ".img")
+        with open(path, "wb") as image:
+          image.write(b"already processed image")
+        self.assertEqual(path, add(None))
+        with open(path, "rb") as image:
+          self.assertEqual(b"already processed image", image.read())
+
+  def test_source_built_dlkm_is_still_detected(self):
