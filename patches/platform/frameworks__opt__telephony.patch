+package com.android.internal.telephony;
+
+import android.content.Context;
+import android.text.TextUtils;
+import android.util.Xml;
+
+import com.android.telephony.Rlog;
+
+import org.xmlpull.v1.XmlPullParser;
+import org.xmlpull.v1.XmlPullParserException;
+
+import java.io.FileReader;
+import java.io.IOException;
+import java.io.Reader;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Reads the selected device's stock SPN table without importing an OEM framework service. */
+public final class MainlandCarrierNames {
+    private static final String TAG = "MainlandCarrierNames";
+    private static volatile List<Rule> sRules;
+
+    private MainlandCarrierNames() {}
+
+    public static String localize(Context context, String numeric, String imsi,
+            String original, boolean preserveUnknownSpn) {
+        if (numeric == null || !numeric.startsWith("460")
+                || !context.getResources().getBoolean(
+                        com.android.internal.R.bool.config_useStockMainlandCarrierNames)) {
+            return original;
+        }
+        return resolve(rules(), numeric, imsi, original,
+                context.getResources().getConfiguration().getLocales().get(0), preserveUnknownSpn);
+    }
+
+    private static List<Rule> rules() {
+        List<Rule> rules = sRules;
+        if (rules != null) return rules;
+        synchronized (MainlandCarrierNames.class) {
+            if (sRules == null) {
+                try (Reader reader = new FileReader("/product/etc/miui-spn-conf.xml")) {
+                    sRules = parse(reader);
+                } catch (IOException | XmlPullParserException e) {
+                    // A missing or malformed table must never prevent radio initialization.
+                    Rlog.e(TAG, "Cannot load device carrier-name table", e);
+                    sRules = Collections.emptyList();
+                }
+            }
+            return sRules;
+        }
+    }
+
+    static List<Rule> parse(Reader reader) throws IOException, XmlPullParserException {
+        XmlPullParser parser = Xml.newPullParser();
+        parser.setInput(reader);
+        List<Rule> result = new ArrayList<>();
+        for (int event = parser.next(); event != XmlPullParser.END_DOCUMENT;
+                event = parser.next()) {
+            if (event != XmlPullParser.START_TAG || !"spn".equals(parser.getName())) continue;
+            Map<String, String> values = new HashMap<>();
+            for (int i = 0; i < parser.getAttributeCount(); i++) {
+                values.put(parser.getAttributeName(i), parser.getAttributeValue(i));
+            }
+            String numeric = values.get("numeric");
+            if (numeric != null && numeric.contains("460")) result.add(new Rule(values));
+        }
+        return Collections.unmodifiableList(result);
+    }
+
+    static String resolve(List<Rule> rules, String numeric, String imsi, String original,
+            Locale locale, boolean preserveUnknownSpn) {
+        Rule base = null;
+        for (Rule rule : rules) {
+            if (!rule.hasNumeric(numeric)) continue;
+            String condition = rule.values.get("condition");
+            if (condition == null) {
+                base = rule;
+            } else if (condition.startsWith("imsi:")
+                    ? matchesImsi(condition.substring(5), imsi)
+                    : condition.equals("alpha") ? rule.hasAlpha(original)
+                    : condition.startsWith("alpha:")
+                            && sameAlpha(condition.substring(6), original)) {
+                return rule.localized(locale);
+            }
+        }
+        if (base == null) return original;
+        if (preserveUnknownSpn && !TextUtils.isEmpty(original) && !original.equals(numeric)
+                && !base.hasAlpha(original) && !isNetworkAlias(numeric, original)) {
+            return original; // Keep unlisted MVNO branding and custom SIM-provided names.
+        }
+        return base.localized(locale);
+    }
+
+    static boolean matchesImsi(String pattern, String imsi) {
+        if (imsi == null || pattern.length() != imsi.length()) return false;
+        for (int i = 0; i < pattern.length(); i++) {
+            char c = pattern.charAt(i);
+            if (c != 'x' && c != 'X' && c != imsi.charAt(i)) return false;
+        }
+        return true;
+    }
+
+    private static boolean isNetworkAlias(String numeric, String alpha) {
+        return (numeric.equals("46003") || numeric.equals("46005") || numeric.equals("46011"))
+                && sameAlpha(alpha, "CHN-CT");
+    }
+
+    private static boolean sameAlpha(String a, String b) {
+        return a != null && b != null && normalize(a).equals(normalize(b));
+    }
+
+    private static String normalize(String s) {
+        return s.replaceAll("[\\s_\\-]", "").toLowerCase(Locale.ROOT);
+    }
+
+    static final class Rule {
+        final Map<String, String> values;
+        Rule(Map<String, String> values) { this.values = values; }
+
+        boolean hasNumeric(String numeric) {
+            if (numeric == null || !numeric.startsWith("460")) return false;
+            for (String candidate : values.get("numeric").split(",")) {
+                if (candidate.trim().equals(numeric)) return true;
+            }
+            return false;
+        }
+
+        boolean hasAlpha(String alpha) {
+            if (TextUtils.isEmpty(alpha)) return false;
+            for (Map.Entry<String, String> entry : values.entrySet()) {
+                if ((entry.getKey().startsWith("alpha") || entry.getKey().startsWith("short"))
+                        && sameAlpha(entry.getValue(), alpha)) return true;
+            }
+            return false;
+        }
+
+        String localized(Locale locale) {
+            String value = values.get("alpha-" + locale.toString());
+            if (value == null && "zh".equals(locale.getLanguage())
+                    && ("Hant".equals(locale.getScript()) || "TW".equals(locale.getCountry())
+                            || "HK".equals(locale.getCountry()) || "MO".equals(locale.getCountry()))) {
+                value = values.get("alpha-zh_TW");
+            }
+            if (value == null) value = values.get("alpha-" + locale.getLanguage());
+            return value == null ? values.get("alpha") : value;
+        }
+    }
+}
