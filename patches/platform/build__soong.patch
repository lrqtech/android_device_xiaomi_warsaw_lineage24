diff --git a/cc/stub_library_test.go b/cc/stub_library_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ead4a227b1af55d4e5eceb42555c9b1ca287b880
--- /dev/null
+++ b/cc/stub_library_test.go
@@ -0,0 +1,46 @@
+// Copyright (C) 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+package cc
+
+import (
+	"android/soong/android"
+	"testing"
+)
+
+// LLNDK vendor variants describe interfaces supplied by the system. A private
+// vendor implementation with the same installed name must not turn that
+// interface into an additional vendor-provided library in linker.config.pb.
+func TestLlndkNotProvidedByVendor(t *testing.T) {
+	t.Parallel()
+	result := android.GroupFixturePreparers(
+		prepareForCcTest,
+		android.FixtureRegisterWithContext(func(ctx android.RegistrationContext) {
+			ctx.RegisterParallelSingletonType("stublibraries", stubLibrariesSingleton)
+		}),
+	).RunTestWithBp(t, `
+        cc_library_shared {
+            name: "libtest_llndk",
+            llndk: { symbol_file: "libtest_llndk.map.txt" },
+        }
+        cc_library_shared {
+            name: "libtest_llndk_vendor_private",
+            stem: "libtest_llndk",
+            vendor: true,
+        }
+        cc_library_shared {
+            name: "libtest_vendor_api",
+            vendor: true,
+            stubs: { symbol_file: "libtest_vendor_api.map.txt", versions: ["1"] },
+            split_all_variants: true,
+        }
+        cc_library_shared {
+            name: "libtest_vendor_client",
+            vendor: true,
+            shared_libs: ["libtest_llndk", "libtest_llndk_vendor_private", "libtest_vendor_api"],
+        }
+    `)
+	singleton := result.SingletonForTests(t, "stublibraries").Singleton().(*stubLibraries)
+	android.AssertStringListContains(t, "LLNDK stays in system interface list", singleton.stubLibraries, "libtest_llndk.so")
+	android.AssertStringListDoesNotContain(t, "vendor consumes LLNDK, it does not provide it", singleton.vendorStubLibraries, "libtest_llndk.so")
+	android.AssertStringListContains(t, "actual vendor API stays exported", singleton.vendorStubLibraries, "libtest_vendor_api.so")
+}
