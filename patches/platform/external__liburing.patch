+/* Optional checked initializer for the default (flags=0) layout only.
+ * Legacy initialization interfaces retain their existing behavior.
+ * Return the primary -errno on failure. Each attempted cleanup records its
+ * raw 0/-errno result below; no cleanup error replaces the primary error.
+ * Failed mappings remain in ring for ownership tracking. A close is attempted
+ * exactly once, its FD is recorded here, and ring_fd/enter_ring_fd become -1.
+ * Never submit, queue_exit, retry close, or reuse a failed ring. If any cleanup
+ * result is negative, retain the ring and this receipt until process teardown.
+ * SQEs are mapped last: there is no failure path after a successful SQE map.
+ */
+enum io_uring_init_cleanup_attempt {
+	IO_URING_INIT_CLEANUP_SQ = 1U << 0,
+	IO_URING_INIT_CLEANUP_CQ = 1U << 1,
+	IO_URING_INIT_CLEANUP_CLOSE = 1U << 2,
+};
+
+struct io_uring_init_cleanup {
+	unsigned attempted;
+	int sq_ring_result;
+	int cq_ring_result;
+	int close_result;
+	int close_fd;
+};
+
+int io_uring_queue_init_checked(unsigned entries, struct io_uring *ring,
+			       struct io_uring_init_cleanup *cleanup) LIBURING_NOEXCEPT;
+
 int io_uring_queue_init(unsigned entries, struct io_uring *ring,
 			unsigned flags) LIBURING_NOEXCEPT;
 int io_uring_queue_mmap(int fd, struct io_uring_params *p,
