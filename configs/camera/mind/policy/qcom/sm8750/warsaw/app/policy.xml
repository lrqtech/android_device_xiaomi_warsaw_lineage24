<?xml version="1.0" encoding="utf-8"?>
<policy version="1.0" path="qcom/sm8750/warsaw/app/policy.xml">
    <app prio="100" name="__DEFAULT__" >
        <profile name="normal">
            <activity name="__DEFAULT__">
                <action name ="skinTempMonitorSetting" enable="1" interval="6000" />

                <action name ="samplerPerfLogSetting" enable="1" interval="60000" />

                <action name ="batteryTempMonitorSetting" enable="1" interval="6000" />

                <action name="cpuTemperatureSetting" enable="1" interval="6000" trace="1"/>

                <case screenState="0">
                    <action name ="skinTempMonitorSetting" enable="1" interval="60000" />

                    <action name ="samplerPerfLogSetting" enable="1" interval="600000" />

                    <action name ="batteryTempMonitorSetting" enable="1" interval="60000" />

                    <action name="cpuTemperatureSetting" enable="1" interval="60000" trace="1"/>
                </case>
                <case cameraUsing="true">

                    <action name="cpuTemperatureSetting" enable="1" interval="1000" trace="1"/>
                    <action name ="skinTempMonitorSetting" enable="1" interval="3000" trace="1" />

                    <action name ="samplerPerfLogSetting" enable="1" interval="10000" />

                    <action name ="batteryTempMonitorSetting" enable="1" interval="1000" trace="1" />

                    <action name="psiCpuSetting" enable="1" interval="1000" trace="1"/>

                    <action name="cameraFpsSetting" delta="2"  interval="1000" />
                    <case skinTemp="45000:1000000">
                        <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                    </case>
                    <case skinTempDesc="45000:44000">
                        <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                    </case>
                    <case psiCpuSomeAvg10="5000:1000000">
                        <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                    </case>
                    <case psiCpuSomeAvg10Desc="5000:4500">
                        <action name ="algoBypass_GESTURE_EFFECTS" value="2" />
                    </case>
                </case>
            </activity>
        </profile>
    </app>

    <define name="thirdPartAppTempPolicy">
        <activity name="__DEFAULT__">
            <case cameraUsing="true">

                <action name ="cameraPreviewFps" value="-1:-1" />

                <action name ="skinTempMonitorSetting" enable="1" interval="3000" />


                <case batteryLevel="0:6">
                    <action name ="cameraPreviewFps" value="30:30" />
                </case>



                <case skinTemp="41000:1000000">
                    <action name ="cameraPreviewFps" value="24:24" />
                </case>

                <case skinTemp="44000:1000000">
                    <action name ="cameraPreviewFps" value="20:20" />
                </case>

                <case skinTemp="46000:1000000">
                    <action name ="cameraPreviewFps" value="15:15" />
                </case>



                <case skinTempDesc="46000:44000">
                    <action name ="cameraPreviewFps" value="15:15" />
                </case>

                <case skinTempDesc="44000:42000">
                    <action name ="cameraPreviewFps" value="20:20" />
                </case>

                <case skinTempDesc="41000:39000">
                    <action name ="cameraPreviewFps" value="24:24" />
                </case>
            </case>
        </activity>
    </define>

    <define name="thirdPartAppTempPolicyNoActivity">
        <case cameraUsing="true">

            <action name ="cameraPreviewFps" value="-1:-1" />

            <action name ="skinTempMonitorSetting" enable="1" interval="3000" />


            <case batteryLevel="0:6">
                <action name ="cameraPreviewFps" value="30:30" />
            </case>



            <case skinTemp="41000:1000000">
                <action name ="cameraPreviewFps" value="24:24" />
            </case>

            <case skinTemp="44000:1000000">
                <action name ="cameraPreviewFps" value="20:20" />
            </case>

            <case skinTemp="46000:1000000">
                <action name ="cameraPreviewFps" value="15:15" />
            </case>



            <case skinTempDesc="46000:44000">
                <action name ="cameraPreviewFps" value="15:15" />
            </case>

            <case skinTempDesc="44000:42000">
                <action name ="cameraPreviewFps" value="20:20" />
            </case>

            <case skinTempDesc="41000:39000">
                <action name ="cameraPreviewFps" value="24:24" />
            </case>
        </case>
    </define>

    <define name="miuiCameraRecordVideo">

        <action name ="motionStateMonitorSetting" enable="1" />
        <case motion="false" >
            <action name ="tripod" value="1" ignoreByProperty="persist.vendor.camera.thermal.debug.tripodMode:0" />
        </case>
        <case motion="true" >
            <action name ="tripod" value="0" />
        </case>


        <case videoFps="60">

            <case exposureTime="0:20">
                <case cameraId="0" rearPreviewFps="40:160" >
                    <case motion="false" >

                        <action name="dropFrameCoeff" value="2" ignoreByProperty="persist.vendor.camera.disableSkipPreviewFrame:1|persist.vendor.camera.thermal.debug.tripodMode:0" />
                    </case>

                    <case skinTemp="42000:1000000" >

                        <action name="dropFrameCoeff" value="2" ignoreByProperty="persist.vendor.camera.disableSkipPreviewFrame:1" />
                    </case>

                    <case skinTempDesc="42000:41000" >

                        <action name="dropFrameCoeff" value="2" ignoreByProperty="persist.vendor.camera.disableSkipPreviewFrame:1" />
                    </case>
                </case>
                <case cameraId="1" frontPreviewFps="40:160" >
                    <case motion="false" >

                        <action name="dropFrameCoeff" value="2" ignoreByProperty="persist.vendor.camera.disableSkipPreviewFrame:1|persist.vendor.camera.thermal.debug.tripodMode:0" />
                    </case>

                    <case skinTemp="42000:1000000" >

                        <action name="dropFrameCoeff" value="2" ignoreByProperty="persist.vendor.camera.disableSkipPreviewFrame:1" />
                    </case>

                    <case skinTempDesc="42000:41000" >

                        <action name="dropFrameCoeff" value="2" ignoreByProperty="persist.vendor.camera.disableSkipPreviewFrame:1" />
                    </case>
                </case>
            </case>
        </case>


        <case videoFps="60">
            <action name="viptask"  value="60" />
        </case>

        <case rearVideoResolution="3840x1080:-1" recordState="start"  videoFps="60" >

        </case>
        <case rearVideoResolution="7680x4310:-1" recordState="start"  videoFps="24" >

        </case>

        <case skinTemp="37500:1000000">

        </case>
    </define>

    <define name="miuiCameraCapture">


        <case batteryLevel="0:3">
            <action name ="algoBypass_HDR" value="2" />
        </case>

        <case batteryLevel="0:6">
            <case batteryTemp="-1000000:-4900">
                <action name ="algoBypass_HDR" value="2" />
            </case>
            <case batteryTempAsc="-5000:0">
                <action name ="algoBypass_HDR" value="2" />
            </case>
        </case>


        <case batteryLevel="0:6">
            <action name ="algoBypass_SDSR" value="2" />
        </case>

        <case batteryLevel="0:11">
            <case batteryTemp="-1000000:-4900">
                <action name ="algoBypass_SDSR" value="2" />
            </case>
            <case batteryTempAsc="-5000:0">
                <action name ="algoBypass_SDSR" value="2" />
            </case>
        </case>


        <case batteryLevel="0:6">
            <action name ="algoBypass_SE" value="2" />
            <action name ="algoBypass_SN" value="2" />
            <action name ="algoBypass_ELL" value="2" />
        </case>
        <case psiCpuSomeAvg10="6500:1000000">
            <action name ="algoBypass_SE" value="2" />
            <action name ="algoBypass_SN" value="2" />
            <action name ="algoBypass_ELL" value="2" />
        </case>
        <case psiCpuSomeAvg10Desc="6500:6000">
            <action name ="algoBypass_SE" value="2" />
            <action name ="algoBypass_SN" value="2" />
            <action name ="algoBypass_ELL" value="2" />
        </case>


        <case batteryLevel="0:6">
            <action name ="algoBypass_FUSION" value="2" />
        </case>

        <case skinTemp="45000:1000000" camModeSnapshotCnt="3:-1">
            <action name ="algoBypass_FUSION" value="2" />
        </case>

        <case skinTempDesc="45000:43000" camModeSnapshotCnt="3:-1">
            <action name ="algoBypass_FUSION" value="2" />
        </case>

        <case batteryLevel="0:11">
            <case batteryTemp="-1000000:-4900">
                <action name ="algoBypass_FUSION" value="2" />
            </case>
            <case batteryTempAsc="-5000:0">
                <action name ="algoBypass_FUSION" value="2" />
            </case>
        </case>
        <case bclLevel="0:1">
            <action name ="algoBypass_FUSION" value="2" />
        </case>



        <case skinTemp="43000:1000000">
            <action name ="algoBypass_PREVIEW_HDR_DISABLE" value="2" />
        </case>

        <case skinTempDesc="43000:41000">
            <action name ="algoBypass_PREVIEW_HDR_DISABLE" value="2" />
        </case>


        <case skinTemp="47000:1000000" camModeSnapshotCnt="3:-1">
            <action name ="algoBypass_HDR" value="2" />
            <action name ="algoBypass_SR" value="2" />
            <action name ="algoBypass_SE" value="2" />
            <action name ="algoBypass_SN" value="2" />
            <action name ="algoBypass_ELL" value="2" />
            <action name ="algoBypass_EDOF" value="2" />
            <action name ="algoBypass_CAPTURE_DEPURPLE" value="2" />
        </case>

        <case skinTempDesc="47000:46000" camModeSnapshotCnt="3:-1">
            <action name ="algoBypass_HDR" value="2" />
            <action name ="algoBypass_SR" value="2" />
            <action name ="algoBypass_SE" value="2" />
            <action name ="algoBypass_SN" value="2" />
            <action name ="algoBypass_ELL" value="2" />
            <action name ="algoBypass_EDOF" value="2" />
            <action name ="algoBypass_CAPTURE_DEPURPLE" value="2" />
        </case>


        <case skinTemp="46000:1000000" camModeSnapshotCnt="3:-1">
            <action name ="algoBypass_SDSR" value="2" />
        </case>

        <case skinTempDesc="46000:45000" camModeSnapshotCnt="3:-1">
            <action name ="algoBypass_SDSR" value="2" />
        </case>

        <case livePhoto="true">
            <case skinTemp="35000:1000000">
                <action name ="algoBypass_PREVIEW_HDR_DISABLE" value="2" />
            </case>
            <case skinTempDesc="35000:32000">
                <action name ="algoBypass_PREVIEW_HDR_DISABLE" value="2" />
            </case>

            <case skinTemp="38000:1000000" camModeSnapshotCnt="3:-1">
                <action name ="algoBypass_HDR" value="2" />
            </case>
            <case skinTempDesc="38000:36000" camModeSnapshotCnt="3:-1">
                <action name ="algoBypass_HDR" value="2" />
            </case>

            <case skinTemp="46000:1000000">
                <action name ="algoBypass_LIVEPHOTO_EIS" value="2" />
                <action name ="algoBypass_LIVP_HAND_RAISE_DETECT" value="2" />
            </case>
            <case skinTempDesc="46000:45000">
                <action name ="algoBypass_LIVEPHOTO_EIS" value="2" />
                <action name ="algoBypass_LIVP_HAND_RAISE_DETECT" value="2" />
            </case>
            <case psiCpuSomeAvg10="6500:1000000">
                <action name ="algoBypass_LIVEPHOTO_EIS" value="2" />
                <action name ="algoBypass_LIVP_HAND_RAISE_DETECT" value="2" />
            </case>
            <case psiCpuSomeAvg10Desc="6500:6000">
                <action name ="algoBypass_LIVEPHOTO_EIS" value="2" />
                <action name ="algoBypass_LIVP_HAND_RAISE_DETECT" value="2" />
            </case>

        </case>

        <case  batteryTemp="43000:1000000" rearSnapshotHistory="capture:15000:10:100">
            <action name ="algoBypass_SR" value="2" />
            <action name ="algoBypass_SDSR" value="2" />
            <action name ="algoBypass_HDSR" value="2" />
            <action name ="algoBypass_HDR" value="2" />
            <action name ="algoBypass_SN" value="2" />
            <action name ="algoBypass_SE" value="2" />
            <action name ="algoBypass_ELL" value="2" />
        </case>
    </define>

    <define name="miuiCameraFlash">
        <case cameraId="0">

            <case batteryLevel="0:6">
                <action name ="algoBypass_FLASH" value="2" />
            </case>



            <case batteryLevel="0:16">

                <case batteryTemp="-1000000:-4900">
                    <action name ="algoBypass_FLASH" value="2" />
                </case>
                <case batteryTempAsc="-5000:0">
                    <action name ="algoBypass_FLASH" value="2" />
                </case>
            </case>
        </case>
    </define>
</policy>
