allow hal_miface_default sysfs_tp_fodstatus:chr_file { ioctl read getattr lock map open watch watch_reads };

allow hal_miface_default sysfs_tp_fodstatus:file { ioctl read getattr lock map open watch watch_reads };

allow hal_miface_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow hal_miface_default camera_config_prop:file { read getattr map open };

allow hal_miface_default cameraserver:binder { call transfer };

allow hal_miface_default cameraserver:fd { use };

