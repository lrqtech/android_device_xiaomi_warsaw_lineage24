+            split_all_variants: true,
+            srcs: ["core/libbar.so"],
+            strip: { none: true },
+            target: {
+                vendor: { srcs: ["vendor/libbar.so"] },
+            },
+        }
+    `, map[string][]byte{"core/libbar.so": nil, "vendor/libbar.so": nil})
+	core := ctx.ModuleForTests(t, "bar", "android_arm64_armv8-a_shared").Rule("CpExecutable")
+	vendor := ctx.ModuleForTests(t, "bar", vendorVariant).Rule("CpExecutable")
+	android.AssertStringEquals(t, "core input", "core/libbar.so", core.Input.String())
+	android.AssertStringEquals(t, "vendor input", "vendor/libbar.so", vendor.Input.String())
+}
