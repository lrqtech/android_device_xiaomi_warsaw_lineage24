diff --git a/system/audio_hal_interface/aidl/a2dp/a2dp_provider_info_unittest.cc b/system/audio_hal_interface/aidl/a2dp/a2dp_provider_info_unittest.cc
index 5ac015c23dd90d92de9b8a2c93169b52c152e82e..2b3d433e68d6934f305516bac46b15e784ab62ef 100644
--- a/system/audio_hal_interface/aidl/a2dp/a2dp_provider_info_unittest.cc
+++ b/system/audio_hal_interface/aidl/a2dp/a2dp_provider_info_unittest.cc
@@ -559,3 +559,64 @@ TEST_F(ProviderInfoTest, TestCodecCapabilitiesFoobar) {
               (BTAV_A2DP_CODEC_BITS_PER_SAMPLE_16 | BTAV_A2DP_CODEC_BITS_PER_SAMPLE_24 |
                BTAV_A2DP_CODEC_BITS_PER_SAMPLE_32));
 }
+
+TEST(ProviderInfoExtensionTest, SourceExtensionsHaveDistinctBoundedIndexes) {
+  std::vector<CodecInfo> codecs;
+  const int capacity = BTAV_A2DP_CODEC_INDEX_SOURCE_EXT_MAX - BTAV_A2DP_CODEC_INDEX_SOURCE_EXT_MIN;
+  for (int i = 0; i < capacity + 1; ++i) {
+    CodecInfo codec;
+    codec.id = CodecId::Vendor{.id = 0x12340000 + i, .codecId = 0x2000 + i};
+    codec.name = "source_extension_" + std::to_string(i);
+    codecs.push_back(codec);
+  }
+  // A standard codec must still register after all extension slots are used.
+  CodecInfo sbc;
+  sbc.id = CodecId::A2dp::SBC;
+  codecs.push_back(sbc);
+  ProviderInfo info(codecs, {});
+  for (int i = 0; i < capacity; ++i) {
+    auto index = static_cast<btav_a2dp_codec_index_t>(BTAV_A2DP_CODEC_INDEX_SOURCE_EXT_MIN + i);
+    ASSERT_EQ(info.SourceCodecIndex(codecs[i].id), index);
+    ASSERT_TRUE(info.GetCodec(index).has_value());
+    EXPECT_EQ((*info.GetCodec(index))->id, codecs[i].id);
+  }
+  EXPECT_FALSE(info.SourceCodecIndex(codecs[capacity].id).has_value());
+  EXPECT_FALSE(info.GetCodec(BTAV_A2DP_CODEC_INDEX_SOURCE_EXT_MAX).has_value());
+  EXPECT_EQ(info.SourceCodecIndex(sbc.id), BTAV_A2DP_CODEC_INDEX_SOURCE_SBC);
+}
+
+TEST(ProviderInfoExtensionTest, SinkExtensionsHaveDistinctBoundedIndexes) {
+  std::vector<CodecInfo> codecs;
+  const int capacity = BTAV_A2DP_CODEC_INDEX_SINK_EXT_MAX - BTAV_A2DP_CODEC_INDEX_SINK_EXT_MIN;
+  for (int i = 0; i < capacity + 1; ++i) {
+    CodecInfo codec;
+    codec.id = CodecId::Vendor{.id = 0x12340000 + i, .codecId = 0x2000 + i};
+    codec.name = "sink_extension_" + std::to_string(i);
+    codecs.push_back(codec);
+  }
+  CodecInfo opus;
+  opus.id = test_opus_codec_id;
+  codecs.push_back(opus);
+  ProviderInfo info({}, codecs);
+  for (int i = 0; i < capacity; ++i) {
+    auto index = static_cast<btav_a2dp_codec_index_t>(BTAV_A2DP_CODEC_INDEX_SINK_EXT_MIN + i);
+    ASSERT_EQ(info.SinkCodecIndex(codecs[i].id), index);
+    ASSERT_TRUE(info.GetCodec(index).has_value());
+    EXPECT_EQ((*info.GetCodec(index))->id, codecs[i].id);
+  }
+  EXPECT_FALSE(info.SinkCodecIndex(codecs[capacity].id).has_value());
+  EXPECT_FALSE(info.GetCodec(BTAV_A2DP_CODEC_INDEX_SINK_EXT_MAX).has_value());
+  EXPECT_EQ(info.SinkCodecIndex(opus.id), BTAV_A2DP_CODEC_INDEX_SINK_OPUS);
+}
+
+TEST(ProviderInfoExtensionTest, UnsupportedA2dpIdDoesNotConsumeExtensionSlot) {
+  CodecInfo unsupported;
+  unsupported.id = static_cast<CodecId::A2dp>(0x7f);
+  CodecInfo extension;
+  extension.id = test_unknown_vendor_codec_id;
+  ProviderInfo info({unsupported, extension}, {unsupported, extension});
+  EXPECT_FALSE(info.SourceCodecIndex(unsupported.id).has_value());
+  EXPECT_FALSE(info.SinkCodecIndex(unsupported.id).has_value());
+  EXPECT_EQ(info.SourceCodecIndex(extension.id), BTAV_A2DP_CODEC_INDEX_SOURCE_EXT_MIN);
+  EXPECT_EQ(info.SinkCodecIndex(extension.id), BTAV_A2DP_CODEC_INDEX_SINK_EXT_MIN);
+}
