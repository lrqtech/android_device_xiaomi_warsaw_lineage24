index 05bb3bf3694785eda14028610b818a049c014566..d249d48e43550cdaea1df01eece8e649bd2e1776 100644
--- a/src/setup.c
+++ b/src/setup.c
@@ -439,6 +439,108 @@ __cold int io_uring_queue_init(unsigned entries, struct io_uring *ring,
