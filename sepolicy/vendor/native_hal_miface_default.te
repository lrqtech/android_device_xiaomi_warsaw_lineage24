allow hal_miface_default vendor_sysfs_displayfeature:file { ioctl read getattr lock map open watch watch_reads };

allow hal_miface_default property_socket:sock_file { write };

allow hal_miface_default init:unix_stream_socket { connectto };

allow hal_miface_default vendor_miface_prop:property_service { set };

