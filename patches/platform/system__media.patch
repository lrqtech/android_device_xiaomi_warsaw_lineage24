     srcs: ["include/system/camera_metadata_tags.h"],
 }
+
+// The face client receives current framework metadata. Do not replace the
+// global OEM vendor library: the camera HAL has a different private tag table.
+cc_library_shared {
+    name: "libcamera_metadata_warsaw_face",
+    vendor: true,
+    host_supported: true,
+    compile_multilib: "64",
+    srcs: ["src/camera_metadata.c"],
+    include_dirs: ["system/media/private/camera/include"],
+    local_include_dirs: ["include"],
+    export_include_dirs: ["include"],
+    header_libs: ["libcutils_headers"],
+    export_header_lib_headers: ["libcutils_headers"],
+    shared_libs: ["liblog"],
+    cflags: [
+        "-Wall", "-Werror", "-Wextra", "-fvisibility=hidden", "-std=c11",
+        "-include system/media/camera/src/warsaw_face_metadata_namespace.h",
+    ],
+    version_script: "libcamera_metadata_warsaw_face.map.txt",
+}
