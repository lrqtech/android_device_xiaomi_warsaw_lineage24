type vendor_adsprpcd, domain;

domain_auto_trans(init, vendor_adsprpcd_exec, vendor_adsprpcd)

allow vendor_adsprpcd vendor_adsprpcd_exec:file { read getattr map execute open entrypoint };

allow vendor_adsprpcd ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd vendor_dmabuf_adsp_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd vendor_qdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd vendor_xdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd system_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_adsprpcd adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_adsprpcd adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_adsprpcd vendor_adsprpc_prop:file { read getattr map open };

allow vendor_adsprpcd vendor_persist_sensors_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_adsprpcd vendor_persist_sensors_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_adsprpcd mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_adsprpcd device:dir { read watch };
