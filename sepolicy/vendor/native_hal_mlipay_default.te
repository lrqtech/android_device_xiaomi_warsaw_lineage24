type hal_mlipay_default, domain;

domain_auto_trans(init, hal_mlipay_default_exec, hal_mlipay_default)

typeattribute hal_mlipay_default hal_mlipay;

typeattribute hal_mlipay_default hal_mlipay_server;

typeattribute hal_mlipay_default halserverdomain;

binder_use(hal_mlipay_default)

allow hal_mlipay_default hal_mlipay_default_exec:file { read getattr map execute open entrypoint };

allow hal_mlipay_default servicemanager:binder { call transfer };

allow hal_mlipay_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow hal_mlipay_default firmware_file:dir { ioctl read getattr lock open watch watch_reads search };

allow hal_mlipay_default firmware_file:file { ioctl read getattr lock map open watch watch_reads };

allow hal_mlipay_default ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow hal_mlipay_default rootfs:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow hal_mlipay_default vendor_fp_prop:file { read getattr map open };

allow hal_mlipay_default vendor_system_prop:file { read getattr map open };

allow hal_mlipay_default property_socket:sock_file { write };

allow hal_mlipay_default init:unix_stream_socket { connectto };

allow hal_mlipay_default vendor_payment_security_prop:property_service { set };

allow hal_mlipay_default vendor_payment_security_prop:file { read getattr map open };

allow hal_mlipay_default vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read open };

allow hal_mlipay_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read open };
