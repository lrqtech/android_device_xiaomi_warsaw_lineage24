type warsaw_display_app, domain, coredomain;

app_domain(warsaw_display_app)

hal_client_domain(warsaw_display_app, vendor_hal_displayfeature_xiaomi)

allow warsaw_display_app surfaceflinger_service:service_manager { find };

allow warsaw_display_app activity_service:service_manager { find };

allow warsaw_display_app activity_task_service:service_manager { find };

allow warsaw_display_app alarm_service:service_manager { find };

allow warsaw_display_app appops_service:service_manager { find };

allow warsaw_display_app content_service:service_manager { find };

allow warsaw_display_app display_service:service_manager { find };

allow warsaw_display_app game_service:service_manager { find };

allow warsaw_display_app graphicsstats_service:service_manager { find };

allow warsaw_display_app input_service:service_manager { find };

allow warsaw_display_app input_method_service:service_manager { find };

allow warsaw_display_app package_service:service_manager { find };

allow warsaw_display_app permission_service:service_manager { find };

allow warsaw_display_app permission_checker_service:service_manager { find };

allow warsaw_display_app permissionmgr_service:service_manager { find };

allow warsaw_display_app platform_compat_service:service_manager { find };

allow warsaw_display_app power_service:service_manager { find };

allow warsaw_display_app settings_service:service_manager { find };

allow warsaw_display_app thermal_service:service_manager { find };

allow warsaw_display_app user_service:service_manager { find };

allow warsaw_display_app window_service:service_manager { find };

allow warsaw_display_app sysfs_thermal:dir { search getattr };

allow warsaw_display_app sysfs_thermal:file { open read getattr };

allow warsaw_display_app system_app_service:service_manager add;
