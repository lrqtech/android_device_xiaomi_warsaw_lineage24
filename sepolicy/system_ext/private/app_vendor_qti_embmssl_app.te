typeattribute vendor_qti_embmssl_app coredomain;

app_domain(vendor_qti_embmssl_app)

net_domain(vendor_qti_embmssl_app)

typeattribute vendor_qti_embmssl_app halclientdomain;

typeattribute vendor_qti_embmssl_app vendor_hal_embmssl_client;

typeattribute vendor_qti_embmssl_app vendor_hal_perf_client;

allow vendor_qti_embmssl_app appdomain_tmpfs:file { read write getattr map execute };

allow vendor_qti_embmssl_app appdomain:memfd_file { read write getattr map execute };

allow vendor_qti_embmssl_app vendor_dpmtcm_socket:sock_file { write };

allow vendor_qti_embmssl_app vendor_dpmd:unix_stream_socket { connectto };

allow vendor_qti_embmssl_app app_api_service:service_manager { find };

allow vendor_qti_embmssl_app radio_service:service_manager { find };

allow vendor_qti_embmssl_app vendor_hal_embmssl:memfd_file { read write getattr map };

allow vendor_qti_embmssl_app vendor_hal_perf:memfd_file { read write getattr map };

type_transition vendor_qti_embmssl_app tmpfs:file appdomain_tmpfs;
