+// limitations under the License.
+
+//! Retry an explicitly requested early-boot notification after transport recovery.
+
+use std::io;
+use std::sync::Mutex;
+use std::time::Duration;
+
+pub(crate) trait Notification: Clone + Send + 'static {
+    type Error;
+
+    fn send(&self) -> Result<(), Self::Error>;
+    fn retryable(error: &Self::Error) -> bool;
+    fn record(&self, result: &Result<(), Self::Error>);
+    fn spawn_failed(&self, error: &io::Error);
+
+    fn wait(&self, delay: Duration) {
+        std::thread::sleep(delay);
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Status {
+    NotRequested,
+    Pending,
+    Acknowledged,
+    Failed,
+}
+
+struct State {
+    status: Status,
+    worker_running: bool,
+}
+
+pub(crate) struct BootNotification {
+    state: Mutex<State>,
+}
+
+impl BootNotification {
+    pub(crate) const fn new() -> Self {
+        Self { state: Mutex::new(State { status: Status::NotRequested, worker_running: false }) }
+    }
+
+    pub(crate) fn status(&self) -> Status {
+        self.state.lock().unwrap().status
+    }
+
+    pub(crate) fn notify<D: Notification>(
+        &'static self,
+        driver: D,
+        thread_name: String,
+    ) -> Result<(), D::Error> {
+        self.notify_with_spawn(driver, |work| {
+            std::thread::Builder::new().name(thread_name).spawn(work).map(|_| ())
+        })
+    }
+
+    fn notify_with_spawn<D: Notification>(
+        &'static self,
+        driver: D,
+        spawn: impl FnOnce(Box<dyn FnOnce() + Send>) -> io::Result<()>,
+    ) -> Result<(), D::Error> {
+        // Serialize this security level only. The retry worker never holds this lock while
+        // waiting, and no caller waits for the hardware to recover after a failed transaction.
+        let mut state = self.state.lock().unwrap();
+        let result = driver.send();
+        driver.record(&result);
+        state.status = Self::result_status::<D>(&result);
+        if state.status == Status::Pending && !state.worker_running {
+            state.worker_running = true;
+            let retry_driver = driver.clone();
+            if let Err(error) = spawn(Box::new(move || self.retry(retry_driver))) {
+                state.worker_running = false;
+                driver.spawn_failed(&error);
+            }
+        }
+        // A scheduled retry is not an acknowledgement: preserve the initial HAL error.
+        result
+    }
+
+    fn result_status<D: Notification>(result: &Result<(), D::Error>) -> Status {
+        match result {
+            Ok(()) => Status::Acknowledged,
+            Err(error) if D::retryable(error) => Status::Pending,
+            Err(_) => Status::Failed,
+        }
+    }
+
+    fn retry<D: Notification>(&self, driver: D) {
+        let mut delay = Duration::from_secs(1);
+        loop {
+            driver.wait(delay);
+            let mut state = self.state.lock().unwrap();
+            // An explicit call may have acknowledged the event or returned a terminal error
+            // while this worker was asleep. Do not replay an obsolete pending notification.
+            if state.status != Status::Pending {
+                state.worker_running = false;
+                return;
+            }
+            let result = driver.send();
+            driver.record(&result);
+            state.status = Self::result_status::<D>(&result);
+            if state.status != Status::Pending {
+                state.worker_running = false;
+                return;
+            }
+            delay = (delay * 2).min(Duration::from_secs(30));
+        }
+    }
+}
+
