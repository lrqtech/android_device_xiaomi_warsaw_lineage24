+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use std::collections::VecDeque;
+use std::sync::Arc;
+
+#[derive(Clone)]
+struct Device(Arc<Mutex<Calls>>);
+
+#[derive(Default)]
+struct Calls {
+    replies: VecDeque<Result<(), i32>>,
+    sent: usize,
+    recorded: Vec<Result<(), i32>>,
+    delays: Vec<u64>,
+    spawn_errors: usize,
+}
+
+impl Device {
+    fn new(replies: impl IntoIterator<Item = Result<(), i32>>) -> Self {
+        Self(Arc::new(Mutex::new(Calls {
+            replies: replies.into_iter().collect(),
+            ..Calls::default()
+        })))
+    }
+}
+
+impl Notification for Device {
+    type Error = i32;
+    fn send(&self) -> Result<(), i32> {
+        let mut calls = self.0.lock().unwrap();
+        calls.sent += 1;
+        calls.replies.pop_front().expect("unexpected HAL transaction")
+    }
+    fn retryable(error: &i32) -> bool {
+        *error == -49
+    }
+    fn record(&self, result: &Result<(), i32>) {
+        self.0.lock().unwrap().recorded.push(*result);
+    }
+    fn spawn_failed(&self, _: &io::Error) {
+        self.0.lock().unwrap().spawn_errors += 1;
+    }
+    fn wait(&self, delay: Duration) {
+        self.0.lock().unwrap().delays.push(delay.as_secs());
+    }
+}
+
+type Work = Box<dyn FnOnce() + Send>;
+
+fn state() -> &'static BootNotification {
+    Box::leak(Box::new(BootNotification::new()))
+}
+
+fn notify(s: &'static BootNotification, d: &Device, workers: &mut Vec<Work>) -> Result<(), i32> {
+    s.notify_with_spawn(d.clone(), |work| {
+        workers.push(work);
+        Ok(())
+    })
+}
+
+#[test]
+fn no_notification_before_request() {
+    let s = state();
+    assert_eq!(s.status(), Status::NotRequested);
+    assert!(!s.state.lock().unwrap().worker_running);
+}
+
+#[test]
+fn immediate_acknowledgement_never_starts_worker() {
+    let (s, d, mut workers) = (state(), Device::new([Ok(())]), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Ok(()));
+    assert!(workers.is_empty());
+    assert_eq!(s.status(), Status::Acknowledged);
+}
+
+#[test]
+fn original_error_survives_scheduling_and_recovery() {
+    let (s, d, mut workers) = (state(), Device::new([Err(-49), Ok(())]), vec![]);
+    let returned = notify(s, &d, &mut workers);
+    assert_eq!(returned, Err(-49));
+    assert_eq!(s.status(), Status::Pending);
+    workers.pop().unwrap()();
+    assert_eq!(returned, Err(-49));
+    assert_eq!(s.status(), Status::Acknowledged);
+    assert_eq!(d.0.lock().unwrap().recorded, [Err(-49), Ok(())]);
+    assert!(!s.state.lock().unwrap().worker_running);
+}
+
+#[test]
+fn prolonged_transport_failure_uses_capped_backoff() {
+    let d = Device::new(std::iter::repeat_n(Err(-49), 9).chain([Ok(())]));
+    let (s, mut workers) = (state(), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    workers.pop().unwrap()();
+    assert_eq!(d.0.lock().unwrap().delays, [1, 2, 4, 8, 16, 30, 30, 30, 30]);
+    assert_eq!(s.status(), Status::Acknowledged);
+}
+
+#[test]
+fn permanent_failure_is_not_retried_or_acknowledged() {
+    for error in [-1, -1000, -68] {
+        let (s, d, mut workers) = (state(), Device::new([Err(error)]), vec![]);
+        assert_eq!(notify(s, &d, &mut workers), Err(error));
+        assert!(workers.is_empty());
+        assert_eq!(s.status(), Status::Failed);
+    }
+}
+
+#[test]
+fn terminal_retry_error_stays_visible_and_stops_worker() {
+    let (s, d, mut workers) = (state(), Device::new([Err(-49), Err(-1000)]), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    workers.pop().unwrap()();
+    assert_eq!(s.status(), Status::Failed);
+    assert_eq!(d.0.lock().unwrap().recorded, [Err(-49), Err(-1000)]);
+    assert!(!s.state.lock().unwrap().worker_running);
+}
+
+#[test]
+fn repeated_requests_share_one_retry_worker() {
+    let (s, d, mut workers) = (state(), Device::new([Err(-49), Err(-49), Ok(())]), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    assert_eq!(workers.len(), 1);
+    workers.pop().unwrap()();
+    assert_eq!(d.0.lock().unwrap().sent, 3);
+    assert_eq!(s.status(), Status::Acknowledged);
+}
+
+#[test]
+fn explicit_success_cancels_sleeping_retry() {
+    let (s, d, mut workers) = (state(), Device::new([Err(-49), Ok(())]), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    assert_eq!(notify(s, &d, &mut workers), Ok(()));
+    workers.pop().unwrap()();
+    assert_eq!(d.0.lock().unwrap().sent, 2);
+    assert_eq!(s.status(), Status::Acknowledged);
+}
+
+#[test]
+fn explicit_terminal_error_cancels_sleeping_retry() {
+    let (s, d, mut workers) = (state(), Device::new([Err(-49), Err(-1000)]), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    assert_eq!(notify(s, &d, &mut workers), Err(-1000));
+    workers.pop().unwrap()();
+    assert_eq!(d.0.lock().unwrap().sent, 2);
+    assert_eq!(s.status(), Status::Failed);
+}
+
+#[test]
+fn later_failure_does_not_reuse_cached_acknowledgement() {
+    let (s, d, mut workers) = (state(), Device::new([Ok(()), Err(-49), Ok(())]), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Ok(()));
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    workers.pop().unwrap()();
+    assert_eq!(d.0.lock().unwrap().sent, 3);
+}
+
+#[test]
+fn new_failure_while_old_worker_is_asleep_is_not_lost() {
+    let (s, d, mut workers) = (state(), Device::new([Err(-49), Ok(()), Err(-49), Ok(())]), vec![]);
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    assert_eq!(notify(s, &d, &mut workers), Ok(()));
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    assert_eq!(workers.len(), 1);
+    workers.pop().unwrap()();
+    assert_eq!(s.status(), Status::Acknowledged);
+}
+
+#[test]
+fn spawn_failure_preserves_pending_error_and_allows_another_request() {
+    let (s, d, mut workers) = (state(), Device::new([Err(-49), Err(-49), Ok(())]), vec![]);
+    assert_eq!(s.notify_with_spawn(d.clone(), |_| Err(io::Error::other("thread limit"))), Err(-49));
+    assert_eq!(s.status(), Status::Pending);
+    assert!(!s.state.lock().unwrap().worker_running);
+    assert_eq!(d.0.lock().unwrap().spawn_errors, 1);
+    assert_eq!(notify(s, &d, &mut workers), Err(-49));
+    workers.pop().unwrap()();
+    assert_eq!(s.status(), Status::Acknowledged);
+}
+
+#[test]
+fn security_levels_have_independent_workers_and_results() {
+    let (tee, sb, a, b, mut workers) = (
+        state(),
+        state(),
+        Device::new([Err(-49), Ok(())]),
+        Device::new([Err(-49), Err(-1000)]),
+        vec![],
+    );
+    assert_eq!(notify(tee, &a, &mut workers), Err(-49));
+    assert_eq!(notify(sb, &b, &mut workers), Err(-49));
+    workers.pop().unwrap()();
+    workers.pop().unwrap()();
+    assert_eq!(tee.status(), Status::Acknowledged);
+    assert_eq!(sb.status(), Status::Failed);
+}
+
+#[test]
+fn real_thread_entrypoint_can_recover() {
+    let s = state();
+    let d = Device::new([Err(-49), Ok(())]);
+    assert_eq!(s.notify(d.clone(), "early-boot-test".into()), Err(-49));
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while s.status() == Status::Pending {
+        assert!(std::time::Instant::now() < deadline, "worker did not finish");
+        std::thread::yield_now();
+    }
+    assert_eq!(s.status(), Status::Acknowledged);
+}
+
+#[test]
+fn concurrent_callers_create_one_worker() {
+    let s = state();
+    let d = Device::new(std::iter::repeat_n(Err(-49), 32).chain([Ok(())]));
+    let workers = Arc::new(Mutex::new(Vec::<Work>::new()));
+    let barrier = Arc::new(std::sync::Barrier::new(33));
+    let mut threads = Vec::new();
+    for _ in 0..32 {
+        let (d, workers, barrier) = (d.clone(), workers.clone(), barrier.clone());
+        threads.push(std::thread::spawn(move || {
+            barrier.wait();
+            s.notify_with_spawn(d, |work| {
+                workers.lock().unwrap().push(work);
+                Ok(())
+            })
+        }));
+    }
+    barrier.wait();
+    for thread in threads {
+        assert_eq!(thread.join().unwrap(), Err(-49));
+    }
+    assert_eq!(workers.lock().unwrap().len(), 1);
+    let work = workers.lock().unwrap().pop().unwrap();
+    work();
+    assert_eq!(s.status(), Status::Acknowledged);
+    assert_eq!(d.0.lock().unwrap().sent, 33);
+}
