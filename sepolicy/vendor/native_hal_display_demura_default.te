type hal_display_demura_default, domain;

domain_auto_trans(init, hal_display_demura_default_exec, hal_display_demura_default)

typeattribute hal_display_demura_default halserverdomain;

typeattribute hal_display_demura_default vendor_hal_display_demura;

typeattribute hal_display_demura_default vendor_hal_display_demura_server;

allow hal_display_demura_default hal_display_demura_default_exec:file { read getattr map execute open entrypoint };

allow hal_display_demura_default vendor_display_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow hal_display_demura_default vendor_display_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow hal_display_demura_default mnt_vendor_file:dir { search };

allow hal_display_demura_default vendor_persist_display_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };

allow hal_display_demura_default vendor_persist_display_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
