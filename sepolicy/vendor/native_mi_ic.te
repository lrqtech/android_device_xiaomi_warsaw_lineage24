type mi_ic, domain;

domain_trans(init, mi_ic_exec, mi_ic)

typeattribute mi_ic mlstrustedsubject;

allow mi_ic mi_ic_exec:file { read getattr map execute open entrypoint };

allow mi_ic sysfs:dir { ioctl read getattr lock open watch watch_reads search };

allow mi_ic sysfs_block:dir { ioctl read getattr lock open watch watch_reads search };

allow mi_ic sysfs_mem_sleep:dir { ioctl read getattr lock open watch watch_reads search };

