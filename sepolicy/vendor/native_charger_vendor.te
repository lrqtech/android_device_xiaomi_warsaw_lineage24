domain_trans(init, hal_health_default_exec, charger_vendor)

typeattribute charger_vendor bpfdomain;

typeattribute charger_vendor charger_type;

typeattribute charger_vendor hal_health;

typeattribute charger_vendor hal_health_server;

typeattribute charger_vendor halserverdomain;

allow charger_vendor hal_health_default_exec:file { read getattr map execute open entrypoint };

allow charger_vendor vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };
