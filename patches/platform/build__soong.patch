+func validateKernelObject(data []byte, arch, expectedHash, expectedVermagic string) error {
+	if expectedHash != "" && fmt.Sprintf("%x", sha256.Sum256(data)) != expectedHash {
+		return fmt.Errorf("SHA-256 does not match the pinned kernel object")
+	}
+	f, err := elf.NewFile(bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("invalid kernel ELF: %w", err)
+	}
+	defer f.Close()
+	if f.Type != elf.ET_REL {
+		return fmt.Errorf("kernel object must be ET_REL, got %s", f.Type)
+	}
+	want, ok := map[string]struct {
+		machine elf.Machine
+		class   elf.Class
+	}{
+		"arm64":   {elf.EM_AARCH64, elf.ELFCLASS64},
+		"arm":     {elf.EM_ARM, elf.ELFCLASS32},
+		"x86":     {elf.EM_386, elf.ELFCLASS32},
+		"x86_64":  {elf.EM_X86_64, elf.ELFCLASS64},
+		"riscv64": {elf.EM_RISCV, elf.ELFCLASS64},
+	}[arch]
+	if !ok || f.Machine != want.machine || f.Class != want.class || f.Data != elf.ELFDATA2LSB {
+		return fmt.Errorf("kernel object architecture %s/%s/%s does not match %q", f.Machine, f.Class, f.Data, arch)
+	}
+	syms, err := f.Symbols()
+	if err != nil || len(syms) == 0 {
+		return fmt.Errorf("kernel object requires a readable symbol table: %v", err)
+	}
+	modinfo := f.Section(".modinfo")
+	if modinfo == nil {
+		return fmt.Errorf("kernel object has no .modinfo section")
+	}
+	info, err := modinfo.Data()
+	if err != nil {
+		return fmt.Errorf("invalid .modinfo: %w", err)
+	}
+	values := map[string]string{}
+	for _, entry := range strings.Split(string(info), "\x00") {
+		key, value, found := strings.Cut(entry, "=")
+		if found && (key == "name" || key == "vermagic") {
+			if _, exists := values[key]; exists {
+				return fmt.Errorf("duplicate module %s", key)
+			}
+			values[key] = value
+		}
+	}
+	if values["name"] == "" || strings.TrimSpace(values["vermagic"]) == "" {
+		return fmt.Errorf("kernel object requires module name and vermagic")
+	}
+	if expectedVermagic != "" && strings.TrimSpace(values["vermagic"]) != expectedVermagic {
+		return fmt.Errorf("kernel vermagic %q does not match %q", values["vermagic"], expectedVermagic)
+	}
+	return nil
+}
