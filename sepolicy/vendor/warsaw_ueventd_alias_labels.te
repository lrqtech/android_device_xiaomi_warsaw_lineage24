# Repair labels only on verified, correctly targeted partition aliases.
# Existing relabelfrom rules, including platform sysfs rules, remain unchanged.
# Keep conditional zoned and illustrative APEX targets outside this grant.
allow ueventd {
    block_device
    boot_block_device
    metadata_block_device
    misc_block_device
    recovery_block_device
    rescue_block_device
    super_block_device
    userdata_block_device
    vendor_custom_ab_block_device
    vendor_logfs_block_device
    vendor_modem_block_device
    vendor_persist_block_device
    vendor_qmcs_block_device
    vendor_spunvm_block_device
    vendor_uefi_block_device
    vendor_xbl_block_device
}:lnk_file relabelto;
