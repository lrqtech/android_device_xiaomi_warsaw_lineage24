type vendor_rfs_access, domain;

domain_auto_trans(init, vendor_rfs_access_exec, vendor_rfs_access)

type_transition vendor_rfs_access mnt_vendor_file:dir vendor_persist_rfs_file;

type_transition vendor_rfs_access mnt_vendor_file:file vendor_persist_rfs_file;

type_transition vendor_rfs_access mnt_vendor_file:dir vendor_persist_rfs_shared_hlos_file "hlos_rfs";

binder_use(vendor_rfs_access)

hwbinder_use(vendor_rfs_access)

allow vendor_rfs_access vendor_rfs_access_exec:file { read getattr map execute open entrypoint };

allow vendor_rfs_access self:capability { chown setgid setuid setpcap net_bind_service };

allow vendor_rfs_access sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_rfs_access self:capability2 { block_suspend };

allow vendor_rfs_access self:cap2_userns { block_suspend };

allow vendor_rfs_access system_suspend_server:binder { call transfer };

allow vendor_rfs_access system_suspend_server:fd { use };

allow vendor_rfs_access system_suspend_hwservice:hwservice_manager { find };

allow vendor_rfs_access hwservicemanager:binder { call transfer };

allow vendor_rfs_access hwservicemanager_prop:file { read getattr map open };

allow vendor_rfs_access hidl_manager_hwservice:hwservice_manager { find };

allow vendor_rfs_access hal_system_suspend_service:service_manager { find };

allow vendor_rfs_access servicemanager:binder { call transfer };

allow vendor_rfs_access firmware_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_rfs_access firmware_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_rfs_access firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_rfs_access vendor_firmware_data_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_rfs_access vendor_firmware_data_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_rfs_access mnt_vendor_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_rfs_access vendor_persist_rfs_file:dir { search };

allow vendor_rfs_access vendor_persist_rfs_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_rfs_access vendor_persist_rfs_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_rfs_access vendor_persist_rfs_shared_hlos_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_rfs_access vendor_persist_rfs_shared_hlos_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_rfs_access self:socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_rfs_access self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_rfs_access vendor_tombstone_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_rfs_access vendor_tombstone_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_rfs_access kmsg_device:chr_file { write lock append map open };

allow vendor_rfs_access vendor_pddump_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_rfs_access vendor_pddump_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
