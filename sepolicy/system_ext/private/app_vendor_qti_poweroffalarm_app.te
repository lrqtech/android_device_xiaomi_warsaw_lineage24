typeattribute vendor_qti_poweroffalarm_app coredomain;

app_domain(vendor_qti_poweroffalarm_app)

typeattribute vendor_qti_poweroffalarm_app halclientdomain;

typeattribute vendor_qti_poweroffalarm_app vendor_hal_alarm_qti_client;

typeattribute vendor_qti_poweroffalarm_app vendor_hal_perf_client;

allow vendor_qti_poweroffalarm_app appdomain_tmpfs:file { read write getattr map execute };

allow vendor_qti_poweroffalarm_app appdomain:memfd_file { read write getattr map execute };

allow vendor_qti_poweroffalarm_app vendor_hal_alarm_qti:memfd_file { read write getattr map };

allow vendor_qti_poweroffalarm_app vendor_hal_perf:memfd_file { read write getattr map };

allow vendor_qti_poweroffalarm_app app_api_service:service_manager { find };

type_transition vendor_qti_poweroffalarm_app tmpfs:file appdomain_tmpfs;
