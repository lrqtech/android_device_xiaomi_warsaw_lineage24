type vendor_thermal-engine, domain;

domain_auto_trans(init, vendor_thermal-engine_exec, vendor_thermal-engine)

allow vendor_thermal-engine vendor_thermal-engine_exec:file { read getattr map execute open entrypoint };

allow vendor_thermal-engine sysfs:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_block:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_mem_sleep:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_powercap:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_thunderbolt:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_typec:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_udc:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_usb_pd:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_usbcore:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine self:capability { fsetid sys_admin sys_boot };

allow vendor_thermal-engine self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_thermal-engine self:qipcrtr_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_thermal-engine vendor_thermal_socket:dir { write lock open add_name remove_name search };

allow vendor_thermal-engine vendor_thermal_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_thermal-engine socket_device:dir { write lock open add_name remove_name search };

allow vendor_thermal-engine sysfs_thermal:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_thermal:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine sysfs_thermal:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine sysfs_thermal:file { write lock append map open };

allow vendor_thermal-engine sysfs_devices_system_cpu:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_thermal-engine vendor_qmuxd_socket:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_thermal-engine vendor_qmuxd_socket:sock_file { write };

allow vendor_thermal-engine vendor_qmuxd_socket:sock_file { read write create getattr setattr unlink };

allow vendor_thermal-engine uio_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_kgsl:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine vendor_sysfs_kgsl:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_kgsl:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_data:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_battery_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_graphics:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_graphics:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine sysfs_leds:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_leds:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine sysfs_leds:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine property_socket:sock_file { write };

allow vendor_thermal-engine init:unix_stream_socket { connectto };

allow vendor_thermal-engine powerctl_prop:property_service { set };

allow vendor_thermal-engine powerctl_prop:file { read getattr map open };

allow vendor_thermal-engine sysfs_uio:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine sysfs_uio:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine sysfs_uio:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_uio_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine vendor_sysfs_uio_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_uio_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine self:netlink_kobject_uevent_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

allow vendor_thermal-engine self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };

