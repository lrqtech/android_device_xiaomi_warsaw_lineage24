+TEST_F(DownloadActionTest, UnbootableFailureStopsBeforeDownloading) {
+  for (const auto target : {BootControlInterface::Slot{1},
+                            BootControlInterface::kInvalidSlot}) {
+    MockPrefs prefs;
+    MockBootControl boot_control;
+    EXPECT_CALL(boot_control, MarkSlotUnbootable(target)).WillOnce(Return(false));
+    auto* http_fetcher = new MockHttpFetcher("payload", 7);
+    http_fetcher->set_never_use(true);
+    InstallPlan install_plan;
+    install_plan.source_slot = 0;
+    install_plan.target_slot = target;
+    auto& payload = install_plan.payloads.emplace_back();
+    payload.size = 7;
+    payload.payload_urls.emplace_back("http://fake_url.invalid");
+    action_pipe->set_contents(install_plan);
+    DownloadAction action(&prefs, &boot_control, nullptr, http_fetcher, false);
+    action.set_in_pipe(action_pipe);
+    MockActionProcessor processor;
+    action.SetProcessor(&processor);
+    EXPECT_CALL(processor,
+                ActionComplete(&action,
+                               ErrorCode::kDownloadStateInitializationError));
+    action.PerformAction();
+    EXPECT_EQ(action.http_fetcher()->GetBytesDownloaded(), 0UL);
+  }
+}
