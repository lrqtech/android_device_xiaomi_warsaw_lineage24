allow vendor_thermal-engine ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_devfreq:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine vendor_sysfs_devfreq:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_devfreq:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine block_device:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine vendor_limits_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_ddr:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_scsi_host:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_thermal-engine vendor_sysfs_scsi_host:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_thermal-engine vendor_sysfs_scsi_host:lnk_file { ioctl read getattr lock map open watch watch_reads };

allowxperm vendor_thermal-engine self:socket ioctl { 0xc300-0xc305 };

allowxperm vendor_thermal-engine self:qipcrtr_socket ioctl { 0xc300-0xc305 };
