+class BootImageHeaderArgsTest(test_utils.ReleaseToolsTestCase):
+  """Rebuilt OTA headers must obey the same board overrides as Make."""
+
+  @test_utils.SkipIfExternalToolsUnavailable()
+  def test_boardVersionOverrides(self):
+    self._check_versions('--os_version 0 --os_patch_level 0', 0)
+
+  @test_utils.SkipIfExternalToolsUnavailable()
+  def test_platformVersionWithoutOverride(self):
+    self._check_versions('', (17 << 25) | (26 << 4) | 9)
+
+  def _check_versions(self, board_version, expected):
+    for partition, recovery_args in (
+        ('boot', False), ('init_boot', False),
+        ('recovery', False), ('recovery', True)):
+      with self.subTest(partition=partition, recovery_args=recovery_args):
+        source = os.path.join(common.MakeTempDir(), partition.upper())
+        os.mkdir(source)
+        if partition == 'boot':
+          with open(os.path.join(source, 'kernel'), 'wb') as kernel:
+            kernel.write(b'test kernel')
+        info = {
+            'mkbootimg_version_args':
+                '--os_version 17.0.0 --os_patch_level 2026-09-01',
+            'mkbootimg_args': '--header_version 4 ' + board_version,
+            'mkbootimg_init_args': '--header_version 4 ' + board_version,
+            'exclude_kernel_from_recovery_image': 'true',
+        }
+        if recovery_args:
+          # Recovery-specific arguments take precedence over the fallback.
+          info['mkbootimg_args'] = '--header_version 4 --os_version 1'
+          info['recovery_mkbootimg_args'] = (
+              '--header_version 4 ' + board_version)
+        data = common._BuildBootableImage(
+            partition + '.img', source, None, info_dict=info,
+            has_ramdisk=False)
+        self.assertEqual(b'ANDROID!', data[:8])
+        self.assertEqual(4, struct.unpack_from('<I', data, 40)[0])
+        self.assertEqual(expected, struct.unpack_from('<I', data, 16)[0])
+
