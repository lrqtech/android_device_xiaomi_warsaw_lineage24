typeattribute vendor_location_app coredomain;

app_domain(vendor_location_app)

net_domain(vendor_location_app)

typeattribute vendor_location_app hal_gnss_client;

typeattribute vendor_location_app halclientdomain;

typeattribute vendor_location_app vendor_hal_diaghal_client;

typeattribute vendor_location_app vendor_hal_perf_client;

binder_use(vendor_location_app)

allow vendor_location_app appdomain_tmpfs:file { read write getattr map execute };

allow vendor_location_app appdomain:memfd_file { read write getattr map execute };

allow vendor_location_app servicemanager:binder { call transfer };

allow vendor_location_app hal_gnss:memfd_file { read write getattr map };

allow vendor_location_app app_api_service:service_manager { find };

allow vendor_location_app system_app_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_location_app system_app_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_location_app radio_service:service_manager { find };

allow vendor_location_app vendor_dpmtcm_socket:sock_file { write };

allow vendor_location_app vendor_dpmd:unix_stream_socket { connectto };

allow vendor_location_app radio_cdma_ecm_prop:file { read getattr map open };

allow vendor_location_app vendor_sys_location_prop:file { read getattr map open };

allow vendor_location_app cgroup:file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_location_app vendor_seempdw_socket:sock_file { write };

type_transition vendor_location_app tmpfs:file appdomain_tmpfs;

# Read the exact vendor XTRA flag, not the general vendor system-property area.
get_prop(vendor_location_app, vendor_warsaw_xtra_config_prop)
