diff --git a/camera/tests/WarsawCameraSessionParamsTest.cpp b/camera/tests/WarsawCameraSessionParamsTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2c20e43ba4a03337b8dbbbd19777c3e2eb69605c
--- /dev/null
+++ b/camera/tests/WarsawCameraSessionParamsTest.cpp
@@ -0,0 +1,93 @@
+#include "utils/WarsawCameraSessionParams.h"
+#include <gtest/gtest.h>
+#include <cstring>
+using namespace android;
+namespace {
+constexpr uint32_t kTag = 0x81da0001;
+constexpr metadata_vendor_id_t kVendor = 17;
+int tagType = TYPE_BYTE;
+int count(const vendor_tag_ops_t*) { return 1; }
+void tags(const vendor_tag_ops_t*, uint32_t* out) { *out = kTag; }
+const char* section(const vendor_tag_ops_t*, uint32_t) { return "com.xiaomi.sessionparams"; }
+const char* name(const vendor_tag_ops_t*, uint32_t) { return "clientName"; }
+int type(const vendor_tag_ops_t*, uint32_t) { return tagType; }
+class SessionIdentityTest : public ::testing::Test {
+ protected:
+  CameraMetadata device;
+  static void SetUpTestSuite() {
+    if (base::GetProperty("ro.product.device", "") != "warsaw")
+      ASSERT_TRUE(base::SetProperty("ro.product.device", "warsaw"));
+  }
+  void SetUp() override {
+    tagType = TYPE_BYTE;
+    installDescriptor();
+    device = metadata(kVendor);
+  }
+  void TearDown() override {
+    VendorTagDescriptor::clearGlobalVendorTagDescriptor();
+    VendorTagDescriptorCache::clearGlobalVendorTagCache();
+  }
+  void installDescriptor() {
+    VendorTagDescriptor::clearGlobalVendorTagDescriptor();
+    VendorTagDescriptorCache::clearGlobalVendorTagCache();
+    vendor_tag_ops_t ops{};
+    ops.get_tag_count=count; ops.get_all_tags=tags; ops.get_section_name=section;
+    ops.get_tag_name=name; ops.get_tag_type=type;
+    sp<VendorTagDescriptor> desc;
+    ASSERT_EQ(OK, VendorTagDescriptor::createDescriptorFromOps(&ops, desc));
+    auto cache=sp<VendorTagDescriptorCache>::make();
+    ASSERT_EQ(OK,cache->addVendorDescriptor(kVendor,desc));
+    ASSERT_EQ(OK,VendorTagDescriptorCache::setAsGlobalVendorTagCache(cache));
+  }
+  static CameraMetadata metadata(metadata_vendor_id_t id) {
+    auto* raw=allocate_camera_metadata(4,128);
+    set_camera_metadata_vendor_id(raw,id);
+    return CameraMetadata(raw);
+  }
+  static void expectIdentity(CameraMetadata& params) {
+    auto e=params.find(kTag);
+    ASSERT_EQ(TYPE_BYTE,e.type);
+    ASSERT_EQ(strlen("com.android.camera")+1,e.count);
+    EXPECT_STREQ("com.android.camera",reinterpret_cast<const char*>(e.data.u8));
+  }
+};
+TEST_F(SessionIdentityTest, EmptyUnconfigureMetadataBindsProviderBeforeVendorUpdate) {
+  CameraMetadata params;
+  EXPECT_EQ(CAMERA_METADATA_INVALID_VENDOR_ID,params.getVendorId());
+  ASSERT_EQ(OK,warsawCameraSession::setClientIdentity(&params,device,"com.android.camera"));
+  EXPECT_EQ(kVendor,params.getVendorId()); expectIdentity(params);
+}
+TEST_F(SessionIdentityTest, ExistingStandardParametersArePreserved) {
+  CameraMetadata params;
+  const uint8_t intent=ANDROID_CONTROL_CAPTURE_INTENT_PREVIEW;
+  ASSERT_EQ(OK,params.update(ANDROID_CONTROL_CAPTURE_INTENT,&intent,1));
+  ASSERT_EQ(OK,warsawCameraSession::setClientIdentity(&params,device,"com.android.camera"));
+  auto e=params.find(ANDROID_CONTROL_CAPTURE_INTENT);
+  ASSERT_EQ(1u,e.count); EXPECT_EQ(intent,e.data.u8[0]); expectIdentity(params);
+}
+TEST_F(SessionIdentityTest, ApplicationSuppliedNameIsOverwrittenWithServiceIdentity) {
+  auto params=metadata(kVendor);
+  ASSERT_EQ(OK,params.update(kTag,String8("spoofed.package")));
+  ASSERT_EQ(OK,warsawCameraSession::setClientIdentity(&params,device,"com.android.camera"));
+  expectIdentity(params);
+}
+TEST_F(SessionIdentityTest, ForeignVendorMetadataIsRejectedWithoutMutation) {
+  auto params=metadata(kVendor+1);
+  EXPECT_EQ(BAD_VALUE,warsawCameraSession::setClientIdentity(&params,device,"com.android.camera"));
+  EXPECT_EQ(kVendor+1,params.getVendorId()); EXPECT_TRUE(params.isEmpty());
+}
+TEST_F(SessionIdentityTest, UnknownDeviceVendorFailsClosed) {
+  CameraMetadata params;
+  auto unknown=metadata(kVendor+1);
+  EXPECT_NE(OK,warsawCameraSession::setClientIdentity(&params,unknown,"com.android.camera"));
+  EXPECT_TRUE(params.isEmpty());
+}
+TEST_F(SessionIdentityTest, WrongVendorTagTypeFailsClosed) {
+  tagType=TYPE_INT32; installDescriptor(); CameraMetadata params;
+  EXPECT_EQ(BAD_TYPE,warsawCameraSession::setClientIdentity(&params,device,"com.android.camera"));
+  EXPECT_TRUE(params.isEmpty());
+}
+TEST_F(SessionIdentityTest, NullParametersAreRejected) {
+  EXPECT_EQ(BAD_VALUE,warsawCameraSession::setClientIdentity(nullptr,device,"com.android.camera"));
+}
+}
