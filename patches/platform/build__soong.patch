+
+// prebuilt_kernel_module preserves an individual kernel object loaded explicitly
+// by insmod. Unlike a modprobe collection, it has no generated load/dep indexes.
+// Validation is a dependency of the copied output, never an optional check.
+type prebuiltKernelModule struct {
+	android.ModuleBase
+	properties struct {
+		Src *string `android:"path"`
+		// Directory below the partition root, before lib/modules (for example vendor).
+		Relative_install_path *string
+		// Optional pins for a kernel/OTA pairing. The ELF checks always run.
+		Sha256   *string
+		Vermagic *string
+	}
+	output     android.Path
+	installDir android.InstallPath
+}
+
+func PrebuiltKernelModuleFactory() android.Module {
+	m := &prebuiltKernelModule{}
+	m.AddProperties(&m.properties)
+	android.InitAndroidArchModule(m, android.DeviceSupported, android.MultilibFirst)
+	return m
+}
+
+func (m *prebuiltKernelModule) InstallInRoot() bool { return true }
+
+func (m *prebuiltKernelModule) DepsMutator(ctx android.BottomUpMutatorContext) {
+	ctx.AddHostToolDependencies("kernel_modules_builder")
+}
+
+func (m *prebuiltKernelModule) GenerateAndroidBuildActions(ctx android.ModuleContext) {
+	if proptools.String(m.properties.Src) == "" {
+		ctx.PropertyErrorf("src", "a kernel module input is required")
+		return
+	}
+	src := android.PathForModuleSrc(ctx, *m.properties.Src)
+	if !strings.HasSuffix(src.Base(), ".ko") {
+		ctx.PropertyErrorf("src", "individual kernel modules must use the .ko suffix")
+		return
+	}
+	out := android.PathForModuleOut(ctx, src.Base())
+	builder := android.NewRuleBuilder(pctx, ctx)
+	cmd := builder.Command().BuiltTool("kernel_modules_builder").
+		FlagWithInput("--validate-module ", src).
+		FlagWithArg("--module-arch ", ctx.Arch().ArchType.String()).
+		FlagWithOutput("--out-module ", out)
+	if hash := proptools.String(m.properties.Sha256); hash != "" {
+		cmd.FlagWithArg("--module-sha256 ", hash)
+	}
+	if vermagic := proptools.String(m.properties.Vermagic); vermagic != "" {
+		cmd.FlagWithArg("--module-vermagic ", proptools.ShellEscapeIncludingSpaces(vermagic))
+	}
+	builder.Build("validate_kernel_module", "validate kernel object "+src.Base())
+	m.output = out
+	m.installDir = android.PathForModuleInstall(ctx, proptools.String(m.properties.Relative_install_path), "lib", "modules")
+	installed := ctx.InstallFile(m.installDir, src.Base(), out)
+	ctx.SetOutputFiles(android.Paths{out}, "")
+	android.SetProvider(ctx, android.PrebuiltKernelModulesComplianceMetadataProvider,
+		android.PrebuiltKernelModulesComplianceMetadata{
+			Srcs: []string{src.String()}, Dests: []string{installed.String()},
+		})
+}
+
+func (m *prebuiltKernelModule) AndroidMkEntries() []android.AndroidMkEntries {
+	return []android.AndroidMkEntries{{
+		Class: "ETC", OutputFile: android.OptionalPathForPath(m.output),
+		ExtraEntries: []android.AndroidMkExtraEntriesFunc{
+			func(ctx android.AndroidMkExtraEntriesContext, entries *android.AndroidMkEntries) {
+				entries.SetString("LOCAL_MODULE_PATH", m.installDir.String())
+				entries.SetString("LOCAL_INSTALLED_MODULE_STEM", m.output.Base())
+			},
+		},
+	}}
+}
