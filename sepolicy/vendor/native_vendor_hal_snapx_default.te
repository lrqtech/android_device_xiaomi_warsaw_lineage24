type vendor_hal_snapx_default, domain;

domain_auto_trans(init, vendor_hal_snapx_default_exec, vendor_hal_snapx_default)

typeattribute vendor_hal_snapx_default halserverdomain;

typeattribute vendor_hal_snapx_default vendor_hal_snapx_service_qti;

typeattribute vendor_hal_snapx_default vendor_hal_snapx_service_qti_server;

binder_use(vendor_hal_snapx_default)

allow vendor_hal_snapx_default vendor_hal_snapx_default_exec:file { read getattr map execute open entrypoint };

allow vendor_hal_snapx_default servicemanager:binder { call transfer };

allow vendor_hal_snapx_default servicemanager:fd { use };
