type vendor_qms_app, domain;

app_domain(vendor_qms_app)

net_domain(vendor_qms_app)

typeattribute vendor_qms_app halclientdomain;

typeattribute vendor_qms_app vendor_hal_perf_client;

typeattribute vendor_qms_app vendor_hal_qms_qti_client;

allow vendor_qms_app appdomain_tmpfs:file { read write getattr map execute };

allow vendor_qms_app app_api_service:service_manager { find };

allow vendor_qms_app radio_service:service_manager { find };

type_transition vendor_qms_app tmpfs:file appdomain_tmpfs;
