type vendor_hal_qseecom_default, domain;

domain_auto_trans(init, vendor_hal_qseecom_default_exec, vendor_hal_qseecom_default)

typeattribute vendor_hal_qseecom_default hal_allocator_client;

typeattribute vendor_hal_qseecom_default halclientdomain;

