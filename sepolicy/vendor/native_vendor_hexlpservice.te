type vendor_hexlpservice, domain;

domain_auto_trans(init, vendor_hexlpservice_exec, vendor_hexlpservice)

typeattribute vendor_hexlpservice hal_graphics_allocator_client;

typeattribute vendor_hexlpservice halclientdomain;

typeattribute vendor_hexlpservice halserverdomain;

typeattribute vendor_hexlpservice vendor_hal_capabilityconfigstore_qti_client;

typeattribute vendor_hexlpservice vendor_hal_hexlp;

typeattribute vendor_hexlpservice vendor_hal_hexlp_server;

binder_use(vendor_hexlpservice)

allow vendor_hexlpservice vendor_hexlpservice_exec:file { read getattr map execute open entrypoint };

allow vendor_hexlpservice servicemanager:binder { call transfer };

allow vendor_hexlpservice servicemanager:fd { use };

allow vendor_hexlpservice adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_hexlpservice adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice firmware_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_hexlpservice firmware_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice vendor_hexlp_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow vendor_hexlpservice vendor_hexlp_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };

allow vendor_hexlpservice vendor_persist_hexlp_file:dir { ioctl read getattr lock open watch watch_reads search };

allow vendor_hexlpservice vendor_persist_hexlp_file:file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice vendor_persist_hexlp_file:lnk_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice mnt_vendor_file:dir { search };

allow vendor_hexlpservice video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_hexlpservice vendor_xdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice gpu_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_hexlpservice vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice vendor_membuf_dev:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice vendor_vm_cp_pixel_device:chr_file { ioctl read getattr lock map open watch watch_reads };

allow vendor_hexlpservice vendor_synx_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow vendor_hexlpservice vendor_adsprpc_prop:file { read getattr map open };
