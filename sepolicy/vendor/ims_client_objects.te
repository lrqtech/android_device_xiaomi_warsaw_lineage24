hal_attribute_service(hal_telephony, vendor_hal_telephony_service2)

allow vendor_qtelephony vendor_hal_imsrtp:binder { transfer };

allow vendor_qtelephony vendor_radio_prop:file { read getattr map open };

allow vendor_qtelephony vendor_ims_prop:file { read getattr map open };

allow vendor_qtelephony vendor_audio_prop:file { read getattr map open };

allow vendor_qtelephony vendor_video_prop:file { read getattr map open };
