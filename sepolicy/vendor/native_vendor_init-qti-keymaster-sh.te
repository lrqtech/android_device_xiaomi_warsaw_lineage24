type vendor_init-qti-keymaster-sh, domain;

domain_auto_trans(init, vendor_init-qti-keymaster-sh_exec, vendor_init-qti-keymaster-sh)

allow vendor_init-qti-keymaster-sh vendor_init-qti-keymaster-sh_exec:file { read getattr map execute open entrypoint };

allow vendor_init-qti-keymaster-sh property_socket:sock_file { write };

allow vendor_init-qti-keymaster-sh init:unix_stream_socket { connectto };

allow vendor_init-qti-keymaster-sh vendor_km_strongbox_version_prop:property_service { set };

allow vendor_init-qti-keymaster-sh vendor_km_strongbox_version_prop:file { read getattr map open };

allow vendor_init-qti-keymaster-sh vendor_disable_spu_prop:property_service { set };

allow vendor_init-qti-keymaster-sh vendor_disable_spu_prop:file { read getattr map open };

allow vendor_init-qti-keymaster-sh vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };

allow vendor_init-qti-keymaster-sh vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
