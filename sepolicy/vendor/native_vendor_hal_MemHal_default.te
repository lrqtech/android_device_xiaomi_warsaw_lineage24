type vendor_hal_MemHal_default, domain;

domain_auto_trans(init, vendor_hal_MemHal_default_exec, vendor_hal_MemHal_default)

typeattribute vendor_hal_MemHal_default halclientdomain;

typeattribute vendor_hal_MemHal_default halserverdomain;

typeattribute vendor_hal_MemHal_default mlstrustedsubject;

typeattribute vendor_hal_MemHal_default vendor_hal_MemHal;

typeattribute vendor_hal_MemHal_default vendor_hal_MemHal_server;

