type hal_mimd_default, domain;

domain_auto_trans(init, hal_mimd_default_exec, hal_mimd_default)

typeattribute hal_mimd_default hal_mimd;

typeattribute hal_mimd_default hal_mimd_server;

typeattribute hal_mimd_default halserverdomain;

typeattribute hal_mimd_default mlstrustedsubject;

binder_use(hal_mimd_default)

allow hal_mimd_default hal_mimd_default_exec:file { read getattr map execute open entrypoint };

allow hal_mimd_default servicemanager:binder { call transfer };

