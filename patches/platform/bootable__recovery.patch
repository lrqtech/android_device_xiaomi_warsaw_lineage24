+#include "install/minadbd_io.h"
+
+#include <gtest/gtest.h>
+#include <sys/socket.h>
+
+#include <string>
+#include <thread>
+
+namespace {
+class MinadbdIoTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_EQ(0, socketpair(AF_UNIX, SOCK_STREAM, 0, sockets));
+  }
+  void TearDown() override {
+    for (int fd : sockets)
+      if (fd >= 0) close(fd);
+  }
+  void ClosePeer() {
+    close(sockets[1]);
+    sockets[1] = -1;
+  }
+  int sockets[2] = { -1, -1 };
+};
+
+TEST_F(MinadbdIoTest, FinalMessageFollowedByClose) {
+  constexpr char message[] = "12345678";
+  ASSERT_EQ(8, write(sockets[1], message, 8));
+  ClosePeer();
+  char buffer[8];
+  EXPECT_EQ(recovery::MinadbdReadResult::kMessage,
+            recovery::ReadMinadbdMessage(sockets[0], buffer, sizeof(buffer)));
+  EXPECT_EQ(std::string(message, 8), std::string(buffer, 8));
+  EXPECT_EQ(recovery::MinadbdReadResult::kEof,
+            recovery::ReadMinadbdMessage(sockets[0], buffer, sizeof(buffer)));
+}
+
+TEST_F(MinadbdIoTest, EmptyConnectionCloseIsNotAMessage) {
+  ClosePeer();
+  char buffer[8];
+  EXPECT_EQ(recovery::MinadbdReadResult::kEof,
+            recovery::ReadMinadbdMessage(sockets[0], buffer, sizeof(buffer)));
+}
+
+TEST_F(MinadbdIoTest, TruncatedCommandIsAnError) {
+  ASSERT_EQ(3, write(sockets[1], "123", 3));
+  ClosePeer();
+  char buffer[8];
+  EXPECT_EQ(recovery::MinadbdReadResult::kError,
+            recovery::ReadMinadbdMessage(sockets[0], buffer, sizeof(buffer)));
+  EXPECT_EQ(ENODATA, errno);
+}
+
+TEST_F(MinadbdIoTest, FragmentedCommandIsReassembled) {
+  ASSERT_EQ(3, write(sockets[1], "123", 3));
+  std::thread writer([&]() { EXPECT_EQ(5, write(sockets[1], "45678", 5)); });
+  char buffer[8];
+  EXPECT_EQ(recovery::MinadbdReadResult::kMessage,
+            recovery::ReadMinadbdMessage(sockets[0], buffer, sizeof(buffer)));
+  writer.join();
+  EXPECT_EQ("12345678", std::string(buffer, 8));
+}
+
+TEST(MinadbdIoErrors, InvalidDescriptorFails) {
+  char buffer[8];
+  EXPECT_EQ(recovery::MinadbdReadResult::kError,
+            recovery::ReadMinadbdMessage(-1, buffer, sizeof(buffer)));
+  EXPECT_EQ(EBADF, errno);
+}
+}  // namespace
