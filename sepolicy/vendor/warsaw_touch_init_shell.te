# Official OS4 domain for the retained panel-info initialization script.
type vendor_touch_init_shell, domain;
type vendor_touch_init_shell_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_touch_init_shell)
allow vendor_touch_init_shell binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_touch_init_shell cgroup:dir { add_name lock open remove_name search write };
allow vendor_touch_init_shell cgroup:file { append lock map open write };
allow vendor_touch_init_shell cgroup_v2:dir { add_name lock open remove_name search write };
allow vendor_touch_init_shell cgroup_v2:file { append lock map open write };
allow vendor_touch_init_shell heapprofd:fd { use };
allow vendor_touch_init_shell heapprofd:memfd_file { getattr map read write };
allow vendor_touch_init_shell heapprofd:unix_stream_socket { connectto };
allow vendor_touch_init_shell heapprofd_socket:sock_file { write };
allow vendor_touch_init_shell hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_touch_init_shell init:unix_stream_socket { connectto };
allow vendor_touch_init_shell kernel:system { syslog_read };
allow vendor_touch_init_shell kmsg_device:chr_file { open read };
allow vendor_touch_init_shell netutils_wrapper:process { rlimitinh siginh transition };
allow vendor_touch_init_shell netutils_wrapper_exec:file { execute getattr map open read };
allow vendor_touch_init_shell property_socket:sock_file { write };
allow vendor_touch_init_shell same_process_hal_file:file { execute getattr map open read };
allow vendor_touch_init_shell self:dir { getattr ioctl lock open read search watch watch_reads };
allow vendor_touch_init_shell self:fd { use };
allow vendor_touch_init_shell self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_touch_init_shell self:file { append getattr ioctl lock map open read watch watch_reads write };
allow vendor_touch_init_shell self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell self:lockdown { confidentiality integrity };
allow vendor_touch_init_shell self:memfd_file { create getattr map read write };
allow vendor_touch_init_shell self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow vendor_touch_init_shell self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow vendor_touch_init_shell self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow vendor_touch_init_shell servicemanager_prop:file { getattr map open read };
allow vendor_touch_init_shell shell_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_block:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_mem_sleep:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_powercap:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow vendor_touch_init_shell sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_thunderbolt:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_typec:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_udc:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_usb_pd:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell sysfs_usbcore:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell system_server:binder { call };
allow vendor_touch_init_shell toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell traced_perf:unix_stream_socket { connectto };
allow vendor_touch_init_shell traced_perf_socket:sock_file { write };
allow vendor_touch_init_shell userdebug_or_eng_prop:file { getattr map open read };
allow vendor_touch_init_shell vendor_data_touchreport_file:dir { add_name create getattr read remove_name search watch write };
allow vendor_touch_init_shell vendor_data_touchreport_file:file { append create getattr open read rename setattr unlink write };
allow vendor_touch_init_shell vendor_default_prop:file { getattr map open read };
allow vendor_touch_init_shell vendor_diag-router:unix_stream_socket { connectto };
allow vendor_touch_init_shell vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow vendor_touch_init_shell vendor_file_type:file { execute getattr map open read };
allow vendor_touch_init_shell vendor_file_type:lnk_file { getattr read };
allow vendor_touch_init_shell vendor_panel_info_prop:file { getattr map open read };
allow vendor_touch_init_shell vendor_panel_info_prop:property_service { set };
allow vendor_touch_init_shell vendor_shell_exec:file { entrypoint execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_kgsl:dir { search };
allow vendor_touch_init_shell vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_touch_init_shell_exec:file { entrypoint execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow vendor_touch_init_shell vendor_touchfeature_prop:file { getattr map open read };
allow vendor_touch_init_shell vendor_touchfeature_prop:property_service { set };
