type hal_micrtk_default, domain;

domain_auto_trans(init, hal_micrtk_default_exec, hal_micrtk_default)

typeattribute hal_micrtk_default hal_micrtk;

typeattribute hal_micrtk_default hal_micrtk_server;

typeattribute hal_micrtk_default halserverdomain;

binder_use(hal_micrtk_default)

allow hal_micrtk_default hal_micrtk_default_exec:file { read getattr map execute open entrypoint };

allow hal_micrtk_default servicemanager:binder { call transfer };

allow hal_micrtk_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow hal_micrtk_default ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };

allow hal_micrtk_default property_socket:sock_file { write };

allow hal_micrtk_default init:unix_stream_socket { connectto };

allow hal_micrtk_default vendor_payment_security_prop:property_service { set };

allow hal_micrtk_default vendor_payment_security_prop:file { read getattr map open };

allow hal_micrtk_default vendor_cpuid_prop:file { read getattr map open };

allow hal_micrtk_default vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read open };

allow hal_micrtk_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read open };

allow hal_micrtk_default hal_misecmedia_default:binder { transfer };
