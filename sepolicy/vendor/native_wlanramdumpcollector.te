type wlanramdumpcollector, domain;

domain_auto_trans(init, wlanramdumpcollector_exec, wlanramdumpcollector)

allow wlanramdumpcollector wlanramdumpcollector_exec:file { read getattr map execute open entrypoint };

allow wlanramdumpcollector property_socket:sock_file { write };

allow wlanramdumpcollector init:unix_stream_socket { connectto };

allow wlanramdumpcollector vendor_wlan_ramdump_prop:property_service { set };

allow wlanramdumpcollector vendor_wlan_ramdump_prop:file { read getattr map open };

allow wlanramdumpcollector vendor_ramdump_vendor_data_file:dir { read write getattr open watch add_name remove_name search };

allow wlanramdumpcollector vendor_ramdump_vendor_data_file:file { ioctl read write create getattr setattr unlink open };

allow wlanramdumpcollector vendor_ramdump_vendor_data_file:fifo_file { read write create getattr unlink open };

allow wlanramdumpcollector kernel:system { syslog_read };

allow wlanramdumpcollector kmsg_device:chr_file { read open };

allow wlanramdumpcollector vendor_shell_exec:file { execute_no_trans };

allow wlanramdumpcollector vendor_toolbox_exec:file { execute_no_trans };

allow wlanramdumpcollector vendor_bsp_data_log_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };

allow wlanramdumpcollector vendor_bsp_data_log_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
