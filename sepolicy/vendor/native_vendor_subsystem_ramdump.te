type vendor_subsystem_ramdump, domain;

domain_auto_trans(init, vendor_subsystem_ramdump_exec, vendor_subsystem_ramdump)

allow vendor_subsystem_ramdump vendor_subsystem_ramdump_exec:file { read getattr map execute open entrypoint };

allow vendor_subsystem_ramdump device:dir { ioctl read getattr lock open watch watch_reads search };

