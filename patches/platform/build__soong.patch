diff --git a/cc/prebuilt_cfi_test.go b/cc/prebuilt_cfi_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..64bdc7a1721ffff5668d225ea137d08ba870a8a2
--- /dev/null
+++ b/cc/prebuilt_cfi_test.go
@@ -0,0 +1,81 @@
+// Copyright (C) 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+package cc
+
+import (
+	"android/soong/android"
+	"testing"
+)
+
+func TestPreferredCfiPrebuiltReplacesSharedLibrary(t *testing.T) {
+	ctx := testPrebuilt(t, `
+        cc_library {
+            name: "libcfi_test",
+            vendor: true,
+            sanitize: { cfi: true },
+        }
+        cc_prebuilt_library_shared {
+            name: "libcfi_test",
+            srcs: ["libcfi_test.so"],
+            vendor: true,
+            sanitize: { cfi: true },
+            prefer: true,
+        }
+        cc_library_shared {
+            name: "libclient",
+            vendor: true,
+            shared_libs: ["libcfi_test"],
+        }
+    `, android.MockFS{"libcfi_test.so": nil})
+	source := ctx.ModuleForTests(t, "libcfi_test", "android_vendor_arm64_armv8-a_shared_cfi").Module().(*Module)
+	prebuilt := ctx.ModuleForTests(t, "prebuilt_libcfi_test", "android_vendor_arm64_armv8-a_shared_cfi").Module().(*Module)
+	android.AssertBoolEquals(t, "CFI source shared variant must be replaced", true, source.IsReplacedByPrebuilt())
+	android.AssertBoolEquals(t, "CFI prebuilt has paired source", true, android.GetEmbeddedPrebuilt(prebuilt).SourceExists())
+	android.AssertBoolEquals(t, "CFI prebuilt must be selected", true, android.GetEmbeddedPrebuilt(prebuilt).UsePrebuilt())
+}
+
+func TestPreferredCfiPrebuiltAcrossNamespaces(t *testing.T) {
+	ctx := testPrebuilt(t, `
+        cc_library_shared {
+            name: "libclient",
+            vendor: true,
+            shared_libs: ["//source:libcfi_test"],
+        }
+    `, android.MockFS{
+		"source/Android.bp": []byte(`
+            soong_namespace {}
+            cc_library {
+                name: "libcfi_test",
+                vendor: true,
+                sanitize: { cfi: true },
+            }
+        `),
+		"blobs/Android.bp": []byte(`
+            soong_namespace { imports: ["source", "shadow_defaults"] }
+            cc_prebuilt_library_shared {
+                name: "libcfi_test",
+                source_module_name: "libcfi_test",
+                target: { android_arm64: { srcs: ["libcfi_test.so"] } },
+                compile_multilib: "64",
+                vendor: true,
+                stl: "none",
+                sanitize: { cfi: true },
+                prefer: true,
+            }
+        `),
+		"shadow_defaults/Android.bp": []byte(`
+            soong_namespace {}
+            cc_defaults { name: "libcfi_test" }
+        `),
+		"blobs/libcfi_test.so": nil,
+	}, android.PrepareForTestWithNamespace,
+		android.FixtureModifyProductVariables(func(vars android.FixtureProductVariables) {
+			vars.NamespacesToExport = []string{"source", "blobs", "shadow_defaults"}
+		}),
+	)
+	source := ctx.ModuleForTests(t, "libcfi_test", "android_vendor_arm64_armv8-a_shared_cfi").Module().(*Module)
+	prebuilt := ctx.ModuleForTests(t, "prebuilt_libcfi_test", "android_vendor_arm64_armv8-a_shared_cfi").Module().(*Module)
+	android.AssertBoolEquals(t, "CFI source must be replaced across namespaces", true, source.IsReplacedByPrebuilt())
+	android.AssertBoolEquals(t, "CFI prebuilt has paired source", true, android.GetEmbeddedPrebuilt(prebuilt).SourceExists())
+	android.AssertBoolEquals(t, "CFI prebuilt must be selected", true, android.GetEmbeddedPrebuilt(prebuilt).UsePrebuilt())
+}
