@@ -0,0 +1,415 @@
+package com.android.server.display;
+
+import android.content.Context;
+import android.hardware.display.BrightnessInfo;
+import android.os.Build;
+import android.os.FileObserver;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.os.UserHandle;
+import android.util.Slog;
+import android.view.Display;
+import android.view.SurfaceControlHdrLayerInfoListener;
+
+import com.android.server.display.brightness.BrightnessReason;
+import com.android.server.display.config.HighBrightnessModeData;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.nio.charset.StandardCharsets;
+
+final class WarsawThermalBrightness {
+    private static final String TAG = "WarsawThermalBrightness";
+    private static final String DIRECTORY = "/sys/class/thermal/thermal_message/";
+    private static final String[] NODES = {
+        "board_sensor_temp", "sconfig", "thermal_max_brightness"
+    };
+    private final Context mContext;
+    private final Handler mDisplayHandler;
+    private final Runnable mChanged;
+    private final WarsawThermalPolicy mPolicy = new WarsawThermalPolicy();
+    private final Object mReadLock = new Object();
+    private final Object mHdrLock = new Object();
+    private final FileObserver[] mObservers = new FileObserver[NODES.length];
+    private HandlerThread mThread;
+    private Handler mReader;
+    private boolean mReadQueued;
+    private boolean mReadAgain;
+    private Snapshot mPendingSnapshot;
+    private boolean mDeliveryQueued;
+    private volatile boolean mStopped;
+    private boolean mStarted;
+    private boolean mInternal = true;
+    private int mLastState = Display.STATE_UNKNOWN;
+    private IBinder mToken;
+    private SurfaceControlHdrLayerInfoListener mHdrListener;
+    private long mTokenEpoch;
+    private HdrSnapshot mPendingHdr;
+    private HdrSnapshot mLastHdr;
+    private boolean mHdrQueued;
+    private int mWidth;
+    private int mHeight;
+    private float mMinimumHdrArea;
+    private DisplayDeviceConfig mConfig;
+    private boolean mHdr;
+    private boolean mCameraHdr;
+    private WarsawThermalDisplayListener.Subscription mDolbyListener;
+    private boolean mClampedBrightness;
+    private float mBrightnessCap = Float.NaN;
+    private String mReadError = "not sampled";
+    private long mLastReadUptime;
+
+    static WarsawThermalBrightness create(Context context, Handler handler,
+            Runnable changed, int displayId, boolean internal, IBinder token,
+            int width, int height, DisplayDeviceConfig config) {
+        if (!"warsaw".equals(Build.DEVICE) || displayId != Display.DEFAULT_DISPLAY
+                || !internal) return null;
+        return new WarsawThermalBrightness(context, handler, changed, token, width, height, config);
+    }
+
+    private WarsawThermalBrightness(Context context, Handler handler,
+            Runnable changed, IBinder token, int width, int height, DisplayDeviceConfig config) {
+        mContext = context;
+        mDisplayHandler = handler;
+        mChanged = changed;
+        mToken = token;
+        mWidth = width;
+        mHeight = height;
+        mMinimumHdrArea = minimumHdrArea(config);
+        mConfig = config;
+    }
+
+    private void start() {
+        if (mStarted || mStopped) return;
+        mStarted = true;
+        mThread = new HandlerThread(TAG);
+        mThread.start();
+        synchronized (mReadLock) { mReader = new Handler(mThread.getLooper()); }
+        for (int i = 0; i < NODES.length; i++) {
+            mObservers[i] = new FileObserver(new File(DIRECTORY + NODES[i]),
+                    FileObserver.MODIFY) {
+                @Override public void onEvent(int event, String path) {
+                    if ((event & FileObserver.MODIFY) != 0) requestRead();
+                }
+            };
+            mObservers[i].startWatching();
+        }
+        registerHdr();
+        mDolbyListener = WarsawThermalDisplayListener.subscribe(mDisplayHandler, (known, enabled) -> {
+            if (mStopped) return;
+            float previous = mPolicy.capNits();
+            mPolicy.setDolby(known, enabled);
+            if (!sameFloat(previous, mPolicy.capNits())) mChanged.run();
+        });
+        requestRead();
+    }
+
+    private void registerHdr() {
+        if (!mStarted || mStopped || !mInternal || mToken == null || mHdrListener != null) return;
+        final IBinder token = mToken;
+        final long epoch = mTokenEpoch;
+        mHdrListener = new SurfaceControlHdrLayerInfoListener() {
+            @Override public void onHdrInfoChanged(IBinder displayToken, int count,
+                    int maxW, int maxH, int flags, float ratio) {
+                synchronized (mHdrLock) {
+                    if (mStopped || epoch != mTokenEpoch || displayToken != mToken) return;
+                    mPendingHdr = new HdrSnapshot(displayToken, epoch, count, maxW, maxH, flags);
+                    if (!mHdrQueued) {
+                        mHdrQueued = true;
+                        if (!mDisplayHandler.post(mDeliverHdr)) {
+                            mHdrQueued = false;
+                            mPendingHdr = null;
+                        }
+                    }
+                }
+            }
+        };
+        try {
+            mHdrListener.register(token);
+        } catch (RuntimeException e) {
+            unregisterHdr();
+            Slog.w(TAG, "HDR registration failed; retry on display wake/change", e);
+        }
+    }
+
+    private void unregisterHdr() {
+        SurfaceControlHdrLayerInfoListener listener = mHdrListener;
+        mHdrListener = null;
+        if (listener != null) {
+            try { listener.unregisterAll(); }
+            catch (RuntimeException e) { Slog.w(TAG, "HDR listener cleanup failed", e); }
+        }
+    }
+
+    private static float minimumHdrArea(DisplayDeviceConfig config) {
+        HighBrightnessModeData data = config.getHighBrightnessModeData();
+        return data == null ? Float.NaN : data.minimumHdrPercentOfScreen;
+    }
+
+    private static final class HdrSnapshot {
+        final IBinder token;
+        final long epoch;
+        final int count, width, height, flags;
+        HdrSnapshot(IBinder token, long epoch, int count, int width, int height, int flags) {
+            this.token = token;
+            this.epoch = epoch;
+            this.count = count;
+            this.width = width;
+            this.height = height;
+            this.flags = flags;
+        }
+    }
+
+    private final Runnable mDeliverHdr = () -> {
+        synchronized (mHdrLock) {
+            HdrSnapshot next = mPendingHdr;
+            mPendingHdr = null;
+            mHdrQueued = false;
+            if (mStopped || next == null || next.epoch != mTokenEpoch || next.token != mToken) return;
+            mLastHdr = next;
+        }
+        updateHdrPolicy();
+    };
+
+    private void updateHdrPolicy() {
+        boolean present = mInternal && mLastHdr != null && mLastHdr.count > 0
+                && mLastHdr.width >= 0 && mLastHdr.height >= 0 && mWidth > 0 && mHeight > 0
+                && Float.isFinite(mMinimumHdrArea) && mMinimumHdrArea >= 0f
+                && mMinimumHdrArea <= 1f
+                && (float) ((long) mLastHdr.width * mLastHdr.height)
+                        >= (float) ((long) mWidth * mHeight) * mMinimumHdrArea;
+        boolean camera = mInternal && mLastHdr != null && (mLastHdr.flags & 0x100000) != 0;
+        if (mHdr != present || mCameraHdr != camera) {
+            mHdr = present;
+            mCameraHdr = camera;
+            mPolicy.setHdr(present, camera);
+            mChanged.run();
+        }
+    }
+
+    void updateDisplayToken(IBinder token, boolean internal, int width, int height,
+            DisplayDeviceConfig config) {
+        if (mStopped) return;
+        float threshold = minimumHdrArea(config);
+        boolean rebound = mToken != token || mInternal != internal;
+        if (!rebound && mConfig == config && mWidth == width && mHeight == height
+                && sameFloat(mMinimumHdrArea, threshold)) return;
+        if (rebound) {
+            synchronized (mHdrLock) {
+                mTokenEpoch++;
+                mToken = token;
+                mPendingHdr = null;
+                mLastHdr = null;
+            }
+            unregisterHdr();
+        }
+        mInternal = internal;
+        mWidth = width;
+        mHeight = height;
+        mMinimumHdrArea = threshold;
+        mConfig = config;
+        mBrightnessCap = Float.NaN;
+        updateHdrPolicy();
+        registerHdr();
+        if (mDolbyListener != null) mDolbyListener.refresh();
+        requestRead();
+        mChanged.run();
+    }
+
+    private void requestRead() {
+        synchronized (mReadLock) {
+            if (mStopped || mReader == null) return;
+            if (mReadQueued) { mReadAgain = true; return; }
+            mReadQueued = true;
+            if (!mReader.post(mRead)) mReadQueued = false;
+        }
+    }
+
+    private static String readNode(String node) throws IOException {
+        try (FileInputStream in = new FileInputStream(DIRECTORY + node)) {
+            byte[] bytes = new byte[128];
+            int used = 0;
+            while (used < bytes.length) {
+                int count = in.read(bytes, used, bytes.length - used);
+                if (count < 0) break;
+                if (count == 0) throw new IOException("empty sysfs read");
+                used += count;
+            }
+            if (used == 0 || used == bytes.length) throw new IOException("invalid sysfs length");
+            return new String(bytes, 0, used, StandardCharsets.US_ASCII).trim();
+        }
+    }
+
+    private static final class Snapshot {
+        Float temperature;
+        Integer condition;
+        Float safety;
+        String error = "";
+        long uptime;
+    }
+
+    private final Runnable mRead = this::readSnapshot;
+    private final Runnable mDeliver = this::deliverSnapshot;
+
+    private void readSnapshot() {
+        Snapshot next = new Snapshot();
+        for (int i = 0; i < NODES.length && !mStopped; i++) {
+            try {
+                String raw = readNode(NODES[i]);
+                if (i == 1) next.condition = Integer.valueOf(raw);
+                else {
+                    float value = Float.parseFloat(raw);
+                    if (!Float.isFinite(value) || (i == 2 && value < 0f && value != -1f)) {
+                        throw new NumberFormatException("non-finite or invalid sentinel");
+                    }
+                    if (i == 0) next.temperature = value;
+                    else next.safety = value;
+                }
+            } catch (IOException | NumberFormatException e) {
+                next.error += NODES[i] + ":" + e.getClass().getSimpleName() + " ";
+            }
+        }
+        next.uptime = SystemClock.uptimeMillis();
+        synchronized (mReadLock) {
+            if (mStopped) return;
+            if (mPendingSnapshot != null) {
+                if (next.temperature == null) next.temperature = mPendingSnapshot.temperature;
+                if (next.condition == null) next.condition = mPendingSnapshot.condition;
+                if (next.safety == null) next.safety = mPendingSnapshot.safety;
+            }
+            mPendingSnapshot = next;
+            if (!mDeliveryQueued) {
+                mDeliveryQueued = true;
+                if (!mDisplayHandler.post(mDeliver)) {
+                    mDeliveryQueued = false;
+                    mPendingSnapshot = null;
+                }
+            }
+            mReadQueued = false;
+            if (mReadAgain) {
+                mReadAgain = false;
+                mReadQueued = true;
+                if (!mReader.post(mRead)) mReadQueued = false;
+            }
+        }
+    }
+
+    private void deliverSnapshot() {
+        Snapshot next;
+        synchronized (mReadLock) {
+            next = mPendingSnapshot;
+            mPendingSnapshot = null;
+            mDeliveryQueued = false;
+        }
+        if (mStopped || next == null) return;
+        if (!next.error.equals(mReadError) && !next.error.isEmpty()) {
+            Slog.w(TAG, "Retaining previous values for failed reads: " + next.error);
+        }
+        mReadError = next.error;
+        mLastReadUptime = next.uptime;
+        float previous = mPolicy.capNits();
+        if (next.temperature != null) mPolicy.setTemperature(next.temperature);
+        if (next.condition != null) mPolicy.setCondition(next.condition);
+        if (next.safety != null) mPolicy.setSafety(next.safety);
+        if (!sameFloat(previous, mPolicy.capNits())) mChanged.run();
+    }
+
+    DisplayBrightnessState clamp(DisplayBrightnessState state, DisplayDeviceConfig config,
+            float ambientLux, int displayState) {
+        if (mStopped) return state;
+        start();
+        if (displayState != mLastState && displayState != Display.STATE_OFF) {
+            registerHdr();
+            if (mDolbyListener != null && mLastState != Display.STATE_UNKNOWN) mDolbyListener.refresh();
+            requestRead();
+        }
+        mLastState = displayState;
+        boolean automatic = Settings.System.getIntForUser(mContext.getContentResolver(),
+                Settings.System.SCREEN_BRIGHTNESS_MODE, Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL,
+                UserHandle.USER_CURRENT) == Settings.System.SCREEN_BRIGHTNESS_MODE_AUTOMATIC;
+        mPolicy.setAmbient(ambientLux, automatic);
+        mPolicy.setHdr(mHdr, mCameraHdr);
+        float capNits = mPolicy.capNits();
+        mClampedBrightness = false;
+        mBrightnessCap = Float.NaN;
+        if (!mInternal || !Float.isFinite(capNits) || capNits < 0f) return state;
+        float cap = config.getBrightnessFromBacklight(config.getBacklightFromNits(capNits));
+        if (!Float.isFinite(cap) || cap < 0f || cap > 1f) {
+            Slog.wtf(TAG, "Panel nits conversion invalid for thermal cap " + capNits);
+            return state;
+        }
+        mBrightnessCap = cap;
+        DisplayBrightnessState.Builder out = DisplayBrightnessState.Builder.from(state);
+        if (cap < state.getMaxBrightness()) {
+            out.setMaxBrightness(cap);
+            out.setMinBrightness(Math.min(state.getMinBrightness(), cap));
+            out.setBrightnessMaxReason(BrightnessInfo.BRIGHTNESS_MAX_REASON_THERMAL);
+        }
+        float brightness = limitBrightness(state.getBrightness());
+        float hdr = limitBrightness(state.getHdrBrightness());
+        if (!sameFloat(brightness, state.getBrightness()) || !sameFloat(hdr, state.getHdrBrightness())) {
+            mClampedBrightness = true;
+            BrightnessReason reason = new BrightnessReason();
+            reason.set(state.getBrightnessReason());
+            reason.addModifier(BrightnessReason.MODIFIER_THROTTLED);
+            out.setBrightnessReason(reason);
+            out.setIsSlowChange(false);
+        }
+        return out.setBrightness(brightness).setHdrBrightness(hdr).build();
+    }
+
+    float limitBrightness(float requested) {
+        if (!Float.isFinite(requested) || requested < 0f || !Float.isFinite(mBrightnessCap)) {
+            return requested;
+        }
+        return Math.min(requested, mBrightnessCap);
+    }
+
+    static boolean sameFloat(float a, float b) {
+        return a == b || (Float.isNaN(a) && Float.isNaN(b));
+    }
+
+    boolean isBrightnessLimited(float hdr, float sdr) {
+        return mClampedBrightness || !sameFloat(hdr, limitBrightness(hdr))
+                || !sameFloat(sdr, limitBrightness(sdr));
+    }
+
+    void stop() {
+        mStopped = true;
+        synchronized (mHdrLock) {
+            mTokenEpoch++;
+            mPendingHdr = null;
+            mLastHdr = null;
+            mHdrQueued = false;
+        }
+        unregisterHdr();
+        if (mDolbyListener != null) { mDolbyListener.close(); mDolbyListener = null; }
+        for (FileObserver observer : mObservers) if (observer != null) observer.stopWatching();
+        synchronized (mReadLock) {
+            mPendingSnapshot = null;
+            mDeliveryQueued = false;
+            mReadQueued = false;
+            mReadAgain = false;
+            if (mReader != null) mReader.removeCallbacksAndMessages(null);
+        }
+        mDisplayHandler.removeCallbacks(mDeliver);
+        mDisplayHandler.removeCallbacks(mDeliverHdr);
+        mBrightnessCap = Float.NaN;
+        mClampedBrightness = false;
+        if (mThread != null) mThread.quitSafely();
+    }
+
+    void dump(PrintWriter pw) {
+        pw.println("Warsaw thermal limiter: " + mPolicy);
+        pw.println("  readError=" + mReadError + " lastReadUptime=" + mLastReadUptime
+                + " brightnessCap=" + mBrightnessCap + " internal=" + mInternal);
+        pw.println("  hdr=" + mHdr + " geometry=" + mWidth + "x" + mHeight
+                + " minimumHdrArea=" + mMinimumHdrArea
+                + " sourceFlags=" + (mLastHdr == null ? "none" : mLastHdr.flags));
+    }
+}
diff --git a/services/core/java/com/android/server/display/WarsawThermalDisplayListener.java b/services/core/java/com/android/server/display/WarsawThermalDisplayListener.java
new file mode 100644
index 000000000000..5398023b0cc7
--- /dev/null
+++ b/services/core/java/com/android/server/display/WarsawThermalDisplayListener.java
@@ -0,0 +1,278 @@
+package com.android.server.display;
+
+import android.os.Binder;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Slog;
+
+import java.util.ArrayList;
+
+final class WarsawThermalDisplayListener {
+    private static final String TAG = "WarsawThermalDisplay";
+    private static final String DESCRIPTOR = "vendor.xiaomi.hardware.displayfeature_aidl.IDisplayFeature";
+    private static final String CALLBACK = DESCRIPTOR + "Callback";
+    private static final String SERVICE = DESCRIPTOR + "/default";
+    private static final int REGISTER = 2;
+    private static final int UNREGISTER = 10;
+    private static final int DOLBY_EVENT = 50000;
+    private static final int MAX_ATTEMPTS = 5;
+    private static WarsawThermalDisplayListener sInstance;
+
+    interface Listener { void onDolbyState(boolean known, boolean enabled); }
+
+    static synchronized Subscription subscribe(Handler target, Listener listener) {
+        if (sInstance == null) sInstance = new WarsawThermalDisplayListener();
+        Subscription result = sInstance.new Subscription(target, listener);
+        sInstance.mWorker.post(() -> sInstance.attach(result));
+        return result;
+    }
+
+    private static final class State {
+        static final State UNKNOWN = new State(null, false);
+        final Connection owner;
+        final boolean known, enabled;
+        State(Connection owner, boolean enabled) {
+            this.owner = owner;
+            this.known = owner != null;
+            this.enabled = enabled;
+        }
+    }
+
+    final class Subscription implements AutoCloseable {
+        private final Handler mTarget;
+        private final Listener mListener;
+        private State mPending;
+        private boolean mQueued;
+        private volatile boolean mClosed;
+        Subscription(Handler target, Listener listener) { mTarget = target; mListener = listener; }
+        private final Runnable mDeliver = this::deliverPending;
+        private void deliverPending() {
+            State next;
+            synchronized (this) { next = mPending; mPending = null; mQueued = false; }
+            if (next != null && next.known && next.owner != mConnection) next = State.UNKNOWN;
+            if (!mClosed && next != null) mListener.onDolbyState(next.known, next.enabled);
+        }
+        private synchronized void deliver(State state) {
+            if (mClosed) return;
+            mPending = state;
+            if (!mQueued) {
+                mQueued = true;
+                if (!mTarget.post(mDeliver)) { mQueued = false; mPending = null; }
+            }
+        }
+        void refresh() {
+            if (!mClosed) requestRefresh();
+        }
+        @Override public void close() {
+            synchronized (this) {
+                if (mClosed) return;
+                mClosed = true;
+                mPending = null;
+            }
+            mTarget.removeCallbacks(mDeliver);
+            mWorker.post(() -> {
+                mSubscribers.remove(this);
+                resetAttempts();
+                reconcile();
+            });
+        }
+    }
+
+    private final Handler mWorker;
+    private final ArrayList<Subscription> mSubscribers = new ArrayList<>();
+    private final Object mEventLock = new Object();
+    private Connection mPendingOwner;
+    private int mPendingValue;
+    private boolean mEventQueued;
+    private boolean mRefreshQueued;
+    private volatile Connection mConnection;
+    private State mState = State.UNKNOWN;
+    private int mAttempts;
+    private boolean mRefreshRegistration;
+
+    private WarsawThermalDisplayListener() {
+        HandlerThread thread = new HandlerThread(TAG);
+        thread.start();
+        mWorker = new Handler(thread.getLooper());
+    }
+
+    private void attach(Subscription subscriber) {
+        if (subscriber.mClosed) return;
+        mSubscribers.add(subscriber);
+        subscriber.deliver(mState);
+        resetAttempts();
+        reconcile();
+    }
+
+    private void publish(State next) {
+        if (next.known == mState.known && next.enabled == mState.enabled) return;
+        mState = next;
+        for (Subscription subscriber : mSubscribers) subscriber.deliver(next);
+    }
+
+    private void requestRefresh() {
+        synchronized (mEventLock) {
+            if (mRefreshQueued) return;
+            mRefreshQueued = true;
+            mWorker.post(() -> {
+                synchronized (mEventLock) { mRefreshQueued = false; }
+                if (mSubscribers.isEmpty()) return;
+                resetAttempts();
+                mRefreshRegistration = !mState.known;
+                reconcile();
+            });
+        }
+    }
+
+    private final Runnable mRetry = this::reconcile;
+
+    private void resetAttempts() {
+        mAttempts = 0;
+        mWorker.removeCallbacks(mRetry);
+    }
+
+    private void retry(Exception error) {
+        publish(State.UNKNOWN);
+        Slog.w(TAG, "Display event observer unavailable; state remains unknown", error);
+        if (++mAttempts < MAX_ATTEMPTS) {
+            mWorker.removeCallbacks(mRetry);
+            mWorker.postDelayed(mRetry, 1000L << (mAttempts - 1));
+        } else {
+            Slog.w(TAG, "Retry budget exhausted; retaining token until death or lifecycle refresh");
+        }
+    }
+
+    private void reconcile() {
+        Connection current = mConnection;
+        if (current != null && !current.binder.isBinderAlive()) disconnect(current);
+        current = mConnection;
+        if (current != null && (mSubscribers.isEmpty() || !current.registered
+                || mRefreshRegistration)) {
+            try {
+                if (current.mayOwnSlot) wire(current, UNREGISTER);
+                current.mayOwnSlot = false;
+                disconnect(current);
+                mRefreshRegistration = false;
+            } catch (RemoteException | RuntimeException e) {
+                retry(e);
+                return;
+            }
+        }
+        if (mSubscribers.isEmpty() || mConnection != null) return;
+        try {
+            IBinder binder = ServiceManager.checkService(SERVICE);
+            if (binder == null) throw new RemoteException("Display HAL not published");
+            if (!DESCRIPTOR.equals(binder.getInterfaceDescriptor())) {
+                throw new RemoteException("Unexpected display HAL descriptor");
+            }
+            Connection next = new Connection(binder);
+            binder.linkToDeath(next, 0);
+            mConnection = next;
+            next.mayOwnSlot = true;
+            wire(next, REGISTER);
+            next.registered = true;
+            mRefreshRegistration = false;
+            mAttempts = 0;
+        } catch (RemoteException | RuntimeException e) {
+            retry(e);
+        }
+    }
+
+    private static void wire(Connection connection, int operation) throws RemoteException {
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            data.writeInt(0);
+            data.writeStrongBinder(connection.callback);
+            if (!connection.binder.transact(operation, data, reply, 0)) {
+                throw new RemoteException("Display observer transaction rejected");
+            }
+            if (reply.dataAvail() < Integer.BYTES) throw new RemoteException("Truncated display reply");
+            reply.readException();
+            reply.enforceNoDataAvail();
+        } finally { data.recycle(); reply.recycle(); }
+    }
+
+    private void disconnect(Connection previous) {
+        if (mConnection != previous) return;
+        mConnection = null;
+        synchronized (mEventLock) { mPendingOwner = null; }
+        try { previous.binder.unlinkToDeath(previous, 0); }
+        catch (RuntimeException e) { Slog.w(TAG, "Display death cleanup failed", e); }
+        publish(State.UNKNOWN);
+    }
+
+    private final class Connection implements IBinder.DeathRecipient {
+        final IBinder binder;
+        final Callback callback = new Callback(this);
+        boolean mayOwnSlot;
+        boolean registered;
+        Connection(IBinder binder) { this.binder = binder; }
+        @Override public void binderDied() {
+            mWorker.post(() -> {
+                if (mConnection != this) return;
+                disconnect(this);
+                resetAttempts();
+                reconcile();
+            });
+        }
+    }
+
+    private final Runnable mDeliverEvent = () -> {
+        Connection owner;
+        int value;
+        synchronized (mEventLock) {
+            owner = mPendingOwner;
+            value = mPendingValue;
+            mPendingOwner = null;
+            mEventQueued = false;
+        }
+        if (owner != null && owner == mConnection && owner.registered && !mSubscribers.isEmpty()) {
+            publish(new State(owner, value == 2));
+        }
+    };
+
+    private final class Callback extends Binder implements IInterface {
+        private final Connection mOwner;
+        Callback(Connection owner) {
+            mOwner = owner;
+            markVintfStability();
+            attachInterface(this, CALLBACK);
+        }
+        @Override public IBinder asBinder() { return this; }
+        @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            if (code == INTERFACE_TRANSACTION) {
+                if (reply != null) reply.writeString(CALLBACK);
+                return true;
+            }
+            if (code != 1) return super.onTransact(code, data, reply, flags);
+            if ((flags & IBinder.FLAG_ONEWAY) == 0) return false;
+            data.enforceInterface(CALLBACK);
+            if (data.dataAvail() < 5 * Integer.BYTES) throw new IllegalArgumentException("Short display event");
+            int event = data.readInt();
+            int value = data.readInt();
+            data.readFloat();
+            data.readFloat();
+            data.readFloat();
+            data.enforceNoDataAvail();
+            if (event != DOLBY_EVENT) return true;
+            synchronized (mEventLock) {
+                if (mOwner != mConnection) return true;
+                mPendingOwner = mOwner;
+                mPendingValue = value;
+                if (!mEventQueued) {
+                    mEventQueued = true;
+                    mWorker.post(mDeliverEvent);
+                }
+            }
+            return true;
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/display/WarsawThermalPolicy.java b/services/core/java/com/android/server/display/WarsawThermalPolicy.java
new file mode 100644
index 000000000000..820ab608ca50
--- /dev/null
+++ b/services/core/java/com/android/server/display/WarsawThermalPolicy.java
@@ -0,0 +1,99 @@
+package com.android.server.display;
+
+final class WarsawThermalPolicy {
+    private float mRawTemperature = Float.NaN;
+    private float mAppliedTemperature = Float.NaN;
+    private float mLux;
+    private float mSafety = Float.NaN;
+    private int mActualCondition;
+    private boolean mHdr;
+    private boolean mCameraHdr;
+    private boolean mDolbyKnown;
+    private boolean mDolby;
+    private float mCap = Float.NaN;
+
+    static boolean sameTemperature(float a, float b) {
+        if (a == b || (Float.isNaN(a) && Float.isNaN(b))) return true;
+        if (Math.abs((int) a - (int) b) < 1) return true;
+        return Math.abs(a - b) < 0.5f;
+    }
+
+    void setTemperature(float milliCelsius) {
+        if (!Float.isFinite(milliCelsius)) return;
+        mRawTemperature = milliCelsius / 1000f;
+        if (Float.isNaN(mAppliedTemperature)
+                || !sameTemperature(mRawTemperature, mAppliedTemperature)) {
+            mAppliedTemperature = mRawTemperature;
+        }
+    }
+
+    void setCondition(int value) { mActualCondition = value; }
+    void setHdr(boolean value, boolean camera) { mHdr = value; mCameraHdr = camera; }
+
+    void setDolby(boolean known, boolean enabled) {
+        mDolbyKnown = known;
+        mDolby = known && enabled;
+    }
+
+    void setAmbient(float lux, boolean automatic) {
+        if (!automatic) mLux = 6000f;
+        else if (Float.isFinite(lux) && lux >= 0f) mLux = lux;
+    }
+
+    void setSafety(float value) {
+        if (Float.isFinite(value) && (value >= 0f || value == -1f)) {
+            mSafety = value == 0f ? Float.NaN : value;
+        }
+    }
+
+    private int appliedCondition() {
+        if (mHdr || mCameraHdr || mDolby) return WarsawThermalTables.HDR_CONDITION;
+        for (int id : WarsawThermalTables.CONDITIONS) {
+            if (id == mActualCondition) return id;
+        }
+        return 0;
+    }
+
+    static float tableCap(int condition, float lux, float temperature) {
+        float lastMax = Float.NEGATIVE_INFINITY;
+        float lastMin = Float.NaN;
+        float selectedMin = Float.NaN;
+        for (float[] row : WarsawThermalTables.ROWS) {
+            if (row[0] != condition) continue;
+            if (lux >= row[1] && lux < row[2] && Float.isNaN(selectedMin)) {
+                selectedMin = row[1];
+            }
+            if (row[2] > lastMax) { lastMax = row[2]; lastMin = row[1]; }
+        }
+        if (Float.isNaN(selectedMin) && lux >= lastMax) selectedMin = lastMin;
+        for (float[] row : WarsawThermalTables.ROWS) {
+            if (row[0] == condition && row[1] == selectedMin
+                    && temperature >= row[3] && temperature < row[4]) return row[5];
+        }
+        return Float.NaN;
+    }
+
+    float capNits() {
+        float next = tableCap(appliedCondition(), mLux, mAppliedTemperature);
+        if (!mDolbyKnown && !mHdr && !mCameraHdr) {
+            float possibleHdr = tableCap(WarsawThermalTables.HDR_CONDITION,
+                    mLux, mAppliedTemperature);
+            if (Float.isNaN(next)) next = possibleHdr;
+            else if (!Float.isNaN(possibleHdr)) next = Math.min(next, possibleHdr);
+        }
+        if (Float.isFinite(mSafety) && mSafety >= 0f) {
+            next = Float.isNaN(next) ? mSafety : Math.min(next, mSafety);
+        }
+        if (Float.isNaN(next) && Float.isNaN(mCap)) return mCap;
+        mCap = next;
+        return next;
+    }
+
+    @Override public String toString() {
+        return "rawC=" + mRawTemperature + " appliedC=" + mAppliedTemperature
+                + " actualCondition=" + mActualCondition + " appliedCondition="
+                + appliedCondition() + " lux=" + mLux + " hdr=" + mHdr + " cameraHdr=" + mCameraHdr
+                + " dolby=" + (mDolbyKnown ? Boolean.toString(mDolby) : "UNKNOWN (both tables)")
+                + " safetyNits=" + mSafety + " capNits=" + mCap;
+    }
+}
diff --git a/services/core/java/com/android/server/display/WarsawThermalTables.java b/services/core/java/com/android/server/display/WarsawThermalTables.java
new file mode 100644
index 000000000000..5e021e8138b3
--- /dev/null
+++ b/services/core/java/com/android/server/display/WarsawThermalTables.java
@@ -0,0 +1,59 @@
+package com.android.server.display;
+
+final class WarsawThermalTables {
+    static final int HDR_CONDITION = -2;
+    static final int[] CONDITIONS = {0, 20, 25, 700, 800, -2, -3};
+    static final float[][] ROWS = {
+        {0.0f, 0.0f, 5500.0f, 36.0f, 38.0f, 600.0f},
+        {0.0f, 0.0f, 5500.0f, 38.0f, 40.0f, 500.0f},
+        {0.0f, 0.0f, 5500.0f, 40.0f, 42.0f, 400.0f},
+        {0.0f, 0.0f, 5500.0f, 42.0f, 45.0f, 250.0f},
+        {0.0f, 0.0f, 5500.0f, 45.0f, 100.0f, 160.0f},
+        {0.0f, 5500.0f, 20000.0f, 36.0f, 38.0f, 1000.0f},
+        {0.0f, 5500.0f, 20000.0f, 38.0f, 40.0f, 600.0f},
