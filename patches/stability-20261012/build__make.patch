+
+  @staticmethod
+  def _ReadPrebuiltDlkmIdentity(input_file, name):
+    """Reads host build metadata from an explicitly preserved DLKM image.
+
+    Some OEM module filesystems have no build.prop. Their AVB properties
+    describe the kernel build, not the current framework build. Do not
+    rewrite the image or silently substitute the framework fingerprint.
+    """
+    image_entry = "PREBUILT_IMAGES/{}.img".format(name)
+    if not DoesInputFileContain(input_file, image_entry):
+      return ""
+    image = ExtractFromInputFile(input_file, image_entry)
+    output = RunAndCheckOutput(
+        [FindHostToolPath("avbtool"), "info_image", "--image", image])
+    partitions = re.findall(r"^\s*Partition Name:\s*(\S+)\s*$", output, re.M)
+    if partitions != [name]:
+      raise ValueError("Prebuilt DLKM AVB partition mismatch: {}".format(name))
+    prefix = "com.android.build." + name + "."
+    properties = {}
+    for key, value in re.findall(
+        r"^\s*Prop: ([A-Za-z0-9_.]+) -> '([^'\r\n]*)'\s*$", output, re.M):
+      if not key.startswith(prefix):
+        continue
+      key = key[len(prefix):]
+      if key in properties:
+        raise ValueError("Duplicate prebuilt DLKM AVB property: " + key)
+      properties[key] = value
+    fingerprint = properties.get("fingerprint", "")
+    match = re.fullmatch(
+        r"([^/ :]+)/([^/ :]+)/([^/ :]+):([^/ :]+)/([^/ :]+)/([^/ :]+):([^/ :]+)/([^/ :]+)",
+        fingerprint)
+    if not match:
+      raise ValueError("Missing or invalid prebuilt DLKM AVB fingerprint: " + name)
+    brand, product, device, release, build_id, incremental, build_type, tags = match.groups()
+    if "os_version" in properties and properties["os_version"] != release:
+      raise ValueError("Prebuilt DLKM AVB OS version disagrees with fingerprint: " + name)
+    return fingerprint
+
